# UbyHost environment: NAMES and PURPOSES ONLY. No values.
# Copy to App/.env (never commit .env). Defaults shown in comments come from App/app/config.py.
# Secret values must come from the server .env, Render dashboard, or the owner's password manager.

# --- Core ---------------------------------------------------------------
UBYHOST_DEPLOYMENT=            # local (default) | staging | production
UBYHOST_ROLE=                  # web | worker | all (default web; local dev uses all)
UBYHOST_DATA_DIR=              # default App/data; production /data
UBYHOST_DB=                    # default DATA_DIR/ubyhost.db
UBYHOST_SECRET_KEY=            # session/CSRF secret (SECRET: generated, never commit)
UBYHOST_DATA_KEYS=             # Fernet keys for encrypted columns, first encrypts (SECRET)
UBYHOST_DATA_KEY_LEGACY=       # default 1; set 0 once legacy-key data is re-encrypted
UBYHOST_PUBLIC_BASE_URL=       # public URL used in guest links (default http://127.0.0.1:8080)
UBYHOST_APP_BASE_URL=          # host app subdomain, optional
UBYHOST_WEB_WORKERS=           # uvicorn workers, 1-16, default 2
UBYHOST_ENABLE_SCHEDULER=      # default 1; 0 disables all background jobs
UBYHOST_ACCESS_LOG=            # default 1 (app-level PII-free access line)
UBYHOST_TRUSTED_PROXY_CIDRS=   # proxy CIDRs trusted for client IP
CLOUDFLARE_PROXY=              # 0 (default) | 1 when behind Cloudflare
TURNSTILE_SECRET=              # Cloudflare Turnstile server secret (SECRET)
TURNSTILE_HOSTNAMES=           # comma-separated allowed hostnames
TURNSTILE_SITE_KEY=            # Turnstile public site key (App/app/config.py:283)

# --- Staging / login -----------------------------------------------------
UBYHOST_BOOTSTRAP_ADMIN=       # default 1; create first admin at start-up
UBYHOST_ADMIN_USERNAME=        # default admin
UBYHOST_ADMIN_EMAIL=           # first administrator e-mail
UBYHOST_STAGING_LOGIN_PASSWORD=  # staging only (SECRET)
UBYHOST_STAGING_NO_LOGIN=      # staging only: every visitor is first admin (dangerous)
UBYHOST_GUEST_PIN=             # default 1: guest PIN required

# --- UbyPort (Police filing) --------------------------------------------
UBYHOST_UBYPORT_ENV=           # mock (default) | test | prod
UBYHOST_MOCK_URL=              # mock base URL (default http://127.0.0.1:8081/ws_uby/ws_uby.svc)
UBYHOST_UBYPORT_DOMAIN=        # NTLM domain (default EXRESORTMV)
UBYHOST_UBYPORT_TIMEOUT=       # seconds, default 60
UBYHOST_MAX_BATCH=             # records per submission batch, default 32
UBYHOST_SOAP_WSA_HEADER=       # 0 default; WS-Addressing header opt-in
UBYHOST_SUBMIT_SWEEP_MINUTES=  # default 10

# --- iCal -----------------------------------------------------------------
UBYHOST_ICAL_POLL_MINUTES=     # default 60
UBYHOST_ICAL_OPEN_SYNC_MINUTES=  # default 10
UBYHOST_ICAL_ALLOW_PRIVATE=    # default 0; 1 allows private-network feed URLs (SSRF risk)

# --- Heartbeats (dead-man switches; URLs are secrets) --------------------
UBYHOST_HEARTBEAT_URL=         # submit job ping
UBYHOST_HEARTBEAT_ICAL_URL=    # ical job ping
UBYHOST_HEARTBEAT_MAIL_URL=    # mail job ping
UBYHOST_HEARTBEAT_FILING_URL=  # deadlines/filing watchdog ping (/fail when at risk)
UBYHOST_BACKUP_PING_URL=       # backup script ping

# --- Mail (Amazon SES) ----------------------------------------------------
UBYHOST_MAIL_BACKEND=          # disabled (default) | console | ses
UBYHOST_MAIL_FROM=             # sender address
UBYHOST_SES_REGION=            # default eu-central-1
UBYHOST_AWS_ACCESS_KEY_ID=     # SES credentials (SECRET)
UBYHOST_AWS_SECRET_ACCESS_KEY= # SES credentials (SECRET)
UBYHOST_SIGNUP_NOTIFY_EMAIL=   # who receives sign-up notices

# --- Backups ------------------------------------------------------------
UBYHOST_BACKUP_AGE_RECIPIENT=  # age public recipient (public key; required in production)
UBYHOST_BACKUP_RETENTION_DAYS= # default 30

# --- Retention ------------------------------------------------------------
UBYHOST_RETENTION_AUTOPURGE=   # default 0 (dry-run); 1 deletes
UBYHOST_RETENTION_NOTICE_DAYS= # default 30
UBYHOST_AUDIT_RETENTION_DAYS=  # default 1095
UBYHOST_ALERT_RETENTION_DAYS=  # default 365
UBYHOST_RATE_LIMIT_RETENTION_HOURS=  # default 24

# --- Door codes (TTLock) ---------------------------------------------------
UBYHOST_DOOR_CODES=            # default 0 (off)
UBYHOST_DOOR_CODES_LIVE=       # default 0; 1 enables live codes
UBYHOST_TTLOCK_API_BASE=       # default https://euapi.ttlock.com
UBYHOST_TTLOCK_CLIENT_ID=      # TTLock client id (SECRET)
UBYHOST_TTLOCK_CLIENT_SECRET=  # TTLock client secret (SECRET)
UBYHOST_TTLOCK_MONTHLY_CALLS=  # call budget, default 30000

# --- Payments (Stripe) ----------------------------------------------------
UBYHOST_STRIPE_MODE=           # off (default) | test | live (values confirm in code)
UBYHOST_STRIPE_SECRET_KEY=     # Stripe API key (SECRET)
UBYHOST_STRIPE_WEBHOOK_SECRET= # Stripe webhook signing secret (SECRET)
UBYHOST_BILLING_ENABLED=       # default 0
UBYHOST_BILLING_IBAN=          # bank details shown on invoices
UBYHOST_BILLING_BANK_ACCOUNT=  # bank account shown on invoices

# --- AI ---------------------------------------------------------------------
UBYHOST_AI_PROVIDER=           # anthropic (default) | mistral
UBYHOST_ANTHROPIC_API_KEY=     # Anthropic key (SECRET)
UBYHOST_AI_MODEL=              # default claude-haiku-5-5
UBYHOST_MISTRAL_API_KEY=       # Mistral key, optional (SECRET)
UBYHOST_MISTRAL_MODEL=         # default mistral-small-latest
UBYHOST_AI_FEATURES=           # comma list of enabled features
UBYHOST_AI_MAX_TOKENS=         # default 4000
UBYHOST_AI_MAX_INPUT_TOKENS=   # default 60000

# --- Analytics / marketing (optional) --------------------------------------
POSTHOG_PROJECT_API_KEY=       # PostHog project key (public, but treat as config)
POSTHOG_HOST=                  # default https://eu.i.posthog.com
UBYHOST_META_DATASET_ID=       # Meta Conversions API dataset id
UBYHOST_META_ACCESS_TOKEN=     # Meta access token (SECRET)

# --- Operator identity (appears on invoices and legal pages) --------------
UBYHOST_OPERATOR_NAME=
UBYHOST_OPERATOR_ICO=
UBYHOST_OPERATOR_DIC=
UBYHOST_OPERATOR_ADDRESS=
UBYHOST_OPERATOR_EMAIL=        # default support@ubyhost.com

# --- Other optional -------------------------------------------------------
UBYHOST_APIFY_TOKEN=           # Apify token (SECRET); use case ⚠️ UNKNOWN
UBYHOST_WEB_PUSH=              # default 1
UBYHOST_LIFECYCLE_MAIL=        # default 0
UBYHOST_TERMS_VERSION=         # default 1.7
UBYHOST_PRIVACY_VERSION=       # default 1.7
UBYHOST_DPA_VERSION=           # default 1.7
