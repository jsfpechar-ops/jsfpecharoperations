# Python virtual environment
App/.venv/
.venv/

# Python bytecode / caches
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# IDE / editor files
.idea/
.vscode/
*.iml
.DS_Store

# Local/deployment secrets
.env
.env.*
!.env.example

# Screenshot output from tools/walkthrough.py
.screenshots/

# Runtime data and secrets. These belong on the server's persistent volume,
# never in source control.
App/data/*
!App/data/.gitkeep
