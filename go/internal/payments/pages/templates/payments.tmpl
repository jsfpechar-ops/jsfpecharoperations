{{/* payments.html: GET /payments. The h1 is in the body, so the frame has none. */}}
{{define "payments.title"}}{{end}}
{{define "pay.svc_actions"}}
    <form method="get" action="/payments/new" class="row-action-form">
      <input type="hidden" name="service" value="{{.ID}}">
      <button class="payments-mini" type="submit">{{t "payments.services.request_short"}}</button>
    </form>
    {{row_menu_begin}}
      <form method="post" action="/payments/services/{{.ID}}/delete" class="row-menu-form" data-confirm data-confirm-message="{{t "payments.services.remove_confirm"}}">
        <input type="hidden" name="_csrf" value="{{csrf}}">
        <button class="row-menu-item" type="submit" role="menuitem">{{t "payments.services.remove"}}</button>
      </form>
    {{row_menu_end}}
{{end}}
{{define "pay.req_actions"}}
      {{if .CanLink}}
      <form method="post" action="/payments/requests/{{.ID}}/link" class="row-action-form">
        <input type="hidden" name="_csrf" value="{{csrf}}">
        <button class="payments-mini" type="submit">{{t "payments.get_link"}}</button>
      </form>
      {{else if .CanSend}}
      <form method="post" action="/payments/requests/{{.ID}}/send" class="row-action-form">
        <input type="hidden" name="_csrf" value="{{csrf}}">
        <button class="payments-mini" type="submit">{{t "payments.send"}}</button>
      </form>
      {{end}}
      {{if .ShowMenu}}
      {{row_menu_begin}}
        {{if .MenuSend}}
        <form method="post" action="/payments/requests/{{.ID}}/send" class="row-menu-form">
          <input type="hidden" name="_csrf" value="{{csrf}}">
          <button class="row-menu-item" type="submit" role="menuitem">{{t "payments.send"}}</button>
        </form>
        {{end}}
        {{if .HasQR}}<a class="row-menu-item" href="/payments/qr/{{.ID}}" role="menuitem">{{t "payments.qr.preview"}}</a>{{end}}
      {{row_menu_end}}
      {{end}}
{{end}}
{{define "payments"}}
<div class="payments-page">
<div class="head stays-head"><div class="head-title-row"><h1 class="big">{{t "payments.title"}}</h1>
  <details class="ui-how stays-how" data-how="payments">
    <summary class="ui-how-toggle" aria-label="{{t "how.toggle"}}">{{icon "circle-help" 16}}</summary>
    <div class="ui-how-body"><ol class="ui-how-steps">{{range .HowSteps}}<li>{{t (printf "how.payments.%d" .)}}</li>{{end}}</ol></div>
  </details></div>{{if not .StripeOff}}<div class="stays-head-actions"><a class="btn" href="/payments/new">{{t "payments.overview.request"}}</a></div><a class="round stays-add ph-only" href="/payments/new" aria-label="{{t "payments.overview.request"}}">{{icon "plus" 22}}</a>{{end}}</div>
{{if and (not .StripeOff) .Complete}}
<section class="card payments-state"><span class="payments-state-ic" aria-hidden="true">{{icon "check" 22}}</span><span class="t"><b>{{t "payments.overview.on"}}</b><small>{{t "payments.overview.on_sub"}}</small></span>{{help_tip "pay-help-on" (t "payments.help.stripe_role")}}</section>
{{else}}
<section class="card payments-box" id="stripe-setup">
  <h2>{{t "payments.connect.title"}}</h2>
  {{if .StripeOff}}
  <p>{{t "payments.connect.off"}}</p>
  {{else if .Blocked}}
  <p>{{t (printf "payments.connect.%s" .State)}}</p>
  <p>{{t "payments.connect.support"}}</p>
  {{else}}
  <p>{{t (printf "payments.connect.%s" .State)}}</p>
<ul class="payments-steps" data-payments-setup>
  {{range .Steps}}
  <li class="payments-step is-{{.Status}}{{if .Cur}} is-cur{{end}}" data-payments-step="{{.Key}}">
    <span class="payments-step-n" aria-hidden="true">{{if eq .Status "done"}}{{icon "check" 18}}{{else}}{{.N}}{{end}}</span>
    <span class="t"><span><b>{{t (printf "payments.setup.step.%s" .Key)}}</b>{{if .Help}}{{help_tip (printf "pay-help-%s" .Key) (t (printf "payments.setup.%s_help" .Key))}}{{end}}</span>
    {{if and (eq .Key "details") $.Entity}}<small>{{$.Entity.Name}}{{if $.Entity.Email}} · {{$.Entity.Email}}{{end}}</small>{{ui_button (t "payments.setup.details_edit") "secondary" (kv "href" .Href "size" "compact")}}
    {{else if eq .Key "details"}}<small>{{t "payments.setup.details_missing"}}</small>
    {{else}}<small>{{t (printf "payments.setup.badge.%s" .Status)}}</small>{{end}}</span>
  </li>
  {{end}}
</ul>
  {{if eq .Next "consent"}}
  {{ui_button (t "payments.setup.continue") "primary" (kv "href" "/payments/consent")}}
  {{else if eq .Next "details"}}
  {{ui_button (t "payments.setup.details_add") "primary" (kv "href" "/entities")}}
  {{else}}
  {{/* A plain link, not a form POST (PWA submit handling); target=_blank keeps the dashboard open. */}}
  {{if eq .State "none"}}{{ui_button (t "payments.connect.open_stripe") "primary" (kv "href" "/payments/connect/start" "attrs" `target="_blank" rel="noopener"`)}}{{else}}{{ui_button (t "payments.connect.continue_stripe") "primary" (kv "href" "/payments/connect/start" "attrs" `target="_blank" rel="noopener"`)}}{{end}}
  {{end}}
  {{end}}
</section>
{{end}}
{{if and (not .StripeOff) (not .Blocked)}}
<div class="payments-cols">
<section data-payment-services>
  <h2>{{t "payments.overview.services"}}{{help_tip "pay-help-services" (t "payments.services.empty")}}</h2>
  <div class="card payments-list">
  {{range .Services}}<div class="payments-row" data-service="{{.ID}}"><span class="t"><b>{{.Name}}</b><small>{{.Amount}} {{t "payments.czk"}}</small></span>{{template "pay.svc_actions" .}}</div>{{end}}
  <details class="payments-add"{{if not .Services}} open{{end}}><summary class="payments-row"><span class="t"><b>{{t "payments.overview.add_service"}}</b><small>{{t "payments.services.add_sub"}}</small></span>{{icon "chevron-right" 20}}</summary>
<form class="payments-add-form" method="post" action="/payments/services">
  <div class="payments-add-grid">
    <div class="ui-field"><label for="pay-svc-name">{{t "payments.services.name"}}</label><input id="pay-svc-name" type="text" name="name" maxlength="60" required></div>
    <div class="ui-field"><label for="pay-svc-amount">{{t "payments.field.amount"}}</label><input id="pay-svc-amount" type="number" name="amount_czk" min="1" step="1" required></div>
  </div>
  <div class="ui-form-actions">{{ui_button (t "payments.services.add") "secondary" (kv "type" "submit")}}</div>
</form></details></div></section>
<section>
  <h2>{{t "payments.overview.requests"}}{{help_tip "pay-help-list" (t "payments.help.payout")}}</h2>
{{if .Requests}}{{range .Requests}}<div class="card stay"><span class="in"><b>{{if .Note}}{{.Note}}{{else}}{{t (printf "payments.reason.%s" .Reason)}}{{end}}</b><small>{{if .NoStay}}{{t "payments.field.no_stay"}} &middot; {{end}}{{.Created}}</small><span class="pill {{.Tone}}">{{t (printf "payments.status.%s" .Status)}}</span></span><span class="payments-amt">{{.Amount}} {{t "payments.czk"}}</span><div class="payments-acts">{{template "pay.req_actions" .}}</div></div>{{end}}{{else}}{{empty_state (t "payments.list.empty_title")}}{{end}}
</section>
</div>
{{end}}
</div>
{{end}}
