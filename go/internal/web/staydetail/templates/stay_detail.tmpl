{{define "stay_detail.title"}}{{end}}
{{define "staydetail.v2_status_pill"}}{{ $cell := deadline_cell .Progress .CheckIn }}{{ $progress := .Progress }}{{ $res := .Reservation }}
{{if eq $cell.Level "overdue"}}<span class="pill p-bad">{{deadline_badge $cell}}</span>
{{else if eq $progress.Status "failed"}}<span class="pill p-bad">{{progress_pill $progress.Status $res.AutomationMode}}</span>
{{else if ne (deref_int $progress.NotRegistered) 0}}<span class="pill p-warn"><span class="ui-badge ui-badge-action" data-tone="amber">{{tp "host.missing" (deref_int $progress.NotRegistered)}}</span></span>
{{else if eq $cell.State "filed_on_time"}}<span class="pill p-ok">{{deadline_badge $cell}}</span>
{{else if eq $cell.State "filed_late"}}<span class="pill p-warn">{{deadline_badge $cell}}</span>
{{else if and (or (eq $progress.Status "awaiting_guest") (eq $progress.Status "incomplete")) (eq $res.AutomationMode "immediate")}}<span class="pill p-warn">{{t "status.waiting_guest"}}</span>
{{else if or (eq $progress.Status "reported") (eq $progress.Status "not_required")}}<span class="pill p-ok">{{t "status.reported"}}</span>
{{else}}{{ $demo := is_demo $res.InternalName $res.Source }}
{{if and $demo (or (eq $progress.Status "ready") (eq $progress.Status "awaiting_verification"))}}<span class="pill p-n">{{progress_pill $progress.Status $res.AutomationMode (kv "is_demo" true)}}</span>
{{else if or (eq $progress.Status "ready") (eq $progress.Status "awaiting_verification") (eq $progress.Status "awaiting_guest") (eq $progress.Status "incomplete")}}<span class="pill p-warn">{{progress_pill $progress.Status $res.AutomationMode (kv "is_demo" $demo)}}</span>
{{else}}<span class="pill p-n">{{progress_pill $progress.Status $res.AutomationMode (kv "is_demo" $demo)}}</span>{{end}}{{end}}
{{end}}
{{define "staydetail.state_pill"}}{{if or (ne .Reservation.Status "active") (ne .Reservation.ArchivedAt "")}}<span class="pill">{{if ne .Reservation.Status "active"}}{{t (printf "stays.filter.state.%s" .Reservation.Status)}}{{else}}{{t "archive.col.when"}}{{end}}</span>{{else}}{{template "staydetail.v2_status_pill" .}}{{end}}{{end}}
{{define "staydetail.guest_state"}}{{if .Guest.RestrictedAt}}<span class="pill p-warn">{{t "guest.restricted_badge"}}</span> {{end}}
{{- if and (eq .Guest.SubmitState "sent") .Guest.ManualFiledAt}}<span class="pill p-ok">{{t "stay.detail.guests.filed_by_hand"}}</span> <small>{{datetime_local .Guest.ManualFiledAt}}</small>
{{- else if eq .Guest.SubmitState "sent"}}<span class="pill p-ok">{{t "stay.detail.guests.reported"}}</span>{{if .Guest.SubmittedAt}} <small>{{datetime_local .Guest.SubmittedAt}}</small>{{end}}
{{- else if eq .Guest.SubmitState "not_required"}}<span class="pill p-ok">{{t "stay.detail.guests.exempt"}}</span>
{{- else if eq .Guest.SubmitState "error"}}<span class="pill p-bad">{{t "stay.detail.guests.rejected"}}</span>
{{- else if eq .Guest.SubmitState "blocked"}}<span class="pill p-bad">{{t "stay.detail.guests.rejected_final"}}</span>
{{- else if not .Complete}}<span class="pill p-warn">{{t "stay.detail.guests.incomplete"}}</span>
{{- else}}<span class="pill">{{t "stay.detail.guests.ready"}}</span>
{{- end}}{{end}}
{{define "staydetail.guest_state_text"}}{{if .Guest.RestrictedAt}}{{t "guest.restricted_badge"}} · {{end}}
{{- if and (eq .Guest.SubmitState "sent") .Guest.ManualFiledAt}}{{t "stay.detail.guests.filed_by_hand"}}
{{- else if eq .Guest.SubmitState "sent"}}{{t "stay.detail.guests.reported"}}
{{- else if eq .Guest.SubmitState "not_required"}}{{t "stay.detail.guests.exempt"}}
{{- else if eq .Guest.SubmitState "error"}}{{t "stay.detail.guests.rejected"}}
{{- else if eq .Guest.SubmitState "blocked"}}{{t "stay.detail.guests.rejected_final"}}
{{- else if not .Complete}}{{t "stay.detail.guests.incomplete"}}
{{- else}}{{t "stay.detail.guests.ready"}}
{{- end}}{{end}}
{{define "staydetail.id_line"}}{{$born := ""}}{{if and .Guest.Row.BirthDate (identity_visible .Access .Guest.ID)}}{{$born = printf "%s %s" (t "stay.detail.guests.born") (display_birth_date .Guest.Row.BirthDate)}}{{end}}
{{- $nat := ""}}{{if .Guest.Row.Nationality}}{{$nat = or (country_name .Guest.Row.Nationality lang) .Guest.Row.Nationality}}{{end}}
{{- if or $born $nat}}<small class="guest-id-line" data-guest-id-line>{{$born}}{{if and $born $nat}} · {{end}}{{$nat}}</small>{{end}}{{end}}
{{define "stay_detail"}}{{host_alerts}}
<input class="sr-only" type="text" id="stay-link" readonly value="{{.GuestLink}}" tabindex="-1" aria-hidden="true">

<div class="host-stay-detail">
{{- $inactive := or (ne .Reservation.Status "active") (ne .Reservation.ArchivedAt "")}}
{{- $cell := deadline_cell .Progress .CheckIn}}
{{- $hasCta := or .SendControls.SendEnabled (eq .Progress.Status "failed") (and (eq .Progress.Status "reported") .Submissions)}}
{{- $title := or (leadName .GuestRows) .Reservation.InternalName}}
{{- $id := .Reservation.ID}}
{{- $fixHref := fix_href .GuestRows .Reservation.ID}}
{{- $guestTotal := len .Progress.Guests}}{{if .Progress.Expected}}{{$guestTotal = deref_int .Progress.Expected}}{{end}}
<div class="airbnb-header">
  <a class="airbnb-back" href="{{.ReturnTo}}" aria-label="{{t "common.back"}}">{{icon "arrow-left" 20}}</a>
  <h1 class="airbnb-title">{{$title}}</h1>
{{page_help "stay"}}

</div>
<div class="sub sub-phone">{{.Reservation.InternalName}} · {{source_label lang .Reservation.Source}}</div>
<div class="sub-phone stay-pill-line ph-hide">{{template "staydetail.state_pill" .}}</div>
<div class="card facts stay-dates">
  <div><small>{{t "stays.table.arrival"}}</small><b><span class="wd">{{weekday .Reservation.DateFrom}}</span> {{date_short .Reservation.DateFrom $.Now}}</b></div>
  <div><small>{{t "stays.table.departure"}}</small><b><span class="wd">{{weekday .Reservation.DateTo}}</span> {{date_short .Reservation.DateTo $.Now}}</b></div>
  <div class="tot">{{tp "stay.detail.facts.guests" $guestTotal}} · {{tp "stays.table.nights" (nights .Reservation.DateFrom .Reservation.DateTo)}}</div>
</div>
<div class="head" id="now"><div>
  <div class="crumb"><a href="{{.ReturnTo}}">{{t "stays.title"}}</a> {{icon "chevron-right" 14}} {{$title}}</div>
  
  <p class="sub">{{template "staydetail.state_pill" .}}<span class="stay-sep"><a href="/apartments/{{.Reservation.ApartmentID}}">{{.Reservation.InternalName}}</a> · {{date_cz .Reservation.DateFrom}} – {{date_cz .Reservation.DateTo}}</span></p>
</div>
<div class="stay-head-actions">
  <div class="stay-head-cta">
  {{if .SendControls.SendEnabled}}
    {{if eq .Progress.Status "failed"}}
      <a class="btn" href="{{$fixHref}}" data-fix-rejection>{{t "stay.detail.cta.fix"}}</a>
    {{else}}
      <form method="post" action="/reservations/{{$id}}/submit" class="inline">
        <input type="hidden" name="_csrf" value="{{csrf}}">
        <input type="hidden" name="return_to" value="/reservations/{{$id}}">
        <button class="btn" type="submit" title="{{t .SendControls.SendHintKey}}">{{t "stay.detail.cta.send"}}</button>
      </form>
    {{end}}
  {{else if eq .Progress.Status "failed"}}
    <a class="btn" href="{{$fixHref}}" data-fix-rejection>{{t "stay.detail.cta.fix"}}</a>
  {{else if and (eq .Progress.Status "reported") .Submissions}}
    {{if any_receipt .Submissions}}
      <a data-turbo="false" class="btn" href="/reservations/{{$id}}/dorucenka.zip">{{t "reports.detail.download_receipt"}}</a>
      <a class="btn ghost" href="#reports">{{t "stay.detail.cta.view_reports"}}</a>
    {{else}}
      <a class="btn" href="#reports">{{t "stay.detail.cta.view_reports"}}</a>
    {{end}}
  {{end}}
  {{if and .Reservation.PermalinkToken (not $inactive)}}<button class="btn ph-hide{{if $hasCta}} ghost{{end}}" type="button" data-copy="stay-link" data-copied-label="{{t "stay.detail.link_copied"}}" data-stay-header-copy>{{t "host.copy_guest_form_link"}}</button>{{end}}</div>
  {{if .ClaimResend}}<form method="post" action="/reservations/{{$id}}/resend-claim" class="inline ph-hide"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="btn ghost" type="submit" data-resend-claim title="{{t "stay.claim.resend_help"}}">{{t "stay.claim.resend"}}</button></form>{{end}}
      {{row_menu_begin}}
        {{if and .Reservation.PermalinkToken (not $inactive)}}<button class="row-menu-item ph-only" type="button" role="menuitem" data-copy="stay-link" data-copied-label="{{t "stay.detail.link_copied"}}">{{t "host.copy_guest_form_link"}}</button>{{end}}
        {{if .ClaimResend}}<form method="post" action="/reservations/{{$id}}/resend-claim" class="row-menu-form ph-only"><input type="hidden" name="_csrf" value="{{csrf}}"><button class="row-menu-item" type="submit" role="menuitem">{{t "stay.claim.resend"}}</button></form>{{end}}
        {{if and (not $inactive) (not $.PaymentsHidden)}}<a class="row-menu-item ph-only" href="/payments?reservation_id={{$id}}#new-request" role="menuitem">{{t "stays.row.request_payment"}}</a>{{end}}
        <a class="row-menu-item" href="/reservations/{{$id}}/guests/new" role="menuitem">{{t "stay.detail.cta.add_guest"}}</a>
        {{if .StayInvoice}}<a class="row-menu-item" href="/invoices/{{.StayInvoice.ID}}" role="menuitem">{{t "invoice.stay.open" "number" .StayInvoice.Number}}</a>{{else}}<a class="row-menu-item" href="/invoices/new?reservation_id={{$id}}" role="menuitem">{{t "invoice.new"}}</a>{{end}}
        {{if .Reservation.PermalinkToken}}
        <a class="row-menu-item" href="{{.GuestLink}}" target="_blank" rel="noopener" role="menuitem">{{t "stay.detail.menu.open_guest_form"}}</a>
        {{end}}
        {{if .Reservation.ArchivedAt}}
          <form method="post" action="/reservations/{{$id}}/unarchive" class="row-menu-form">
            <input type="hidden" name="_csrf" value="{{csrf}}">
            <button class="row-menu-item" type="submit" role="menuitem">{{t "stay.detail.menu.restore"}}</button>
          </form>
        {{else}}
          <form method="post" action="/reservations/{{$id}}/archive" class="row-menu-form"
                data-confirm data-confirm-message="{{t "host.delete_to_archived.confirm"}}">
            <input type="hidden" name="_csrf" value="{{csrf}}">
            <input type="hidden" name="return_to" value="/reservations/{{$id}}?return_to={{urlencode .ReturnTo}}">
            <button class="row-menu-item" type="submit" role="menuitem">{{t "host.delete"}}</button>
          </form>
        {{end}}
        <a class="row-menu-item" href="/apartments/{{.Reservation.ApartmentID}}?view=settings&amp;section=guests#communication" role="menuitem">{{t "stay.detail.menu.guest_links"}}</a>
        {{if and .SendControls.SendEnabled (eq .Progress.Status "failed")}}
          <form method="post" action="/reservations/{{$id}}/submit" class="row-menu-form">
            <input type="hidden" name="_csrf" value="{{csrf}}">
            <input type="hidden" name="return_to" value="/reservations/{{$id}}">
            <button class="row-menu-item" type="submit" role="menuitem">{{t "stay.detail.cta.send_again"}}</button>
          </form>
        {{end}}
        {{if .StayClaim.GuestAccessLockedAt}}
          <form method="post" action="/reservations/{{$id}}/reopen-guest" class="row-menu-form">
            <input type="hidden" name="_csrf" value="{{csrf}}">
            <button class="row-menu-item" type="submit" role="menuitem">{{t "stay.claim.reopen"}}</button>
          </form>
        {{end}}
      {{row_menu_end}}
</div></div>
{{if eq .Reservation.Status "cancelled"}}
<div class="ui-banner ui-banner-attention">
  <div class="grow">{{t "stay.detail.banner.cancelled"}}</div>
</div>
{{else if eq .Reservation.Status "ignored"}}
<div class="ui-banner ui-banner-neutral">
  <div class="grow">{{t "stay.detail.banner.ignored"}}</div>
</div>
{{end}}
{{if .Reservation.ArchivedAt}}
<div class="ui-banner ui-banner-attention">
  <div class="grow">{{t "stay.detail.banner.archived"}}</div>
</div>
{{end}}
{{if .IsDemoStay}}<div class="ui-banner ui-banner-neutral stay-demo-banner" id="demo-stay">
  <div class="grow">{{t "stay.detail.banner.demo"}}</div>
  <form method="post" action="/reservations/{{$id}}/delete-demo" class="inline"
        data-confirm data-confirm-message="{{t "confirm.delete_demo_stay"}}">
    <input type="hidden" name="_csrf" value="{{csrf}}">
    <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit">{{t "setup_guide.try.delete"}}</button>
  </form>
</div>
{{end}}

<section class="stay-guests" id="guests">
<div class="stay-guests-h"><h2 class="sec">{{t "stay.detail.guests.title"}}<span class="sub ph-hide">{{if .Progress.Expected}}{{.Progress.Filled}} / {{deref_int .Progress.Expected}}{{else if .Progress.Guests}}{{len .Progress.Guests}}{{else}}–{{end}}</span></h2>
  <div class="stay-guests-actions ph-hide"><a class="btn ghost" href="#stay-quick-edit" data-open-details>{{t "host.edit_count"}}</a><a class="btn ghost" href="/reservations/{{$id}}/guests/new">+ {{t "stay.detail.cta.add_guest"}}</a></div>
</div>
{{with .LinkWindow}}<p class="sub link-window-line ph-hide" data-link-window="{{.State}}"><span class="link-window{{if eq .State "from"}} is-later{{end}}">{{if eq .State "now"}}{{t "workflow.link.now"}}{{else}}{{t "workflow.link.from" "date" (date_cz .Opens)}}{{end}}</span>{{if eq .State "from"}}{{help_tip "link-window-help" (t "workflow.link.why")}} <button class="btn ghost" type="button" data-copy="stay-link" data-copy-label="{{t "workflow.link.copy_own"}}" data-copied-label="{{t "stay.detail.link_copied"}}" data-copy-own-link>{{t "workflow.link.copy_own"}}</button>{{end}}</p>{{end}}

{{if and .StayClaim.State (or (ne .StayClaim.State "unclaimed") .StayClaim.GuestAccessLockedAt)}}
<div class="card stay-claim-line ph-hide" data-stay-claim>
  <div class="stay-claim-label">{{t "stay.claim.title"}}{{if ne .StayClaim.State "unclaimed"}}{{help_tip "release-claim-help" (t "stay.claim.release_help")}}{{end}}</div>
  <p>
    {{if .StayClaim.GuestAccessLockedAt}}
      {{t "stay.claim.locked"}}
    {{else if eq .StayClaim.State "claimed"}}
      {{t "stay.claim.claimed" "email" .StayClaim.EmailMasked}}
    {{else if eq .StayClaim.State "provisional"}}
      {{t "stay.claim.provisional" "email" .StayClaim.EmailMasked}}
    {{else}}
      {{t "stay.claim.unclaimed"}}
    {{end}}
  </p>
  {{if ne .StayClaim.State "unclaimed"}}
  <div class="stay-command-actions">
    <form method="post" action="/reservations/{{$id}}/release-claim" class="inline"
          data-confirm data-confirm-message="{{t "stay.claim.release_confirm"}}">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <button class="btn ghost" type="submit" data-release-claim>{{t "stay.claim.release"}}</button>
    </form>
  </div>
  {{end}}
</div>
{{end}}
{{if or .GuestRows (ne (deref_int .Progress.NotRegistered) 0)}}
<div class="card guest-table">
<table>
  <thead><tr><th>{{t "stays.table.guest"}}</th><th>{{t "stay.detail.guests.document"}}</th><th>{{t "stays.table.reporting"}}</th><th></th></tr></thead>
  <tbody>
  {{range .GuestRows}}
    <tr>
      <td>
        <b><a class="guest-name-link" href="/guests/{{.Guest.ID}}?return_to=/reservations/{{$id}}">{{.Guest.Row.FirstName}} {{or .Guest.Row.Surname "—"}}</a></b>{{if .Guest.IsLead}} <span class="pill">{{t "stay.detail.guests.lead"}}</span>{{end}}
        {{template "staydetail.id_line" (guest_line . $.Access)}}
        {{if .Guest.Row.Note}}<small>{{t "stay.detail.guests.note" "text" .Guest.Row.Note}}</small>{{end}}
        {{if .Guest.EnteredBy}}<small>{{t "stay.detail.guests.entered_by"}}: <span>{{entered_by_label lang .Guest.EnteredBy}}</span></small>{{end}}
        {{range .Issues}}
          <small class="{{if eq .Severity "error"}}err-text{{else}}warn-text{{end}}">{{validation_message .Message lang}}</small>
        {{end}}
        {{if .Guest.LastErrors}}
          <small class="err-text">{{if eq .Guest.SubmitState "blocked"}}{{t "stay.detail.guest_blocked" "reason" .Guest.LastErrors}}{{else if eq .Guest.SubmitState "error"}}{{t "stay.detail.guest_refused" "reason" .Guest.LastErrors}}{{else}}{{.Guest.LastErrors}}{{end}}</small>
        {{end}}
      </td>
      <td class="guest-doc">{{if .Guest.DocType}}{{t (printf "guest.doc_type.%s" .Guest.DocType)}}{{else}}—{{end}}</td>
      <td>{{template "staydetail.guest_state" .}}</td>
      <td>
        {{row_menu_begin}}
          <a class="row-menu-item" href="/guests/{{.Guest.ID}}?return_to=/reservations/{{$id}}" role="menuitem">{{t "stay.detail.guests.edit"}}</a>
          <a data-turbo="false" class="row-menu-item" href="/guests/{{.Guest.ID}}/form.pdf" role="menuitem">{{t "stay.detail.guests.pdf"}}</a>
          <form method="post" action="/guests/{{.Guest.ID}}/archive" class="row-menu-form"
                data-confirm data-confirm-message="{{t "host.delete_to_archived.confirm"}}">
            <input type="hidden" name="return_to" value="/reservations/{{$id}}">
            <button class="row-menu-item" type="submit" role="menuitem">{{t "host.delete"}}</button>
          </form>
        {{row_menu_end}}
      </td>
    </tr>
  {{end}}
  {{range seq_range (add (len .Progress.Guests) 1) (add (deref_int .Progress.Expected) 1)}}
    <tr class="placeholder">
      <td><b>{{t "stay.detail.guests.placeholder" "n" .}}</b></td>
      <td>—</td>
      <td></td>
      <td><a href="/reservations/{{$id}}/guests/new">{{t "stay.detail.guests.add_by_hand"}}</a></td>
    </tr>
  {{end}}
  </tbody>
</table>
</div>
<div class="list guests guest-list">
  {{range .GuestRows}}
    {{- $ok := or (eq .Guest.SubmitState "sent") (eq .Guest.SubmitState "not_required") (and .Complete (ne .Guest.SubmitState "error") (ne .Guest.SubmitState "blocked"))}}
    <a class="row" href="/guests/{{.Guest.ID}}?return_to=/reservations/{{$id}}">
      <div class="ic {{if $ok}}ok{{else}}warn{{end}}">{{if $ok}}{{icon "check" 22}}{{else}}?{{end}}</div>
      <div class="t"><b>{{.Guest.Row.FirstName}} {{or .Guest.Row.Surname "—"}}</b>{{template "staydetail.id_line" (guest_line . $.Access)}}<small>{{if .Guest.DocType}}{{t (printf "guest.doc_type.%s" .Guest.DocType)}} · {{end}}{{template "staydetail.guest_state_text" .}}</small></div>
    </a>
  {{end}}
  {{range seq_range (add (len .Progress.Guests) 1) (add (deref_int .Progress.Expected) 1)}}
    <a class="row" href="/reservations/{{$id}}/guests/new">
      <div class="ic warn">?</div>
      <div class="t"><b>{{t "stay.detail.guests.placeholder" "n" .}}</b><small>{{t "stay.detail.guests.add_by_hand"}}</small></div>
    </a>
  {{end}}
</div>
{{else}}
<div class="card">
  <p>{{t "stay.detail.guests.empty"}}</p>
  <p class="sub">{{t "stay.detail.guests.empty_hint"}}</p>
  <a class="btn" href="/reservations/{{$id}}/guests/new">{{t "stay.detail.cta.add_guest"}}</a>
</div>
{{end}}
</section>

<section class="stay-reports" id="reports">
  <h2 class="sec">{{t "host.reporting"}}</h2>
  <div id="police-card" class="card police-card{{if eq .Progress.Status "failed"}} police-failed{{end}}">
    <b>{{if eq .Progress.Status "failed"}}{{t "hint.failed"}}{{else if .SendControls.SendEnabled}}{{tp "stay.detail.ready_count" .SendControls.PendingCount}}{{else if ne (deref_int .Progress.NotRegistered) 0}}{{tp "host.missing" (deref_int .Progress.NotRegistered)}}{{else}}{{t .SendControls.SendHintKey "filled" .Progress.Filled "expected" (py_int .Progress.Expected)}}{{end}}</b>
    {{if and (eq .Progress.Status "failed") $.HavelOn}}<p class="havel-ask-line"><a class="havel-ask-link" href="/havel?topic=reporting" data-sheet-open="havel-sheet" data-havel-launcher data-havel-topic="reporting">{{t "nav.ask_havel"}}</a></p>{{end}}
    {{if and (not $inactive) (ne $cell.State "none")}}
    <span class="police-deadline-row"><small class="police-deadline">{{t "stay.detail.metric.deadline"}} {{deadline_badge $cell}}</small>{{if .Deadline}}{{help_tip "police-deadline-help" (t "stay.detail.metric.deadline_note" "when" (format_time_iso .Deadline "02.01.2006 15:04"))}}{{end}}</span>
    {{end}}
  </div>
  {{if .HandFiling.Count}}
  <div class="card stay-filing ph-hide" id="filed-by-hand">
    <p><strong>{{t "stay.hand_filing.done" "when" (format_time_iso .HandFiling.FiledAt "02.01.2006 15:04")}}</strong></p>
    {{if .HandFiling.Reference}}<p class="ui-sub">{{t "stay.hand_filing.done_reference" "reference" .HandFiling.Reference}}</p>{{end}}
    {{if .HandFiling.CanUndo}}
    <form method="post" action="/reservations/{{$id}}/filed-by-hand/undo" class="inline"
          data-confirm data-confirm-message="{{t "stay.hand_filing.undo_confirm"}}">
      <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit">{{t "stay.hand_filing.undo"}}</button>
      <span class="ui-sub">{{t "stay.hand_filing.undo_until" "when" (format_time_iso .HandFiling.UndoUntil "02.01. 15:04")}}</span>
    </form>
    {{end}}
  </div>
  {{end}}
  {{if and .HandFiling.Candidates (not $inactive)}}
  <details class="card stay-filing ph-hide" id="file-by-hand">
    <summary>{{t "stay.hand_filing.open"}}</summary>
    <p class="ui-sub">{{t "stay.hand_filing.lede"}} <a href="/guide#manual-filing">{{t "guide.reporting.manual_filing_title"}}</a></p>
    <form method="post" action="/reservations/{{$id}}/filed-by-hand" class="settings-grid">
      <div class="ui-field">
        <label for="hand_filed_at">{{t "stay.hand_filing.filed_at"}}</label>
        <input type="datetime-local" id="hand_filed_at" name="filed_at" value="{{.HandFiling.DefaultFiledAt}}" max="{{.HandFiling.DefaultFiledAt}}" required>
      </div>
      <div class="ui-field">
        {{field_label "hand_reference" (t "stay.hand_filing.reference") (t "stay.hand_filing.reference_hint")}}
        <input type="text" id="hand_reference" name="reference" maxlength="200" autocomplete="off" aria-describedby="hand_reference-help">
      </div>
      <p class="ui-sub">{{t "stay.hand_filing.covers" "count" .HandFiling.Candidates}}</p>
      <div class="ui-form-actions"><button class="ui-btn ui-btn-secondary" type="submit">{{t "stay.hand_filing.confirm"}}</button></div>
    </form>
  </details>
  {{end}}
  {{if .Submissions}}
  <div class="card ph-hide"><div class="panel tight scroll-x">
    <table class="ui-table ui-table-stack">
      <thead><tr><th>{{t "stay.detail.reports.when"}}</th><th>{{t "stay.detail.reports.outcome"}}</th><th>{{t "stay.detail.reports.stamp"}}</th><th></th></tr></thead>
      <tbody>
      {{range .Submissions}}
        <tr class="clickable-row" data-href="/submissions/{{.ID}}" tabindex="0" role="link">
          <td class="ui-cell-first nowrap" data-card="primary">{{datetime_local .CreatedAt}}</td>
          <td data-card="badge">{{submission_pill .State}}</td>
          <td class="ui-mono ui-sub" data-card="meta">{{or .PseudoStamp "—"}}</td>
          <td class="ui-cell-acts row-actions" data-card="actions">{{row_open (printf "/submissions/%d" .ID)}}
            {{row_menu_begin}}
              <a class="row-menu-item" href="/submissions/{{.ID}}" role="menuitem">{{t "stay.detail.reports.open"}}</a>
              {{if .HasReceipt}}
                <a data-turbo="false" class="row-menu-item" href="/submissions/{{.ID}}/receipt.pdf" role="menuitem">{{t "reports.receipt"}}</a>
              {{end}}
            {{row_menu_end}}
          </td>
        </tr>
      {{end}}
      </tbody>
    </table>
  </div></div>
{{end}}
</section>

{{with .DoorCode}}<section id="door-code"><h2 class="sec">{{t "stay.detail.door_code.title"}}</h2>
<div class="card stay-door-card">
  <div class="ic acc" aria-hidden="true">{{icon "key-round" 22}}</div>
<div>
  {{if eq .State "issued"}}<div class="code">{{.PIN}}</div><small id="door-code-line">{{.WorksFrom}} – {{.WorksUntil}}</small>
  {{else}}<p id="door-code-line">{{if eq .State "failed"}}{{t "stay.detail.door_code.failed"}}{{else if eq .State "delayed"}}{{t "stay.detail.door_code.delayed"}}{{else if eq .State "preparing"}}{{t "stay.detail.door_code.preparing"}}{{else}}{{t "stay.detail.door_code.waiting"}}{{end}}</p>{{end}}
</div>
</div></section>{{end}}
{{if and (not $inactive) (not $.PaymentsHidden)}}<div class="list ph-hide"><a class="link" href="/payments?reservation_id={{$id}}#new-request">{{t "stays.row.request_payment"}}{{icon "chevron-right" 20}}</a></div>{{end}}
<details class="card stay-settings ph-hide" id="stay-quick-edit">
  <summary><b>{{t "stay.detail.settings.title"}}</b></summary>
  <p class="ui-sub">{{t "stay.detail.settings.lede"}} <a href="/apartments/{{.Reservation.ApartmentID}}?view=settings&amp;section=guests#communication">{{t "stay.detail.settings.guest_links"}}</a>.</p>
  <h3 class="inline-edit-title">{{t "stay.detail.inline.title"}}</h3>
  <form method="post" action="/reservations/{{$id}}" class="settings-grid">
    <div class="ui-field">
      <label for="quick-summary">{{t "stay.detail.inline.label"}}</label>
      <input id="quick-summary" type="text" name="summary" value="{{.Reservation.Summary}}" maxlength="160">
    </div>
    <div class="ui-field">
      <label for="quick-guests">{{t "stay.detail.inline.guests"}}</label>
      <input id="quick-guests" type="number" name="expected_guests_override" value="{{if ne (deref_int .Progress.Expected) 0}}{{deref_int .Progress.Expected}}{{end}}" min="{{max 1 (len .Progress.Guests)}}" max="60">
    </div>
    <div class="ui-field">
      <div class="field-label-row">
        <label for="guest_email">{{t "stay.detail.settings.email"}} <span class="opt">{{t "stay.detail.settings.host_only"}}</span></label>
        {{help_tip "guest_email-help" (t "stay.detail.settings.email_hint")}}
      </div>
      <input type="email" id="guest_email" name="guest_email" value="{{.Reservation.GuestEmail}}" aria-describedby="guest_email-help">
    </div>
    <div class="ui-field">
      {{field_label "status" (t "stay.detail.settings.state") (t "stay.detail.settings.state_hint")}}
      <select id="status" name="status" aria-describedby="status-help">
        <option value="active" {{if eq .Reservation.Status "active"}}selected{{end}}>{{t "stay.detail.settings.state.active"}}</option>
        <option value="cancelled" {{if eq .Reservation.Status "cancelled"}}selected{{end}}>{{t "stay.detail.settings.state.cancelled"}}</option>
        <option value="ignored" {{if eq .Reservation.Status "ignored"}}selected{{end}}>{{t "stay.detail.settings.state.ignored"}}</option>
      </select>
    </div>
    <div class="ui-field">
      <label for="host_note">{{t "stay.detail.settings.note"}}</label>
      <textarea id="host_note" name="host_note">{{.Reservation.HostNote}}</textarea>
    </div>
    <div class="ui-form-actions"><button class="ui-btn ui-btn-secondary" type="submit">{{t "common.save"}}</button></div>
  </form>
</details>
</div>

{{end}}
