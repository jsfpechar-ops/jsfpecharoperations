{{define "stays_list.title"}}{{end}}
{{define "v2_status_pill"}}{{ $row := . }}{{ $cell := $row.Progress.Cell }}{{ $progress := $row.Progress }}{{ $res := $row.Reservation }}
{{if eq $cell.Level "overdue"}}<span class="pill p-bad">{{deadline_badge $cell}}</span>
{{else if eq $progress.Status "failed"}}<span class="pill p-bad">{{progress_pill $progress.Status $res.AutomationMode}}</span>
{{else if and $progress.NotRegistered (gt (not_registered $progress) 0)}}<span class="pill p-warn"><span class="ui-badge ui-badge-action" data-tone="amber">{{tp "host.missing" (not_registered $progress)}}</span></span>
{{else if eq $cell.State "filed_on_time"}}<span class="pill p-ok">{{deadline_badge $cell}}</span>
{{else if eq $cell.State "filed_late"}}<span class="pill p-warn">{{deadline_badge $cell}}</span>
{{else if and (or (eq $progress.Status "awaiting_guest") (eq $progress.Status "incomplete")) (eq $res.AutomationMode "immediate")}}<span class="pill p-warn">{{t "status.waiting_guest"}}</span>
{{else if or (eq $progress.Status "reported") (eq $progress.Status "not_required")}}<span class="pill p-ok">{{t "status.reported"}}</span>
{{else}}{{ $demo := is_demo $res.InternalName $res.Source }}
{{if and $demo (or (eq $progress.Status "ready") (eq $progress.Status "awaiting_verification"))}}<span class="pill p-n">{{progress_pill $progress.Status $res.AutomationMode (kv "is_demo" true)}}</span>
{{else if or (eq $progress.Status "ready") (eq $progress.Status "awaiting_verification") (eq $progress.Status "awaiting_guest") (eq $progress.Status "incomplete")}}<span class="pill p-warn">{{progress_pill $progress.Status $res.AutomationMode (kv "is_demo" $demo)}}</span>
{{else}}<span class="pill p-n">{{progress_pill $progress.Status $res.AutomationMode (kv "is_demo" $demo)}}</span>{{end}}{{end}}
{{end}}
{{define "stays_onboarding_banner"}}{{if .Banner.Show}}<aside class="onboarding-banner onboarding-banner-setup" aria-label="{{t "setup.banner.aria"}}">
  <a class="onboarding-banner-setup-link" href="{{.Banner.URL}}">{{t "setup.banner.line"}}</a>
  <form method="post" action="/onboarding/dismiss"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="return_to" value="{{.Banner.ReturnPath}}">
    <button class="onboarding-skip-link" type="submit">{{t "onboarding.skip"}}</button></form></aside>{{end}}{{end}}
{{define "stays_chips"}}<nav class="settings-pills" aria-label="{{t "stays.title"}}" data-wrap-on-phone>{{range .View.Chips}}<a class="settings-pill{{if .Current}} is-current{{end}}" href="{{.Href}}"{{if .Current}} aria-current="page"{{end}}>{{t .Label}}</a>{{end}}</nav>{{end}}
{{define "stays_date_range"}}<div class="field stay-date-range" data-date-range data-range-prefix="stays">
  <span class="field-label" id="stays-range-label">{{t "host.filter.stay_dates"}}</span>
  <button class="btn date-range-trigger" type="button" data-range-trigger hidden data-all-dates="{{t "host.filter.all_dates"}}" aria-labelledby="stays-range-label stays-range-caption" aria-haspopup="dialog" aria-expanded="false">
    <span data-range-caption id="stays-range-caption">{{t "host.filter.all_dates"}}</span>{{icon "chevron-down" 16}}
  </button>
  <div class="date-range-content" data-range-content>
    <div class="date-range-fields">
      <div class="field"><label for="stays-from">{{t "stays.filter.from"}}</label><input type="date" id="stays-from" name="from" value="{{.DateFrom}}" data-range-from></div>
      <div class="field"><label for="stays-to">{{t "stays.filter.to"}}</label><input type="date" id="stays-to" name="to" value="{{.DateTo}}" data-range-until></div>
    </div>
    <div class="date-range-popover" data-range-popover role="dialog" aria-labelledby="stays-range-label" hidden>
      <div class="range-draft-fields">
        <div class="field"><label for="stays-draft-from">{{t "stays.filter.from"}}</label><input type="date" id="stays-draft-from" data-range-draft-from></div>
        <div class="field"><label for="stays-draft-until">{{t "stays.filter.to"}}</label><input type="date" id="stays-draft-until" data-range-draft-until></div>
      </div>
      <div class="range-calendar-head">
        <button class="btn range-step" type="button" data-range-prev aria-label="{{t "host.filter.prev_month"}}">{{icon "chevron-left" 16}}</button>
        <strong data-range-month></strong>
        <button class="btn range-step" type="button" data-range-next aria-label="{{t "host.filter.next_month"}}">{{icon "chevron-right" 16}}</button>
      </div>
      <div class="range-calendar-grid" data-range-grid role="grid" aria-label="{{t "host.filter.calendar"}}"></div>
      <p class="small muted" data-range-error role="status" tabindex="-1" hidden>{{t "host.filter.reversed_dates"}}</p>
      <div class="date-range-actions">
        <button class="btn ghost" type="button" data-range-clear>{{t "host.filter.clear_dates"}}</button>
        <button class="btn primary" type="button" data-range-apply>{{t "host.filter.apply_dates"}}</button>
      </div>
    </div>
  </div></div>{{end}}
{{define "stays_phone_card"}}{{ $root := .Root }}{{ $row := .Row }}{{ $res := $row.Reservation }}{{ $prog := $row.Progress }}
{{ $who := shown_name $res $prog.Guests }}
{{ $href := printf "/reservations/%d?return_to=%s" $res.ID (encode_return $root.ReturnTo) }}
<a class="card stay" href="{{$href}}" data-stay-search-item>
  <span class="sav">{{if $who}}{{initial_rune $who}}{{else}}{{printf "%d" (day_of_month $res.DateFrom)}}{{end}}</span>
  <span class="in">{{if $who}}<b>{{$who}}</b><small>{{stay_range $root.Lang $res.DateFrom $res.DateTo}} &middot; {{$res.InternalName}}</small>
  {{else}}<b>{{stay_range $root.Lang $res.DateFrom $res.DateTo}}</b><small>{{$res.InternalName}}</small>{{end}}
  {{if ne $res.Status "active"}}<span class="pill p-n">{{t (printf "stays.filter.state.%s" $res.Status)}}</span>
  {{else if $prog.HasCell}}{{template "v2_status_pill" $row}}
  {{else}}{{progress_pill $prog.Status $res.AutomationMode}}{{end}}
  </span>{{icon "chevron-right" 20 "chev"}}
</a>{{end}}
{{define "stays_desk_row"}}{{ $root := .Root }}{{ $row := .Row }}{{ $res := $row.Reservation }}{{ $prog := $row.Progress }}
{{ $shown := shown_name $res $prog.Guests }}
{{ $stayLabel := stay_label $res }}
{{ $href := printf "/reservations/%d?return_to=%s" $res.ID (encode_return $root.ReturnTo) }}
<tr class="clickable-row" data-href="{{$href}}" data-stay-id="{{$res.ID}}" data-stay-search-item tabindex="0" role="link"
    aria-label="{{$stayLabel}} · {{date_cz $res.DateFrom}} – {{date_cz $res.DateTo}}">
  <td data-card="primary" data-label="{{t "stays.table.guest"}}">
    {{if $shown}}<a class="stay-identity-link" href="{{$href}}">{{$shown}}</a>
    {{else}}<a class="stay-identity-link stay-noname" href="{{$href}}">{{t "stays.row.no_name"}}</a>
    {{if eq $res.Status "active"}}<a class="stay-noname-action" href="/reservations/{{$res.ID}}/guests/new">{{t "stays.row.add_guest"}}</a>{{end}}{{end}}
    <small>{{source_badge $res.Source (source_label $root.Lang $res.Source)}}</small>
  </td>
  <td class="stays-col-prop" data-card="meta" data-label="{{t "stays.table.property"}}">{{$res.InternalName}}</td>
  <td class="nowrap" data-card="secondary" data-label="{{t "stays.table.dates"}}">
    <span class="stay-dates-span">{{date_cz $res.DateFrom}} – {{date_cz $res.DateTo}}</span>
    <small>{{tp "stays.table.nights" (nights $res.DateFrom $res.DateTo)}}
      {{if in_house $prog.Anchor $prog.HasAnchor $res.DateTo $root.Today}} &middot; <span class="ui-badge ui-badge-neutral" data-tone="grey">{{t "stays.table.in_house"}}</span>{{end}}
    </small>
  </td>
  <td class="nowrap stays-col-guests" data-card="guests" data-label="{{t "stays.table.guests"}}">
    {{if or (not (is_nil_int $prog.Expected)) $prog.Guests}}{{guest_count (layout_progress $prog)}}{{else}}<span class="muted" aria-label="{{t "common.guests_unknown"}}">–</span>{{end}}
  </td>
  <td data-card="badge" data-label="{{t "stays.table.reporting"}}">
    {{if ne $res.Status "active"}}<span class="pill p-n">{{t (printf "stays.filter.state.%s" $res.Status)}}</span>
    {{else if $prog.HasCell}}{{template "v2_status_pill" $row}}
      {{if and (ne $prog.Cell.Level "overdue") (ne $prog.Cell.State "filed_on_time") (ne $prog.Cell.State "filed_late")}}<small>{{deadline_badge $prog.Cell}}</small>{{end}}
    {{else}}{{progress_pill $prog.Status $res.AutomationMode (kv "is_demo" (is_demo $res.InternalName $res.Source) "step" (journey_step $prog.Status))}}{{end}}
  </td>
</tr>{{end}}
{{define "stays_list"}}
<div class="head stays-head"><div><div class="stays-title-row"><h1 class="big">{{t "stays.title"}}</h1>{{page_help "stays"}}</div></div>
{{if .Apartments}}<button class="round stays-add ph-only" type="button" data-toggle-panel="add-stay-panel" aria-label="{{t "stays.add_stay"}}">{{icon "plus" 22}}</button>
<div class="stays-head-actions">
  {{if .View.ManualSend}}<form method="post" action="/reservations/submit-ready" class="inline send-all-form"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="return_to" value="{{.ReturnTo}}">
    <button class="btn ghost send-all" type="submit"{{if not .View.ReadySendCount}} disabled{{end}} title="{{t "send.all_ready_hint"}}">{{icon "send" 16}}<span>{{t "send.all_ready"}}{{if .View.ReadySendCount}} ({{.View.ReadySendCount}}){{end}}</span></button></form>{{end}}
  <button class="btn" type="button" data-toggle-panel="add-stay-panel">{{t "stays.add_stay"}}</button>
  <span class="row-menu stays-head-menu" data-row-menu>
    <button class="btn ghost row-menu-trigger stays-head-menu-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="{{t "stays.head.more"}}">{{icon "ellipsis-vertical" 18}}</button>
    <span class="row-menu-panel" role="menu" hidden>
      <a class="row-menu-item" href="/submissions" role="menuitem">{{t "tabs.stays.reports"}}</a>
      <a class="row-menu-item" href="/housebook" role="menuitem">{{t "tabs.stays.register"}}</a>
      <a data-turbo="false" class="row-menu-item" href="/housebook.csv?{{.CSVExportParams}}" data-stays-housebook role="menuitem">{{t "stays.housebook_download"}}</a>
      <a data-turbo="false" class="row-menu-item" href="/reservations.csv?{{.CSVExportParams}}" data-csv-export="/reservations.csv" data-csv-params="{{.CSVExportParams}}" data-csv-scope-label="{{.StayProperty}}" role="menuitem">{{t "csv.export_stays"}}</a>
    </span>
  </span>
</div>{{end}}</div>
{{template "stays_onboarding_banner" .}}
{{if .Apartments}}
<div id="add-stay-panel" class="action-panel hidden stays-panel">
  <div class="ui-section">
    <div class="ui-section-h"><h2>{{t "stays.add_panel.title"}}</h2><button class="ui-btn ui-btn-quiet ui-btn-compact" type="button" data-close-panel>{{t "common.close"}}</button></div>
    <p class="sub">{{t "stays.add_panel.lede"}}</p>
    <form method="post" action="/reservations"><input type="hidden" name="_csrf" value="{{csrf}}">
      <p class="required-legend">{{t "common.required_legend"}}</p>
      <div class="grid">
        <div class="ui-field"><label for="new_apartment">{{t "stays.add_panel.apartment"}}<span class="req-star" aria-hidden="true">*</span></label>
          <select id="new_apartment" name="apartment_id" required>{{range .Apartments}}<option value="{{.ID}}">{{.Name}}</option>{{end}}</select></div>
        <div class="ui-field"><label for="date_from">{{t "stays.add_panel.arrival"}}<span class="req-star" aria-hidden="true">*</span></label><input type="date" id="date_from" name="date_from" required></div>
        <div class="ui-field"><label for="date_to">{{t "stays.add_panel.departure"}}<span class="req-star" aria-hidden="true">*</span></label><input type="date" id="date_to" name="date_to" required></div>
        <div class="ui-field"><label for="expected_guests">{{t "stays.add_panel.guests"}} <span class="opt">{{t "common.optional"}}</span></label><input type="number" id="expected_guests" name="expected_guests" min="1" max="60"></div>
      </div>
      <div class="grid two">
        <div class="ui-field"><label for="summary">{{t "stays.add_panel.label"}} <span class="opt">{{t "common.optional"}}</span></label><input type="text" id="summary" name="summary" placeholder="{{t "stays.add_panel.label_ph"}}"></div>
        <div class="ui-field"><label for="guest_email">{{t "stays.add_panel.email"}} <span class="opt">{{t "common.optional"}}</span></label><input type="email" id="guest_email" name="guest_email"></div>
      </div>
      <div class="ui-form-actions">{{ui_button (t "stays.add_panel.create") "primary" (kv "type" "submit")}}</div>
    </form>
  </div>
</div>
<div class="stays-toolbar ph-hide">
  <div class="stays-toolbar-controls">
    <label class="stays-search">
      <span class="sr-only">{{t "stays.search.placeholder"}}</span>
      {{icon "search" 16}}
      <input type="search" class="stays-search-input" data-stays-search placeholder="{{t "stays.search.placeholder"}}" autocomplete="off">
    </label>
    <button class="btn ghost stays-filter-btn" type="button" data-filter-toggle aria-expanded="false" aria-controls="stays-filter-panel" hidden>{{icon "sliders-horizontal" 16}}<span>{{t "host.filter.filters"}}</span></button>
  </div>
  <div class="stays-toolbar-meta">
    <p class="sub" data-filter-summary><span>{{.StayProperty}}</span><span aria-hidden="true"> · </span><span>{{t (printf "stays.filter.state.%s" .Status)}}</span>
      {{if and (eq .DateRange "custom") (or .DateFrom .DateTo)}}<span aria-hidden="true"> · </span>
        {{if and .DateFrom .DateTo}}{{t "host.filter.range_between" (kv "start" (date_cz .DateFrom) "end" (date_cz .DateTo))}}
        {{else if .DateFrom}}{{t "host.filter.range_from" (kv "date" (date_cz .DateFrom))}}
        {{else}}{{t "host.filter.range_until" (kv "date" (date_cz .DateTo))}}{{end}}{{end}}</p>
    {{if or (ne .ApartmentID 0) (ne .Status "active") (eq .DateRange "custom")}}<p class="sub stays-scope-reset"><a data-stays-reset href="{{if .ShowArchive}}/reservations?range=archive{{else}}/reservations?range=all{{end}}">{{t "stays.filter.reset_scope"}}</a></p>{{end}}
  </div>
</div>
<div class="saved-views" data-saved-views data-label="{{t "stays.filter.saved_views"}}"></div>
{{if .ShowArchive}}<p class="sub ph-hide">{{t "stays.archive_note"}}</p>{{end}}
<form id="stays-filter-panel" method="get" action="/reservations" class="filters ui-section host-filter-panel stays-filter is-collapsed" data-filter-panel data-filter-route="stays" data-original-range="{{.DateRange}}">
  <div class="stays-pills">{{template "stays_chips" .}}</div>
  <div class="filter-fields">
    <div class="ui-field"><label for="apartment">{{t "stays.filter.apartment"}}</label>
      <select id="apartment" name="apartment"><option value="">{{t "host.filter.all_properties"}}</option>{{range .Apartments}}<option value="{{.ID}}" {{if eq .ID $.ApartmentID}}selected{{end}}>{{.Name}}</option>{{end}}</select></div>
    <div class="ui-field"><label for="status">{{t "stays.filter.state"}}</label>
      <select id="status" name="status">
        <option value="active" {{if eq .Status "active"}}selected{{end}}>{{t "stays.filter.state.active"}}</option>
        <option value="cancelled" {{if eq .Status "cancelled"}}selected{{end}}>{{t "stays.filter.state.cancelled"}}</option>
        <option value="ignored" {{if eq .Status "ignored"}}selected{{end}}>{{t "stays.filter.state.ignored"}}</option>
        <option value="all" {{if eq .Status "all"}}selected{{end}}>{{t "stays.filter.state.all"}}</option>
      </select></div>
    {{template "stays_date_range" .}}
  </div>
  {{if .ShowArchive}}<input type="hidden" name="archive_scope" value="1">{{end}}
  {{if .Report}}<input type="hidden" name="report" value="{{.Report}}">{{end}}
  <div class="filter-panel-actions">
    <button class="ui-btn ui-btn-primary filter-apply" type="submit" name="range" value="custom">{{t "host.filter.apply_filters"}}</button>
    <button class="ui-btn ui-btn-quiet" type="button" data-filter-cancel hidden>{{t "confirm.cancel"}}</button>
  </div>
</form>
{{end}}
{{if .View.Rows}}
{{$root := .}}
<div class="stays-workspace" data-stays-workspace>
<div class="stays-workspace-main">
<div class="stays-phone">
{{if index $root.Groups "today"}}<h2 class="sec">{{t "stays.grp.today"}}</h2>{{range index $root.Groups "today"}}{{template "stays_phone_card" (kv "Root" $root "Row" .)}}{{end}}{{end}}
{{if index $root.Groups "week"}}<h2 class="sec">{{t "stays.grp.week"}}</h2>{{range index $root.Groups "week"}}{{template "stays_phone_card" (kv "Root" $root "Row" .)}}{{end}}{{end}}
{{if index $root.Groups "later"}}<h2 class="sec">{{t "stays.grp.later"}}</h2>{{range index $root.Groups "later"}}{{template "stays_phone_card" (kv "Root" $root "Row" .)}}{{end}}{{end}}
{{if index $root.Groups "earlier"}}<h2 class="sec">{{if and (eq $root.DateRange "upcoming")}}{{t "stays.grp.overdue"}}{{else}}{{t "stays.grp.earlier"}}{{end}}</h2>{{range index $root.Groups "earlier"}}{{template "stays_phone_card" (kv "Root" $root "Row" .)}}{{end}}{{end}}
</div>
<div class="card stays-desk"><table>
  <thead><tr>
    <th>{{t "stays.table.guest"}}</th><th class="stays-col-prop">{{t "stays.table.property"}}</th><th>{{t "stays.table.dates"}}</th><th class="stays-col-guests">{{t "stays.table.guests"}}</th><th>{{t "stays.table.reporting"}}</th>
  </tr></thead>
  <tbody class="stays-list">{{range .View.Rows}}{{template "stays_desk_row" (kv "Root" $root "Row" .)}}{{end}}</tbody>
</table></div>
<p class="sub stays-count ph-hide">{{if eq .View.Total 1}}{{t "stays.pagination.showing" (kv "from" (page_from .View.Page .PageSize) "to" (page_to .View.Page .PageSize .View.Total) "total" .View.Total)}}
{{else}}{{t "stays.pagination.showing_plural" (kv "from" (page_from .View.Page .PageSize) "to" (page_to .View.Page .PageSize .View.Total) "total" .View.Total)}}{{end}}</p>
{{if gt .View.PageCount 1}}<nav class="stays-pager ph-hide" aria-label="{{t "stays.title"}}">
  {{if .View.PrevURL}}<a class="btn ghost sm" href="{{.View.PrevURL}}" rel="prev">{{t "stays.pagination.prev"}}</a>{{else}}<span class="btn ghost sm" aria-disabled="true">{{t "stays.pagination.prev"}}</span>{{end}}
  <span class="stays-pager-label">{{t "stays.pagination.label" (kv "page" .View.Page "pages" .View.PageCount)}}</span>
  {{if .View.NextURL}}<a class="btn ghost sm" href="{{.View.NextURL}}" rel="next">{{t "stays.pagination.next"}}</a>{{else}}<span class="btn ghost sm" aria-disabled="true">{{t "stays.pagination.next"}}</span>{{end}}
</nav>
{{if .View.NextURL}}<div class="list stays-more" data-stays-more><a class="link" href="{{.View.NextURL}}" rel="next"><span>{{t "stays.more"}}</span>{{icon "chevron-right" 16}}</a></div>{{end}}
{{end}}
</div>
<div class="stays-drawer-backdrop" data-stays-drawer-backdrop hidden></div>
<aside id="stays-drawer" class="stays-drawer" data-stays-drawer hidden aria-label="{{t "stays.drawer.title"}}"
  data-open-full-label="{{t "stays.drawer.open_full"}}"
  data-close-label="{{t "common.close"}}"
  data-loading-label="{{t "stays.drawer.loading"}}"
  data-label-property="{{t "stays.table.property"}}"
  data-label-dates="{{t "stays.table.dates"}}"
  data-label-guests="{{t "stays.table.guests"}}"
  data-label-reporting="{{t "stays.table.reporting"}}"
  data-label-add-guest="{{t "stays.row.add_guest"}}"></aside>
</div>
{{else if .ShowArchive}}{{empty_state "" (t "stays.empty.archive")}}
{{else if .HasAny}}{{empty_state "" (t "stays.empty.filter") "/reservations?range=all" (t "stays.empty.show_all") (kv "primary" false)}}
{{else if .Apartments}}{{if .FeedCount}}{{empty_state "" (t "stays.empty.none") "/apartments" (t "stays.empty.go_apartments") (kv "primary" false)}}
{{else}}{{empty_state "" (t "stays.empty.none") (printf "/apartments/%d?view=bookings#calendars" (index .Apartments 0).ID) (t "dashboard.empty.connect_calendar")}}{{end}}
{{else if .DemoAvailable}}
<div class="ui-empty" data-empty-state><p>{{t "stays.empty.no_apartments"}}</p>
  <div class="ui-btn-group"><a class="ui-btn ui-btn-primary" href="/apartments/new">{{t "stays.empty.add_first"}}</a></div>
  <form method="post" action="/demo" class="empty-state-extra"><input type="hidden" name="_csrf" value="{{csrf}}">
    <button class="ui-btn ui-btn-secondary" type="submit">{{t "demo.load"}}</button><p class="sub">{{t "demo.load_detail"}}</p></form></div>
{{else}}{{empty_state "" (t "stays.empty.no_apartments") "/apartments/new" (t "stays.empty.add_first")}}{{end}}
<div class="stays-index-card stays-links stays-phone-links">
  <a class="airbnb-index-row" href="/submissions"><span class="airbnb-icon">{{icon "shield" 24}}</span><span class="airbnb-label">{{t "tabs.stays.reports"}}</span>{{icon "chevron-right" 16}}</a>
  <a class="airbnb-index-row" href="/housebook"><span class="airbnb-icon">{{icon "book-open" 24}}</span><span class="airbnb-label">{{t "tabs.stays.register"}}</span>{{icon "chevron-right" 16}}</a>
  <a data-turbo="false" class="airbnb-index-row" href="/reservations.csv?{{.CSVExportParams}}"><span class="airbnb-icon">{{icon "download" 24}}</span><span class="airbnb-label">{{t "csv.export_stays"}}</span>{{icon "chevron-right" 20}}</a>
  <a data-turbo="false" class="airbnb-index-row stays-phone-only" href="/housebook.csv?{{.CSVExportParams}}" data-stays-housebook-phone><span class="airbnb-icon">{{icon "download" 24}}</span><span class="airbnb-label">{{t "stays.housebook_download"}}<small>{{t "stays.housebook_hint"}}</small></span>{{icon "chevron-right" 20}}</a>
</div>
{{end}}
