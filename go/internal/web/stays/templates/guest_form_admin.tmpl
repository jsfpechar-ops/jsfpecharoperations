{{- /* Port of App/app/templates/guest_form_admin.html (brief 2018): the host
     guest form for /reservations/{id}/guests/new and /guests/{id}. Field names,
     counts, order, wording and classes are the Python template's. */ -}}
{{define "guest_identity_placeholder"}}
  <div class="identity-hidden" data-identity-hidden>
    <p class="ui-sub"><strong>{{t "identity.hidden"}}</strong></p>
    <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit" form="reveal-identity">{{t "identity.reveal"}}</button>
  </div>
{{end}}
{{define "guest_form_admin.meta"}}{{.MetaText}}{{end}}
{{define "guest_form_admin.back_label"}}{{t "guest.admin.back_to_stay"}}{{end}}
{{define "guest_form_admin"}}{{$G := .Guest}}
{{if and .Editing $G (or (eq $G.SubmitState "error") (eq $G.SubmitState "blocked"))}}
  <div class="ui-banner ui-banner-attention">
    <div class="grow">
      <strong>{{t "guest.admin.banner.rejected_title"}}</strong>
      <small>{{$G.LastErrors}}</small>
      <small>{{t "guest.admin.banner.rejected_help"}}</small>
    </div>
  </div>
{{end}}
{{if and .Editing $G (eq $G.SubmitState "sent")}}
  <div class="ui-banner ui-banner-neutral">
    <div class="grow">
      <strong>{{if $G.ManualFiledAt}}{{t "guest.admin.banner.filed_by_hand" "at" $G.ManualFiledAt}}{{else if $G.SubmittedAt}}{{t "guest.admin.banner.sent_title_at" "at" $G.SubmittedAt}}{{else}}{{t "guest.admin.banner.sent_title"}}{{end}}</strong>
      <small id="filed-lock-note">{{t "guest.admin.banner.sent_help"}}</small>
    </div>
  </div>
{{end}}
{{if .IdentityHidden}}
  <div class="ui-banner ui-banner-attention" id="identity-hidden-note" role="status">
    <div class="grow">
      <strong>{{t "identity.hidden"}}</strong>
      <small>{{t "identity.hidden_help"}}</small>
      <div class="ui-field">
        <label for="reveal-reason">{{t "identity.reveal_reason"}}<span class="req-star" aria-hidden="true">*</span></label>
        <input type="text" id="reveal-reason" name="reason" form="reveal-identity"
               minlength="5" maxlength="300" required>
      </div>
    </div>
    <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit" form="reveal-identity">{{t "identity.reveal"}}</button>
  </div>
{{end}}
<form method="post" class="guest-admin-form" action="{{if .Editing}}/guests/{{$G.ID}}{{else}}/reservations/{{.Reservation.ID}}/guests{{end}}">
  <input type="hidden" name="_csrf" value="{{.CSRF}}">
  <div class="ui-section">
    <h2>{{t "guest.admin.identity.title"}}</h2>
    <p class="required-legend">{{t "common.required_legend"}}</p>
    <div class="ui-pair">
      <div class="ui-field">
        <label for="surname">{{t "guest.admin.surname"}}<span class="req-star" aria-hidden="true">*</span></label>
        <input class="{{bad .Issues "surname"}}" type="text" id="surname" name="surname"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}} maxlength="50" required
               value="{{guestVal $G "surname"}}">
        {{errFor .Issues "surname"}}
      </div>
      <div class="ui-field">
        <label for="first_name">{{t "guest.admin.given_names"}}</label>
        <input class="{{bad .Issues "first_name"}}" type="text" id="first_name" name="first_name"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}} maxlength="24"
               value="{{guestVal $G "first_name"}}">
        {{errFor .Issues "first_name"}}
      </div>
    </div>
    <div class="grid">
      <div class="ui-field">
        <label for="birth_date">{{t "guest.admin.birth_date"}}</label>
        <input class="{{bad .Issues "birth_date"}}" type="text" id="birth_date" name="birth_date"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}}
               data-birth-date inputmode="numeric" placeholder="{{t "guest.admin.birth_date_ph"}}" maxlength="10"
               autocomplete="bday"
               value="{{if $G}}{{$G.BirthDate}}{{end}}">
        <div class="ui-help">{{t "guest.admin.birth_date_hint"}}</div>
        {{errFor .Issues "birth_date"}}
      </div>
      <div class="ui-field">
        <label for="nationality">{{t "stay.detail.guests.nationality"}}<span class="req-star" aria-hidden="true">*</span></label>
        <select class="{{bad .Issues "nationality"}}" id="nationality" name="nationality"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}} required>
          <option value="">{{t "common.select"}}</option>
          {{range .Countries}}<option value="{{.Code}}"
              {{if $G}}{{if eq $G.Nationality .Code}}selected{{end}}{{end}}>
              {{.Label}} ({{.Code}})</option>{{end}}
        </select>
        <div class="ui-help">{{t "guest.admin.nationality_hint"}}</div>
        {{errFor .Issues "nationality"}}
      </div>
      <div class="ui-field">
        <label for="doc_type">{{t "guest.doc_type.label"}}</label>
        <select id="doc_type" name="doc_type">
          {{range .DocTypes}}<option value="{{.Code}}"
              {{if eq .Code $.SelectedDocType}}selected{{end}}>
              {{t .Key}}</option>{{end}}
        </select>
        <div class="ui-help">{{t "guest.doc_type.hint"}}</div>
      </div>
      <div class="ui-field">
        <label for="doc_number">{{t "guest.admin.document"}}</label>
        {{if .IdentityHidden}}
        <input type="text" id="doc_number" value="{{.DocNumberShown}}" readonly aria-describedby="identity-hidden-note">
        {{else}}
        <input class="{{bad .Issues "doc_number"}}" type="text" id="doc_number" name="doc_number"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}} maxlength="30"
               value="{{guestVal $G "doc_number"}}">
        {{end}}
        <div class="ui-help">{{t "guest.admin.document_hint"}}</div>
        {{errFor .Issues "doc_number"}}
      </div>
      <div class="ui-field">
        <label for="visa_number">{{t "guest.admin.visa"}} <span class="ui-opt">{{t "common.optional"}}</span></label>
        {{if .IdentityHidden}}
        <input type="text" id="visa_number" value="{{.VisaNumberShown}}" readonly aria-describedby="identity-hidden-note">
        {{else}}
        <input class="{{bad .Issues "visa_number"}}" type="text" id="visa_number" name="visa_number"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}} maxlength="15"
               value="{{guestVal $G "visa_number"}}">
        {{end}}
        {{errFor .Issues "visa_number"}}
      </div>
    </div>
  </div>

  <div class="ui-section">
    <h2>{{t "stay.detail.guests.residence"}}</h2>
    <div class="grid">
      <div class="ui-field">
        <label for="res_street">{{t "guest.admin.res_street"}} <span class="ui-opt">{{t "common.optional"}}</span></label>
        <input class="{{bad .Issues "res_street"}}" type="text" id="res_street" name="res_street"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}} maxlength="42"
               value="{{guestVal $G "res_street"}}">
        {{errFor .Issues "res_street"}}
      </div>
      <div class="ui-field">
        <label for="res_city">{{t "guest.admin.res_city"}}</label>
        <input class="{{bad .Issues "res_city"}}" type="text" id="res_city" name="res_city"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}} maxlength="42"
               value="{{guestVal $G "res_city"}}">
        {{errFor .Issues "res_city"}}
      </div>
      <div class="ui-field">
        <label for="res_country">{{t "guest.admin.res_country"}}</label>
        <select class="{{bad .Issues "res_country"}}" id="res_country" name="res_country"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}}>
          <option value="">{{t "common.select"}}</option>
          {{range .Countries}}<option value="{{.Code}}"
              {{if $G}}{{if eq $G.ResCountry .Code}}selected{{end}}{{end}}>
              {{.Label}} ({{.Code}})</option>{{end}}
        </select>
        {{errFor .Issues "res_country"}}
      </div>
    </div>
  </div>

  <div class="ui-section">
    <h2>{{t "guest.admin.stay.title"}}</h2>
    <div class="grid">
      <div class="ui-field">
        <label for="stay_from">{{t "guest.admin.stay_from"}}</label>
        <input type="date" id="stay_from" name="stay_from"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}}
               value="{{.StayFrom}}">
      </div>
      <div class="ui-field">
        <label for="stay_to">{{t "guest.admin.stay_to"}}</label>
        <input class="{{bad .Issues "stay_to"}}" type="date" id="stay_to" name="stay_to"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}}
               value="{{.StayTo}}">
        {{errFor .Issues "stay_to"}}
      </div>
      <div class="ui-field">
        <label for="purpose">{{t "stay.detail.guests.purpose"}}</label>
        <select id="purpose" name="purpose"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}}>
          {{range .Purposes}}<option value="{{.Code}}"
              {{if .Selected}}selected{{end}}>
              {{.Label}}</option>{{end}}
        </select>
      </div>
    </div>
    <div class="ui-field">
      <label for="note">{{t "guest.admin.note"}} <span class="ui-opt">{{t "guest.admin.note_optional"}}</span></label>
      <textarea class="{{bad .Issues "note"}}" id="note" name="note"{{if .Filed}} disabled aria-describedby="filed-lock-note"{{end}} maxlength="255">{{guestVal $G "note"}}</textarea>
      {{errFor .Issues "note"}}
    </div>
  </div>
{{if and .Editing .NeedsVerification .HasPassportPhoto}}
  <div class="ui-section verify-panel">
    {{if .IdentityHidden}}
      {{template "guest_identity_placeholder" .}}
    {{else}}
      <div class="passport-preview compact">
        {{if .PassportIsPDF}}
          <p class="passport-preview-pdf-link">
            <a data-turbo="false" class="ui-btn ui-btn-quiet ui-btn-compact" href="/guests/{{$G.ID}}/passport-photo" download>{{t "guest.admin.passport_pdf_download"}}</a>
          </p>
          <p class="ui-sub">{{t "guest.admin.passport_pdf_hint"}}</p>
        {{else}}
          <img src="/guests/{{$G.ID}}/passport-photo" alt="{{t "guest.admin.passport_photo_alt"}}">
        {{end}}
      </div>
    {{end}}
  </div>
{{end}}

  <div class="ui-section">
    <h2>{{t "host.signature_title"}}</h2>
    {{if .IdentityHidden}}
    {{template "guest_identity_placeholder" .}}
    {{else if .Filed}}
    {{if .SignatureValue}}
    <div class="signature-saved">
      <img src="{{.SignatureValue}}" alt="{{t "host.signature_saved_alt"}}">
    </div>
    {{end}}
    <p class="small muted signature-saved-note">
      {{if and .SignatureValue $G.SignedAt}}{{t "host.signature_signed_on" "date" $G.SignedAt}}
      {{else if .SignatureValue}}{{t "host.signature_signed"}}
      {{else}}{{t "host.signature_none_filed"}}{{end}}
      {{t "host.signature_locked"}}
    </p>
    {{else}}
    <p class="ui-sub" id="sig-help">{{t "host.signature_help"}}</p>
    <div class="signature-pad">
      <canvas id="sig-canvas" tabindex="0" role="img" aria-label="{{t "host.signature_title"}}"
              aria-describedby="sig-help sig-status"></canvas>
      <div class="signature-pad-bar">
        <span id="sig-status" class="err" role="alert" aria-live="polite"
              data-missing="{{t "host.signature_missing"}}"
              data-kept="{{t "host.signature_kept"}}"></span>
        <button class="ui-btn ui-btn-secondary ui-btn-compact" type="button" id="sig-clear">{{t "host.signature_clear"}}</button>
      </div>
    </div>
    <input type="hidden" id="signature" name="signature"
           value="{{.SignatureValue}}">
    {{end}}
    {{errFor .Issues "signature"}}
  </div>

  <div class="ui-form-actions">
    <a class="ui-btn ui-btn-quiet" href="/reservations/{{.Reservation.ID}}">{{t "confirm.cancel"}}</a>
    <button class="ui-btn ui-btn-primary" type="submit">{{if .Editing}}{{t "common.save_changes"}}{{else}}{{t "guest.admin.submit_add"}}{{end}}</button>
  </div>
  {{if .Editing}}{{with $G}}{{if .ID}}
  <div class="ui-form-actions">
    <a data-turbo="false" class="ui-btn ui-btn-secondary ui-btn-compact" href="/guests/{{.ID}}/form.pdf">{{t "guest.admin.download_pdf"}}</a>
    <a data-turbo="false" class="ui-btn ui-btn-secondary ui-btn-compact" href="/guests/{{.ID}}/export.json">{{t "guest.admin.export_dsr"}}</a>
    <a class="ui-btn ui-btn-secondary ui-btn-compact" href="/privacy-requests">{{t "guest.admin.record_request"}}</a>
    {{if .Restricted}}
      <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit" formaction="/guests/{{.ID}}/unrestrict">{{t "guest.admin.unrestrict"}}</button>
    {{else}}
      <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit" formaction="/guests/{{.ID}}/restrict">{{t "guest.admin.restrict"}}</button>
    {{end}}
  </div>
  {{end}}{{end}}{{end}}
</form>

{{if .IdentityHidden}}
<form id="reveal-identity" method="post" action="/guests/{{$G.ID}}/reveal-identity">
  <input type="hidden" name="_csrf" value="{{.CSRF}}">
  <input type="hidden" name="return_to" value="/guests/{{$G.ID}}?return_to=/reservations/{{.Reservation.ID}}">
</form>
{{end}}


{{if .Editing}}{{with $G}}{{if .ID}}
<details class="ui-section danger-zone">
  <summary>{{t "guest.admin.danger.summary"}}</summary>
<div>
  <h3>{{t "guest.admin.resend.title"}}</h3>
  <p class="ui-sub">
    {{t "guest.admin.resend.help"}}
  </p>
  <form method="post" action="/guests/{{.ID}}/resend">
    <input type="hidden" name="_csrf" value="{{$.CSRF}}">
    <label class="checkline" for="confirm_duplicate">
      <input type="checkbox" id="confirm_duplicate" name="confirm_duplicate" value="1">
      <span>{{t "guest.admin.resend.confirm"}}</span>
    </label>
    <button class="ui-btn ui-btn-danger" type="submit">{{t "guest.admin.resend.submit"}}</button>
  </form>
</div>

{{if ne .SubmitState "sent"}}
<form method="post" action="/guests/{{.ID}}/delete" class="ui-section"
      data-confirm data-confirm-message="{{t "confirm.remove_guest"}}">
  <input type="hidden" name="_csrf" value="{{$.CSRF}}">
  <h3>{{t "guest.admin.remove.title"}}</h3>
  <button class="ui-btn ui-btn-danger" type="submit">{{t "guest.admin.remove.submit"}}</button>
</form>
{{end}}
</details>
{{end}}{{end}}{{end}}
<script src="/static/signature.js?v=20261113-inpass"></script>
{{end}}
