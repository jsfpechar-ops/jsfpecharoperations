{{- /* Brief 2036: Access & guide — entry codes (up to 3), guest preview, door status. */ -}}
{{define "access.title"}}{{end}}
{{define "access.back_label"}}{{.Apartment.InternalName}}{{end}}
{{define "access"}}
<div class="settings-lane ui-page-narrow">
<div class="airbnb-header">
  <a class="airbnb-back" href="/apartments/{{.Apartment.ID}}" aria-label="{{t "common.back"}}">{{icon "arrow-left" 20}}</a>
  <div class="heading-with-tip"><h1 class="airbnb-title">{{t "access_page.title"}}{{help_tip "access-page-help" (t "access_page.help")}}</h1></div>
</div>

{{guide_section_open "entry-codes" (t "access_page.codes.title") (help_tip "access-codes-help" (t "access_page.codes.help"))}}
{{if not .Codes}}
<p class="ui-sub">{{t "access_page.empty.title"}}</p>
<div class="ui-form-actions">{{ui_button (t "access_page.add") "secondary" (kv "href" (printf "%s?add=1" .Base))}}</div>
{{else}}
{{range .Codes}}
<div class="access-code-row ui-section-card" data-position="{{.Position}}">
  <div class="ui-kv">
    <div class="ui-kv-row"><span>{{t "access_page.field.type"}}</span><span>{{if eq .Type "other"}}{{.Label}}{{else}}{{t (printf "access_page.type.%s" .Type)}}{{end}}</span></div>
    <div class="ui-kv-row"><span>{{t "access_page.field.code"}}</span><span class="ui-monospace" style="white-space:nowrap">{{.Masked}}</span></div>
    {{if .Until}}<div class="ui-kv-row"><span>{{t "access_page.valid_until_label"}}</span><span>{{.Until}}</span></div>{{end}}
  </div>
  {{if .Expired}}{{ui_banner "attention" (t "access_page.expired" "date" .Until)}}{{end}}
  {{if and $.Form $.Form.Open (eq $.Form.Position .Position)}}
  <form method="post" action="{{$.Base}}" id="access-form">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <input type="hidden" name="action" value="save">
  <input type="hidden" name="position" value="{{.Position}}">
  {{ui_select "access-type" (t "access_page.field.type") $.TypeOptions (kv "name" "code_type" "selected" $.Form.CodeType)}}
  {{ui_field "access-name" (t "access_page.field.name") (kv "name" "custom_label" "value" $.Form.CustomLabel "help" (t "access_page.field.name_help") "attrs" (safe `maxlength="60" id="access-custom-label"`))}}
  {{ui_field "access-code" (t "access_page.field.code") (kv "name" "code" "type" "text" "attrs" (safe `maxlength="32" autocomplete="off" required inputmode="text" class="ui-monospace"`))}}
  {{ui_field "access-until" (t "access_page.field.valid_until") (kv "name" "valid_until" "type" "date" "value" $.Form.ValidUntil "optional" true)}}
  <div class="ui-form-actions">{{ui_button (t "access_page.save") "secondary" (kv "type" "submit")}}{{ui_button (t "access_page.cancel") "quiet" (kv "href" $.Base)}}</div>
  </form>
  {{else}}
  <div class="ui-form-actions access-code-actions">
    {{ui_button (t "access_page.replace") "secondary" (kv "href" (printf "%s?edit=%d#entry-codes" $.Base .Position))}}
    <form method="post" action="{{$.Base}}" class="access-inline-form">
    <input type="hidden" name="_csrf" value="{{csrf}}">
    <input type="hidden" name="action" value="clear">
    <input type="hidden" name="position" value="{{.Position}}">
    {{ui_button (t "access_page.clear") "quiet" (kv "type" "submit")}}
    </form>
  </div>
  {{end}}
</div>
{{end}}
{{if and .Form .Form.Open .Form.IsNew}}
<form method="post" action="{{.Base}}" id="access-form">
<input type="hidden" name="_csrf" value="{{csrf}}">
<input type="hidden" name="action" value="save">
{{ui_select "access-type" (t "access_page.field.type") .TypeOptions (kv "name" "code_type" "selected" .Form.CodeType)}}
{{ui_field "access-name" (t "access_page.field.name") (kv "name" "custom_label" "value" .Form.CustomLabel "help" (t "access_page.field.name_help") "attrs" (safe `maxlength="60" id="access-custom-label"`))}}
{{ui_field "access-code" (t "access_page.field.code") (kv "name" "code" "type" "text" "attrs" (safe `maxlength="32" autocomplete="off" required inputmode="text" class="ui-monospace"`))}}
{{ui_field "access-until" (t "access_page.field.valid_until") (kv "name" "valid_until" "type" "date" "value" .Form.ValidUntil "optional" true)}}
<div class="ui-form-actions">{{ui_button (t "access_page.save") "secondary" (kv "type" "submit")}}{{ui_button (t "access_page.cancel") "quiet" (kv "href" .Base)}}</div>
</form>
{{end}}
{{if and .CanAdd (not (and .Form .Form.Open))}}<div class="ui-form-actions">{{ui_button (t "access_page.add") "secondary" (kv "href" (printf "%s?add=1#entry-codes" .Base))}}</div>{{end}}
{{end}}
{{guide_section_close}}

{{guide_section_open "guest-preview" (t "access_page.preview.title") ""}}
{{if .PreviewEmpty}}<p class="ui-sub">{{t "access_page.preview.empty"}}</p>{{else}}
<dl class="ui-facts">
{{range .Preview}}
<div>
  <dt>{{.Label}}</dt>
  <dd>{{if .Door}}{{t "access_page.preview.door_value"}}{{else}}<span class="ui-monospace" style="white-space:nowrap">{{.Masked}}</span>{{end}}</dd>
</div>
{{end}}
{{if .PreviewExternalHost}}
<div>
  <dt>{{t "access_page.preview.external_prefix"}}</dt>
  <dd>{{.PreviewExternalHost}} <a href="{{.GuideBase}}#external">{{t "access_page.preview.change"}}</a></dd>
</div>
{{end}}
</dl>
{{end}}
{{guide_section_close}}

{{if .HasLock}}
{{guide_section_open "door-code" (t "access_page.lock.title") ""}}
<p class="ui-sub">{{t "access_page.lock.line"}}</p>
{{guide_section_close}}
{{end}}
</div>
<script>
(function(){
  var sel=document.querySelector('#access-type select,[name=code_type]');
  var name=document.getElementById('access-custom-label');
  if(!sel||!name)return;
  var row=name.closest('.ui-field')||name.closest('div');
  function sync(){if(!row)return;row.style.display=sel.value==='other'?'':'none';}
  sel.addEventListener('change',sync);sync();
})();
</script>
{{end}}