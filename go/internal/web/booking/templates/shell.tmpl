{{- /* Port of App/app/templates/base.html for show_nav = false, v2 = false (brief 1540).
    Keep the markup and every ?v= value in step with that file. */ -}}
{{define "guest.head"}}{{end}}
{{define "guest.base" -}}
<!doctype html>
<html lang="{{.Lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f7f7f5">
  <meta name="csrf-token" content="">
  <title>{{.Title}}</title>
  {{if .Meta}}<meta name="description" content="{{.Meta}}">
{{end}}{{if .Canonical}}  <link rel="canonical" href="{{.Canonical}}">
{{end}}{{range .Alternates}}  <link rel="alternate" hreflang="{{.Code}}" href="{{.Href}}">
{{end}}
  <link rel="icon" type="image/png" sizes="64x64" href="/static/favicon.png?v=20261004a">
  <link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png?v=20261004a">
  <link rel="manifest" href="/manifest.webmanifest">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="UbyHost">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <link rel="preload" href="/static/fonts/Manrope-latin.woff2?v=20261101-0495" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" data-turbo-track="reload" href="/static/tokens.css?v=20261103-0920">
  <link rel="stylesheet" data-turbo-track="reload" href="/static/app.css?v=20261109-1200">
  <link rel="stylesheet" data-turbo-track="reload" href="/static/components.css?v=20261103-0930">
  <link rel="stylesheet" data-turbo-track="reload" href="/static/list-filter-compact.css?v=20261109-1052a">
  <link rel="stylesheet" data-turbo-track="reload" href="/static/skeleton.css?v=20261014-0102c">
  {{template "guest.head" .}}
  <script src="/static/csrf.js?v=20260915a" defer data-turbo-track="reload"></script>
  <script src="/static/skeleton.js?v=20261102-0509" defer data-turbo-track="reload"></script>
  <script src="/static/app.js?v=20261125-stays3" defer data-turbo-track="reload"></script>
  <noscript><link rel="stylesheet" href="/static/app-nojs.css?v=20261104-1210"></noscript>
</head>
<body class="layout-host  no-nav">
<a class="skip-link" href="#main-content">{{.T "a11y.skip_to_content"}}</a>
<main id="main-content" class="wrap  ">
  {{template "guest.content" .}}
  <div class="page-skeleton" data-page-skeleton role="status" hidden>
    <span class="sr-only">{{.T "a11y.loading"}}</span>
    {{fragment "skeleton_detail.html"}}
  </div>
</main>

<dialog id="confirm-dialog" class="admin-dialog">
  <form method="post" id="confirm-form" class="admin-dialog-form">
    <h2 id="confirm-title" style="margin-top:0"></h2>
    <p id="confirm-body" class="small muted"></p>
    <div class="actions">
      <button class="btn" type="button" data-confirm-cancel>{{.T "confirm.cancel"}}</button>
      <button class="btn primary" type="submit" data-confirm-proceed
              data-confirm-default-label="{{.T "confirm.proceed"}}"
              data-confirm-archive-label="{{.T "host.delete"}}">{{.T "confirm.proceed"}}</button>
    </div>
  </form>
</dialog>

<dialog id="unsaved-dialog" class="admin-dialog unsaved-dialog" aria-labelledby="unsaved-dialog-title">
  <div class="admin-dialog-form">
    <h2 id="unsaved-dialog-title" class="unsaved-dialog-title">{{.T "unsaved.title"}}</h2>
    <div class="actions unsaved-dialog-actions">
      <button class="btn" type="button" data-unsaved-stay>{{.T "unsaved.stay"}}</button>
      <button class="btn" type="button" data-unsaved-discard>{{.T "unsaved.discard"}}</button>
      <button class="btn primary" type="button" data-unsaved-save>{{.T "unsaved.save"}}</button>
    </div>
  </div>
</dialog>

<dialog id="csv-export-dialog" class="csv-export-dialog">
  <form id="csv-export-form">
    <h2 style="margin-top:0">{{.T "data.export_csv_title"}}</h2>
    <p class="small muted">{{.T "data.export_csv_help"}}</p>
    <p class="small csv-export-scope">{{.T "housebook.apartment"}}: <strong data-csv-scope-label>{{.T "host.filter.all_properties"}}</strong></p>
    <div class="grid two">
      <div class="field">
        <label for="csv_export_from">{{.T "common.from"}}</label>
        <input type="date" id="csv_export_from" name="from" required>
      </div>
      <div class="field">
        <label for="csv_export_to">{{.T "common.until"}}</label>
        <input type="date" id="csv_export_to" name="to" required>
      </div>
    </div>
    <div class="actions" style="margin-top:14px">
      <button class="btn" type="button" data-csv-cancel>{{.T "data.export_csv_cancel"}}</button>
      <button class="btn primary" type="submit">{{.T "data.export_csv_download"}}</button>
    </div>
  </form>
</dialog>
<dialog id="command-dialog" class="command-dialog" aria-labelledby="command-title">
  <div class="command-shell">
    <h2 id="command-title" class="sr-only">{{.T "command.open"}}</h2>
    <div class="command-search">
      <span aria-hidden="true">{{icon "search" 18}}</span>
      <input type="search" data-command-input aria-label="{{.T "command.open"}}" placeholder="{{.T "command.open"}}" autocomplete="off">
      <button class="command-close" type="button" data-command-close aria-label="{{.T "shortcuts.close"}}">{{icon "x" 16}}</button>
    </div>
    <div class="command-results" data-command-results role="listbox" aria-live="polite"></div>
  </div>
</dialog>

<dialog id="shortcuts-dialog" class="shortcuts-dialog" aria-labelledby="shortcuts-title">
  <div class="shortcuts-shell">
    <div class="section-heading">
      <h2 id="shortcuts-title">{{.T "shortcuts.title"}}</h2>
      <button class="btn-icon" type="button" data-shortcuts-close aria-label="{{.T "shortcuts.close"}}">{{icon "x" 16}}</button>
    </div>
    <dl class="shortcut-list">
      <div><dt><kbd>g</kbd> <kbd>d</kbd></dt><dd>{{.T "shortcuts.dashboard"}}</dd></div>
      <div><dt><kbd>g</kbd> <kbd>s</kbd></dt><dd>{{.T "shortcuts.stays"}}</dd></div>
      <div><dt><kbd>g</kbd> <kbd>r</kbd></dt><dd>{{.T "shortcuts.reports"}}</dd></div>
      <div><dt><kbd>g</kbd> <kbd>h</kbd></dt><dd>{{.T "shortcuts.housebook"}}</dd></div>
      <div><dt><kbd>⌘/Ctrl</kbd> <kbd>K</kbd></dt><dd>{{.T "shortcuts.search"}}</dd></div>
      <div><dt><kbd>j</kbd> / <kbd>k</kbd></dt><dd>{{.T "shortcuts.next"}} / {{.T "shortcuts.previous"}}</dd></div>
      <div><dt><kbd>Enter</kbd></dt><dd>{{.T "shortcuts.open_row"}}</dd></div>
    </dl>
  </div>
</dialog>
</body>
</html>
{{end}}
