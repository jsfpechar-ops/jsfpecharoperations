{{define "property_page_review"}}
<div class="ui-section">
  <h2>{{t "payments.page.title"}} — {{.ApartmentName}}</h2>
  <p>
    {{if .Published}}
    <span class="ui-badge ui-badge-done" data-tone="green">{{t "payments.page.live"}}</span>
    <code>/p/{{.Slug}}</code>
    <form method="post" action="/apartments/{{.ApartmentID}}/page" style="display:inline">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit" name="unpublish" value="1">{{t "payments.page.unpublish_btn"}}</button>
    </form>
    {{else}}
    <span class="ui-badge ui-badge-neutral" data-tone="grey">{{t "payments.page.off"}}</span>
    <code>/p/{{.Slug}}</code>
    <form method="post" action="/apartments/{{.ApartmentID}}/page" style="display:inline">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <button class="ui-btn ui-btn-primary ui-btn-compact" type="submit" name="publish" value="1">{{t "payments.page.publish_btn"}}</button>
    </form>
    {{end}}
    {{if .Published}}<a class="ui-btn ui-btn-secondary ui-btn-compact" href="/p/{{.Slug}}" target="_blank">{{t "payments.page.preview"}}</a>{{end}}
    <a class="ui-btn ui-btn-secondary ui-btn-compact" href="/apartments/{{.ApartmentID}}/booking-site">{{t "bsite.title"}}</a>
  </p>
  {{if .Published}}
  <form method="post" action="/apartments/{{.ApartmentID}}/page" class="ui-form">
    <label class="ui-field">
      <input type="checkbox" name="hide_from_search" value="1"{{if .HideFromSearch}} checked{{end}}>
      {{t "payments.page.hide_search"}}
    </label>
    <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit" name="search_save" value="1">{{t "common.save"}}</button>
    <input type="hidden" name="_csrf" value="{{csrf}}">
  </form>
  {{end}}
</div>
<form method="post" action="/apartments/{{.ApartmentID}}/page" class="ui-form">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <div class="ui-section">
    <label class="ui-field">
      <span>{{t "payments.page.description"}}</span>
      <textarea class="ui-input" name="description" rows="8">{{.Description}}</textarea>
    </label>
    <label class="ui-field">
      <span>{{t "payments.page.amenities"}}</span>
      <textarea class="ui-input" name="amenities" rows="6">{{.AmenitiesText}}</textarea>
    </label>
    <label class="ui-field">
      <span>{{t "pp.rules"}}</span>
      <textarea class="ui-input" name="house_rules" rows="6">{{.HouseRules}}</textarea>
    </label>
    <button class="ui-btn ui-btn-primary" type="submit">{{t "common.save"}}</button>
  </div>
</form>
<div class="ui-section">
  <h3>{{t "payments.page.photos"}}</h3>
  <p class="ui-sub">{{t "payments.page.photos_notice"}}</p>
  {{if .Photos}}
  <div class="pp-photo-grid">
    {{range $i, $p := .Photos}}
    {{$first := eq $i 0}}{{$last := eq $i (sub (len $.Photos) 1)}}
    <div class="pp-photo-tile">
      <img src="{{$p}}" alt="{{t "payments.page.photo_alt"}} {{add $i 1}}" width="120" height="90">
      <form method="post" action="/apartments/{{$.ApartmentID}}/page/photo-delete" data-confirm data-confirm-message="{{t "payments.page.photo_delete_confirm"}}" class="pp-photo-del">
        <input type="hidden" name="_csrf" value="{{csrf}}">
        <input type="hidden" name="path" value="{{$p}}">
        <button class="ui-btn ui-btn-secondary ui-btn-compact" type="submit" aria-label="{{t "payments.page.photo_delete"}}">{{icon "x" 16}}</button>
      </form>
      <div class="pp-photo-moves">
        <form method="post" action="/apartments/{{$.ApartmentID}}/page/photo-move">
          <input type="hidden" name="_csrf" value="{{csrf}}">
          <input type="hidden" name="path" value="{{$p}}">
          <input type="hidden" name="dir" value="up">
          <button class="ui-btn ui-btn-secondary" type="submit" aria-label="{{t "payments.page.photo_up"}}"{{if $first}} disabled{{end}}>{{icon "arrow-up" 16}}</button>
        </form>
        <form method="post" action="/apartments/{{$.ApartmentID}}/page/photo-move">
          <input type="hidden" name="_csrf" value="{{csrf}}">
          <input type="hidden" name="path" value="{{$p}}">
          <input type="hidden" name="dir" value="down">
          <button class="ui-btn ui-btn-secondary" type="submit" aria-label="{{t "payments.page.photo_down"}}"{{if $last}} disabled{{end}}>{{icon "arrow-down" 16}}</button>
        </form>
      </div>
      {{if $first}}<p class="ui-sub pp-photo-main">{{t "payments.page.photo_main"}}</p>{{end}}
    </div>
    {{end}}
  </div>
  {{else}}
  <p class="ui-sub">{{t "payments.page.photos_empty"}}</p>
  {{end}}
</div>
{{end}}