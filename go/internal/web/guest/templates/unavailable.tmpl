{{define "content"}}
<div class="g-card">
  <div class="g-big-ok">
    <div class="mark neutral"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg></div>
    <h2>{{.T .TitleKey}}</h2>
    <p class="g-intro">{{.T .BodyKey}}</p>
    {{if .HostNote}}<p class="g-host-note" role="note" data-host-note>{{.HostNote}}</p>{{end}}
    {{if .StayURL}}
      <a class="g-btn" href="{{.StayURL}}" data-back-to-stay>{{.T "back_to_stay"}}</a>
    {{end}}
    {{if and .OfferMessageHost .HostMessageURL}}
      <a class="g-btn ghost" href="{{.HostMessageURL}}" data-message-host>{{.T "message_host"}}</a>
    {{else if .StayURL}}
      <a class="g-btn ghost" href="#host-contact" data-contact-host>{{.T "contact_host_jump"}}</a>
    {{end}}
    {{if .RestartURL}}
      <a class="g-btn ghost" href="{{.RestartURL}}">{{.T "start_over"}}</a>
    {{end}}
  </div>
</div>
{{end}}
