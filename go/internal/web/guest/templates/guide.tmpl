{{define "title"}}{{.T "guide_title"}}{{end}}
{{define "heading"}}{{.T "guide_title"}}{{end}}
{{define "foot"}}{{if eq .Door "qr"}}<p>{{.T "guide_qr_foot"}}</p>{{else}}<p>{{.T "privacy"}}</p>
    <p>{{.T "privacy_first_line"}}</p>
    {{if .PrivacyURL}}<p><a href="{{.PrivacyURL}}">{{.T "privacy_link"}}</a></p>{{end}}{{end}}{{end}}
{{define "content"}}
{{if .BackURL}}
  <a class="g-back" href="{{.BackURL}}">{{.T "guide_back_to_stay"}}</a>
{{end}}

{{if .NotReady}}
  <div class="g-card" data-guide-not-ready>
    <h2>{{.T "guide_not_ready_title"}}</h2>
    <p class="g-intro" style="margin-bottom:0">{{.T "guide_not_ready_help"}}</p>
  </div>
{{else}}
  {{if and (eq .Door "stay") (eq .Level "everyone")}}
    <p class="g-intro" data-guide-window-note>{{.T "guide_more_from_arrival"}}</p>
  {{end}}
  {{if .LeonURL}}<a class="g-leon-jump" href="#leon" data-leon-jump hidden>{{.T "leon_ask"}}</a>{{end}}
  {{if .Translating}}<p class="g-intro" data-guide-translating>{{.T "guide_translating"}}</p>{{end}}
  {{if not .Groups}}
    <div class="g-card" data-guide-empty>
      <p class="g-intro" style="margin-bottom:0">{{.T "guide_empty"}}</p>
    </div>
  {{end}}
  {{range .Groups}}
    {{if .Title}}<p class="g-question-kicker" data-guide-topic>{{.Title}}</p>{{end}}
    {{range .Cards}}
      <div class="g-card g-guide-card" data-guide-card="{{.ID}}" id="card-{{.ID}}" data-guide-kind="{{.Kind}}">
        <h2>{{.Title}}</h2>
        {{if .Facts}}<p>{{.Facts}}</p>{{end}}
        {{if .Location}}<p class="g-guide-where"><span>{{$.T "guide_where"}}</span> {{.Location}}</p>{{end}}
        {{if .Steps}}
          <ol class="g-guide-steps">
            {{range .Steps}}<li>{{.}}</li>{{end}}
          </ol>
        {{end}}
        {{if .WatchOut}}
          <div class="g-guide-warn" role="note"><strong>{{$.T "guide_watch_out"}}</strong> {{.WatchOut}}</div>
        {{end}}
        {{if .Photos}}
          <div class="g-guide-photos">
            {{range $i, $url := .Photos}}
              <a href="{{$url}}"><img src="{{$url}}" alt="{{$.T "guide_photo_alt" "n" $i}}" loading="lazy"></a>
            {{end}}
          </div>
        {{end}}
        {{if .VideoURL}}
          <p class="g-guide-video"><a href="{{.VideoURL}}" rel="noopener noreferrer" target="_blank">{{$.T "guide_video"}}</a></p>
        {{end}}
      </div>
    {{end}}
  {{end}}
  {{if .LeonURL}}{{template "leon" .}}{{end}}
{{end}}
{{end}}
{{define "leon"}}<section class="g-card g-leon" id="leon" aria-labelledby="leon-title" data-leon
  data-leon-url="{{.LeonURL}}"
  data-label-leon="{{.T "leon_name"}}"
  data-label-you="{{.T "leon_you"}}"
  data-label-host="{{if .LeonHost}}{{.T "leon_host_answered" "host" .LeonHost}}{{else}}{{.T "leon_host_answered_plain"}}{{end}}"
  data-text-send="{{.T "leon_send"}}"
  data-text-sending="{{.T "leon_sending"}}"
  data-text-other="{{.T "leon_sit_other"}}"
  data-text-other-prompt="{{.T "leon_other_prompt"}}"
  data-text-error="{{.T "leon_error"}}"
  data-text-reload="{{.T "leon_error_reload"}}"
  data-text-queued="{{.T "leon_queued"}}"
  data-text-see-card="{{.T "leon_see_card"}}"
  data-text-welcome="{{.T "leon_welcome"}}">
  <div class="g-leon-head">
    <span class="g-leon-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg></span>
    <div class="g-leon-head-text"><h2 id="leon-title">{{.T "leon_name"}} <span class="g-leon-tag">{{.T "leon_tag"}}</span></h2><p class="g-leon-role">{{.T "leon_role"}}</p></div>
  </div>
  <p class="g-intro">{{.T "leon_intro"}}</p>
  <noscript><p class="g-leon-nojs" data-leon-nojs>{{.T "leon_needs_js"}}</p></noscript>
  <ul hidden data-leon-situations>
    <li data-key="cant_get_in" data-kinds="keys checkin">{{.T "leon_sit_cant_get_in"}}</li>
    <li data-key="cold" data-kinds="heating hot_water air_conditioning">{{.T "leon_sit_cold"}}</li>
    <li data-key="broken" data-kinds="something_wrong">{{.T "leon_sit_broken"}}</li>
    <li data-key="parking" data-kinds="parking garage">{{.T "leon_sit_parking"}}</li>
    <li data-key="trash" data-kinds="trash">{{.T "leon_sit_trash"}}</li>
    <li data-key="checkout" data-kinds="checkout">{{.T "leon_sit_checkout"}}</li>
    <li data-key="emergency" data-kinds="emergency" data-help="{{.T "leon_sit_emergency_help"}}">{{.T "leon_sit_emergency"}}</li>
  </ul>
  <div class="g-leon-log" role="log" aria-live="polite" aria-labelledby="leon-title" data-leon-log hidden></div>
  <p class="g-leon-waiting" role="status" data-leon-waiting hidden>{{.T "leon_waiting"}}</p>
  <form class="g-leon-form" method="post" action="{{.LeonURL}}" data-leon-form hidden>
    <input type="hidden" name="_csrf" value="{{.CSRFToken}}">
    <label class="g-leon-label g-sr-only" for="leon-message">{{.T "leon_label"}}</label>
    <div class="g-leon-pill">
      <textarea id="leon-message" name="message" rows="1" maxlength="500"
        placeholder="{{.T "leon_placeholder"}}" data-leon-input></textarea>
      <button type="submit" class="g-leon-send" data-leon-send aria-label="{{.T "leon_send"}}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m5 12 7-7 7 7"/><path d="M12 19V5"/></svg></button>
    </div>
    <span class="g-leon-count" aria-hidden="true" data-leon-count hidden>0 / 500</span>
    <p class="g-leon-error" role="alert" data-leon-error hidden></p>
  </form>
</section>{{end}}
