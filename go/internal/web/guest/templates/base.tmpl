{{define "guest.base"}}
<!doctype html>
<html lang="{{.Lang}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  {{if .CSRFToken}}<meta name="csrf-token" content="{{.CSRFToken}}">{{end}}
  <meta name="theme-color" content="#f7f7f5">
  <title>{{block "title" .}}{{.T "title"}}{{end}}</title>
  <link rel="icon" type="image/png" sizes="64x64" href="/static/favicon.png?v=20261125-logo">
  <link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png?v=20261125-logo">
  <link rel="stylesheet" href="/static/tokens.css?v=20261022-0284">
  <link rel="stylesheet" href="/static/guest.css?v=20261111-1098a">
  <link rel="stylesheet" href="/static/skeleton.css?v=20261014-0102c">
  <link rel="stylesheet" href="/static/guest-elderly.css?v=20261127-elderly3">
</head>
<body>
<a class="skip-link" href="#g-main">{{.T "skip_to_form"}}</a>
<div class="g-wrap {{block "wrap_class" .}}{{end}}">
  <div class="g-head">
    <div class="g-title g-property">
      {{if .Facility}}<span class="g-property-mark property-tone-{{.FacilityTone}}" aria-hidden="true">{{facilityMark .Facility}}</span>{{end}}
      <div>
        <h1>{{block "heading" .}}{{.T "title"}}{{end}}</h1>
        {{if .Facility}}<p class="g-facility">{{.Facility}}</p>{{end}}
      </div>
    </div>
    {{if .LangURLs}}
    {{if .LangRelangURL}}
    <button type="submit" form="guest-form" class="g-sr-only" tabindex="-1" aria-hidden="true" data-guest-default-submit></button>
    {{end}}
    <details class="g-lang" data-lang-menu>
      <summary aria-label="{{.T "language_label"}}: {{index .GuestEndonyms .Lang}}"><span aria-hidden="true">{{upper .Lang}}</span></summary>
      <div class="g-lang-list" role="group" aria-label="{{.T "language_label"}}">
        {{range $code := langOrder .LangURLs}}{{$url := index $.LangURLs $code}}
        {{if $.LangRelangURL}}
        <button type="submit" form="guest-form" formaction="{{$.LangRelangURL}}?lang={{$code}}" formnovalidate data-lang-draft class="{{if eq $.Lang $code}}on{{end}}"{{if eq $.Lang $code}} aria-current="true"{{end}} lang="{{$code}}">{{index $.GuestEndonyms $code}}</button>
        {{else}}
        <a href="{{$url}}" class="{{if eq $.Lang $code}}on{{end}}"{{if eq $.Lang $code}} aria-current="true"{{end}} hreflang="{{$code}}" lang="{{$code}}">{{index $.GuestEndonyms $code}}</a>
        {{end}}
        {{end}}
      </div>
    </details>
    {{end}}
  </div>

  {{if .Flash}}<div class="g-ok">{{.Flash}}</div>{{end}}
  {{if .FlashError}}<div class="g-err">{{.FlashError}}</div>{{end}}

  <main id="g-main">
    {{block "content" .}}{{end}}
    {{template "host.fragment" .}}
    <div class="g-page-skeleton" data-page-skeleton role="status" hidden>
      <span class="g-sr-only">{{.T "loading"}}</span>
      <div class="c05-skel" aria-hidden="true">
        <div class="c05-skel__row"><span class="c05-skel__bone c05-skel__avatar"></span><div class="c05-skel__lines"><span class="c05-skel__bone c05-skel__line"></span><span class="c05-skel__bone c05-skel__line c05-skel__line--sm"></span></div></div>
        <span class="c05-skel__bone c05-skel__block c05-skel__block--w95"></span>
        <span class="c05-skel__bone c05-skel__block c05-skel__block--w80"></span>
        <span class="c05-skel__bone c05-skel__block c05-skel__block--w60"></span>
      </div>
    </div>
  </main>

  <div class="g-foot">
    {{block "foot" .}}
    <p>{{.T "privacy"}}</p>
    <p>{{.T "privacy_first_line"}}</p>
    {{if .PrivacyURL}}<p><a href="{{.PrivacyURL}}">{{.T "privacy_link"}}</a></p>{{end}}
    {{end}}
  </div>
</div>
<script src="/static/skeleton.js?v=20261102-0509"></script>
{{if .LoadSignatureJS}}<script src="/static/signature.js?v=20261113-inpass"></script>{{end}}
<script src="/static/guest-enhancements.js?v=20261109-1063a"></script>
<script src="/static/guest-elderly.js?v=20261127-elderly3"></script>
<script src="/static/csrf.js?v=20260915a"></script>
{{if .LeonURL}}<script src="/static/guest-leon.js?v=20261025-0393b"></script>{{end}}
</body>
</html>
{{end}}