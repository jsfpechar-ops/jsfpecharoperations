{{/* Port of App/app/templates/guide.html (brief 1301). range(a, b) is slice $.N (a-1) (b-1). */}}
{{define "guide.title"}}{{end}}
{{define "guide"}}{{$N := .N}}
<div class="head guide-head"><div><div class="heading-with-tip"><h1 class="big">{{t "guide.title"}}{{help_tip "guide-lede-help" (t "guide.lede")}}</h1></div></div></div>
{{if .Havel}}<form method="post" action="/havel" class="guide-ask" data-havel-guide-ask>
  <input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="page" value="guide"><input type="hidden" name="return_to" value="/guide">
  <label class="sr-only" for="guide-ask-q">{{t "guide.ask.label"}}</label>
  <input class="ui-input" id="guide-ask-q" name="message" type="text" maxlength="600" required placeholder="{{t "guide.ask.placeholder"}}" autocomplete="off">
  <button class="ui-btn ui-btn-primary" type="submit">{{t "nav.ask_havel"}}</button>
</form>{{end}}
<div class="guide-layout">
  <nav class="guide-nav card" aria-label="{{t "guide.title"}}">
    {{range .Sections}}<a href="#{{.}}" class="guide-nav-link">{{t (printf "guide.nav.%s" .)}}</a>{{end}}
  </nav>

  <div class="guide-content">
    <input type="search" class="guide-search" id="guide-search" hidden placeholder="{{t "guide.search.placeholder"}}" aria-label="{{t "guide.search.placeholder"}}" autocomplete="off">
    <p class="guide-search-empty ui-sub" hidden>{{t "guide.search.empty"}}{{if .Havel}} <a href="/havel" data-sheet-open="havel-sheet" data-havel-launcher>{{t "guide.search.ask"}}</a>{{end}}</p>
    <details class="guide-section card ui-section ui-section-plain guide-topic" id="finding">
      <summary><h2>{{t "guide.nav.finding"}}</h2></summary>
      <p>{{t "guide.finding.what"}}</p>
      <p class="ui-sub">{{t "guide.finding.when"}}</p>
      {{range $part := .FindingParts}}
      <h3>{{t (printf "guide.finding.%s_title" $part)}}</h3>
      <ul class="guide-steps">{{range slice $N 0 3}}<li>{{t (printf "guide.finding.%s%d" $part .)}}</li>{{end}}</ul>
      {{end}}
      <h3>{{t "guide.finding.pages_title"}}</h3>
      <p>{{t "guide.finding.tabs"}}</p><p>{{t "guide.finding.property"}}</p><p>{{t "guide.finding.how"}}</p><p>{{t "guide.finding.search"}}</p>
      <h3>{{t "guide.wrong_title"}}</h3>
      <ul>{{range slice $N 0 2}}<li>{{t (printf "guide.finding.wrong%d" .)}}</li>{{end}}</ul>
    </details>

    <details class="guide-section card ui-section ui-section-plain guide-topic" id="overview">
      <summary><h2>{{t "guide.nav.overview"}}</h2></summary>
      <section class="workflow-block" data-workflow-strip>
  <ol class="workflow-strip" aria-label="{{t "workflow.title"}}">
    {{range .Workflow}}
    <li class="workflow-strip-step{{if ne .Who "auto"}} is-you{{end}}" data-workflow-step="{{.Key}}">
      <span class="workflow-num" aria-hidden="true">{{.N}}</span>
      <span class="workflow-strip-copy">
        <span class="workflow-strip-label">{{t (printf "workflow.step.%s" .Key)}}</span>
        <span class="workflow-tag">{{t (printf "workflow.who.%s" .Who)}}</span>
      </span>
    </li>
    {{end}}
  </ol>
</section>
      <p>{{t "guide.overview.body"}}</p>
      <p>{{t "guide.overview.count"}}</p>
      <p>{{t "guide.overview.deadline"}}</p>
      <p>{{t "guide.overview.when"}}</p>
      <h3>{{t "guide.how_title"}}</h3>
      <ol class="guide-steps">{{range slice $N 0 4}}<li>{{t (printf "guide.overview.how%d" .)}}</li>{{end}}</ol>
      <h3>{{t "guide.wrong_title"}}</h3>
      <ul>{{range slice $N 0 3}}<li>{{t (printf "guide.overview.wrong%d" .)}}</li>{{end}}</ul>
    </details>

    <details class="guide-section card ui-section ui-section-plain guide-topic" id="statuses">
      <summary><h2>{{t "guide.nav.statuses"}}</h2></summary>
      <p>{{t "guide.statuses.lede"}}</p>
      <dl class="kv guide-statuses">
        {{range .Statuses}}
        <dt><span class="ui-badge ui-badge-{{if eq .Tone "green"}}done{{else}}action{{end}}" data-tone="{{.Tone}}">{{t .Label}}</span></dt>
        <dd>{{t .Body}}</dd>
        {{end}}
      </dl>
      <p class="ui-sub">{{t "guide.statuses.other"}}</p>
    </details>

    <details class="guide-section card ui-section ui-section-plain guide-topic" id="setup">
