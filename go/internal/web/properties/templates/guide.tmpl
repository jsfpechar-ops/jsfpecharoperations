      <ol class="guide-steps">{{range slice $N 0 5}}<li>{{t (printf "guide.business.how%d" .)}}</li>{{end}}</ol>
      <h3>{{t "guide.wrong_title"}}</h3>
      <ul>{{range slice $N 0 2}}<li>{{t (printf "guide.business.wrong%d" .)}}</li>{{end}}</ul>
