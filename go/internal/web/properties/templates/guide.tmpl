      <p>{{t "guide.setup.what"}}</p>
      <p class="ui-sub">{{t "guide.setup.when"}}</p>
      <h3 id="add-property">{{t "guide.setup.add_title"}}</h3>
      <ol class="guide-steps">{{range slice $N 0 6}}<li>{{t (printf "guide.setup.add%d" .)}}</li>{{end}}</ol>
      <h3 id="setup-guide">{{t "guide.setup.wizard_title"}}</h3>
      <ol class="guide-steps">{{range slice $N 0 5}}<li>{{t (printf "guide.setup.wizard%d" .)}}</li>{{end}}</ol>
      <h3>{{t "guide.wrong_title"}}</h3>
      <ul>{{range slice $N 0 3}}<li>{{t (printf "guide.setup.wrong%d" .)}}</li>{{end}}</ul>
      <h3>{{t "guide.setup.fields_title"}}</h3>
      <ol class="guide-steps">
        {{range slice $N 0 5}}
        <li><strong>{{t (printf "guide.setup.step%d_title" .)}}:</strong> {{t (printf "guide.setup.step%d" .)}}</li>
        {{end}}
      </ol>
    </details>

