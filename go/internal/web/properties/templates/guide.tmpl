      <p class="ui-sub">{{t "apartment.form.ubyport.intro"}}</p>
      <p class="ui-sub">
        <a class="ui-btn ui-btn-secondary ui-btn-compact" href="/static/docs/ubyport-ws-credential-sample.pdf?v=20261004a" target="_blank" rel="noopener">
          {{t "automation.sample_pdf"}}</a>
        <span class="ui-sub">{{t "apartment.form.ubyport.sample_help"}}</span>
      </p>
      <p class="ui-sub">{{t "apartment.form.ubyport.mismatch_help"}}</p>
    </details>

