{{define "apartmentdetail.calendars"}}
{{$a := .A}}
{{$connectOpen := or (not .Feeds) .JustCreated .AddCalendar}}
<div class="property-view-head">
  <div class="field-label-row"><h2 id="calendars">{{t "apartments.table.calendars"}}</h2>{{help_tip "calendars-help" (t "apartment.form.calendars.lede")}}</div>
  <div class="actions">
    {{if .Feeds}}<a class="ui-btn ui-btn-secondary ui-btn-compact" href="{{.Base}}?view=bookings&amp;add_calendar=1#calendar-connect" data-calendar-add>{{t "property_nav.add_calendar"}}</a>{{end}}
    {{if not .JustCreated}}<a class="ui-btn ui-btn-quiet ui-btn-compact" href="/reservations?new=1&amp;apartment={{$a.ID}}#add-stay-panel">{{t "property_create.created_manual"}}</a>{{end}}
    {{if .Feeds}}{{sync_calendars_button (print .Base "?view=bookings")}}{{end}}
  </div>
</div>

<div class="property-bookings{{if not $connectOpen}} is-list-only{{end}}">
  <div class="property-feeds">
    {{if .Feeds}}
    <div class="panel tight scroll-x">
      <table class="table-cards feed-table">
        <thead><tr><th>{{t "apartment.form.feed.name"}}</th><th>{{t "apartment.form.feed.portal"}}</th><th>{{t "apartment.form.feed.last_sync"}}</th><th>{{t "apartment.form.feed.url"}}</th><th></th></tr></thead>
        <tbody>
        {{range .Feeds}}
          <tr>
            <td data-label="{{t "apartment.form.feed.name"}}"><strong>{{.DisplayName}}</strong></td>
            <td data-label="{{t "apartment.form.feed.portal"}}">{{source_badge .PlatformKey .DisplayPortal}}</td>
            <td class="nowrap" data-label="{{t "apartment.form.feed.last_sync"}}">
              {{if eq .LastStatus "ok"}}<span class="ui-badge ui-badge-done" data-tone="green">{{t "apartment.form.feed.status.ok"}}</span>
              {{else if eq .LastStatus "suspect"}}<span class="ui-badge ui-badge-action" data-tone="amber">{{t "apartment.form.feed.status.suspect"}}</span>
              {{else if eq .LastStatus "error"}}<span class="ui-badge ui-badge-action" data-tone="red">{{t "apartment.form.feed.status.error"}}</span>
              {{else}}<span class="ui-badge ui-badge-neutral" data-tone="grey">{{t "apartment.form.feed.status.never"}}</span>{{end}}
              {{if .Checked}}<div class="ui-sub">{{datetime_local .Checked}}</div>{{end}}
              {{if .LastError}}<div class="small err-text">{{.LastError}}</div>{{end}}
            </td>
            <td class="small feed-url" data-label="{{t "apartment.form.feed.url"}}">
              <div class="feed-url-row"><span class="mono feed-url-value" id="feed-url-{{.ID}}" title="{{.URL}}">{{.URL}}</span>{{copy_button (print "feed-url-" .ID) (t "common.copy_link")}}</div>
            </td>
            <td class="row-actions" data-label="">
              <form method="post" action="/feeds/{{.ID}}/delete" class="inline"
                    data-confirm data-confirm-message="{{t "confirm.disconnect_feed"}}">
                <input type="hidden" name="_csrf" value="{{csrf}}">
                <button class="ui-btn ui-btn-danger ui-btn-compact" type="submit">{{t "common.remove"}}</button>
              </form>
            </td>
          </tr>
        {{end}}
        </tbody>
      </table>
    </div>
    {{else}}
      <div class="panel empty">{{t "apartment.form.calendars.empty"}}</div>
    {{end}}
  </div>

  <div class="calendar-connect{{if not $connectOpen}} is-collapsed{{end}}" id="calendar-connect" data-calendar-connect>
  <form method="post" action="{{.Base}}/feeds" class="panel calendar-add-form" id="calendar-add">
    <input type="hidden" name="_csrf" value="{{csrf}}">
    <h2>{{t "apartment.form.calendars.connect_title"}}</h2>
    <div class="field">
      <label for="label">{{t "calendar.platform_label"}}<span class="req-star" aria-hidden="true">*</span></label>
      <select id="label" name="label" required>
        <option value="" disabled selected>{{t "calendar.choose_platform"}}</option>
        {{range .Platforms}}
        <option value="{{.Key}}">{{if .Name}}{{.Name}}{{else}}{{t "calendar.platform.other"}}{{end}}</option>
        {{end}}
      </select>
    </div>
    <div class="field calendar-other-platform">
      <label for="label_other">{{t "calendar.other_label"}}</label>
      <input type="text" id="label_other" name="label_other" maxlength="80" value="">
    </div>
    <div class="field">
      {{field_label "url" (t "apartment.form.calendars.url_label") (t "apartment.form.calendars.url_hint") false "/guide#stays" true}}
      <input type="url" id="url" name="url" required value=""
             placeholder="{{t "apartment.form.calendars.url_ph"}}" aria-describedby="url-help">
    </div>
    <div class="field">
      <label for="own_name">{{t "apartment.form.calendars.own_name_label"}} <span class="opt">{{t "common.optional"}}</span></label>
      <input type="text" id="own_name" name="own_name" maxlength="100" value=""
             placeholder="{{t "apartment.form.calendars.own_name_ph"}}">
    </div>
    <div class="actions"><button class="ui-btn ui-btn-primary" type="submit">{{t "property_nav.add_calendar"}}</button></div>
  </form>
  </div>
</div>
{{end}}

{{define "apartmentdetail.lock"}}
{{$a := .A}}{{$d := .Door}}
<details class="prop-sec" id="sec-lock"{{if index .Open "sec-lock"}} open{{end}}><summary><span class="dot {{if and $d (eq $d.State "on")}}g{{else}}n{{end}}" aria-hidden="true"></span><div><b>{{t "property_page.sec.lock.title"}}</b></div>{{template "apartmentdetail.state" (kv "key" "lock" "root" $ "text" .LockState)}}</summary>
  <div class="fields-wrap">
  {{template "apartmentdetail.notice" (kv "root" $ "section" "lock")}}
  {{if and $d (or (eq $d.State "offline") (eq $d.State "times"))}}<div class="prop-sec-missing" data-missing="lock" role="note"><p>{{if eq $d.State "offline"}}{{t "health.door.offline"}} {{t "smart_locks.offline_fix"}}{{else}}{{t "health.door.times"}}{{end}}</p></div>{{end}}
    <p class="property-group-intro">{{t "why.door_lock"}}</p>
    {{if and $d $d.Account $d.Locks}}
    <div class="lock-state" id="lock-connected-off" data-state="{{$d.State}}" role="status">
      <i class="sd" aria-hidden="true"></i>
      <div class="lock-state-text"><b>{{t $d.StateKey}}</b>
        {{if eq $d.State "on"}}<small>{{t "smart_locks.online"}}</small>
        {{else if eq $d.State "offline"}}{{if ne $d.Account.Status "ok"}}<small>{{t "smart_locks.reauth"}}</small>{{end}}<small><a class="ui-btn ui-btn-quiet ui-btn-compact" href="/guide#door-codes">{{t "smart_locks.guide_link"}}</a></small>
        {{else if eq $d.State "times"}}<small>{{t "smart_locks.times_required"}}</small>{{end}}</div>
      <form method="post" action="/apartments/{{$a.ID}}/door-codes" class="lock-state-form">
        <input type="hidden" name="_csrf" value="{{csrf}}">
        <input type="hidden" name="return_to" value="/apartments/{{$a.ID}}?view=settings&amp;section=lock#sec-lock">
        <input type="hidden" name="mode" value="{{if eq $d.State "off"}}on{{else}}off{{end}}">
        <button class="ui-btn {{if eq $d.State "off"}}ui-btn-primary{{else}}ui-btn-secondary{{end}}" type="submit">{{if eq $d.State "off"}}{{t "smart_locks.turn_on"}}{{else}}{{t "smart_locks.turn_off"}}{{end}}</button>
      </form>
    </div>
    {{else if $d}}
    <div class="lock-state" id="lock-setup-state" data-state="{{$d.State}}" role="status">
      <i class="sd" aria-hidden="true"></i>
      <div class="lock-state-text"><b>{{t $d.StateKey}}</b>
        <small>{{t "apartment.form.door_code.connect_first"}}</small>{{if eq $d.State "offline"}}<small><a class="ui-btn ui-btn-quiet ui-btn-compact" href="/guide#door-codes">{{t "smart_locks.guide_link"}}</a></small>{{end}}</div>
    </div>
    {{end}}
    {{if $d}}
    {{template "apartmentdetail.doorwindow" .Window}}
    {{if and $d.Account $d.Locks}}
    <section class="panel property-section ui-section" id="door-code">
      <p class="ui-sub">{{t "why.times"}}</p>
      {{if .LockTimesError}}<p class="err-text" id="door-code-times-error" role="alert" data-field-error>{{t "why.times_missing"}}</p>{{end}}
      {{if and (not .LockTimesError) (eq $d.State "off") (or (not $a.CheckinHour) (not $a.CheckoutHour))}}<p class="err-text" id="lock-times-required" role="note">{{t "smart_locks.times_required"}}</p>{{end}}
      <div class="grid two" data-lock-times>
        <div class="field"><label for="lock_checkin_hour">{{t "apartment.form.door_code.checkin"}}<span class="req-star" aria-hidden="true">*</span></label>
          <select form="property-settings-form" id="lock_checkin_hour" name="lock_checkin_hour" data-hour-twin="checkin_hour"{{if $d.Enabled}} required{{end}}{{if .LockTimesError}} aria-invalid="true" aria-describedby="door-code-times-error"{{end}}><option value="">{{t "apartment.form.door_code.choose"}}</option>
            {{range $.Hours}}<option value="{{.}}"{{if $.HourSelected "checkin_hour" .}} selected{{end}}>{{printf "%02d:00" .}}</option>{{end}}
          </select></div>
        <div class="field"><label for="lock_checkout_hour">{{t "apartment.form.door_code.checkout"}}<span class="req-star" aria-hidden="true">*</span></label>
          <select form="property-settings-form" id="lock_checkout_hour" name="lock_checkout_hour" data-hour-twin="checkout_hour"{{if $d.Enabled}} required{{end}}{{if .LockTimesError}} aria-invalid="true" aria-describedby="door-code-times-error"{{end}}><option value="">{{t "apartment.form.door_code.choose"}}</option>
            {{range $.Hours}}<option value="{{.}}"{{if $.HourSelected "checkout_hour" .}} selected{{end}}>{{printf "%02d:00" .}}</option>{{end}}
          </select></div>
      </div>
      <div class="field-label-row"><h2 class="property-section-title">{{t "host.door_code"}}{{help_tip "door-code-help" (print (t "apartment.form.door_code.lede") " " (t "apartment.form.door_code.manual")) "/guide#door-codes"}}</h2></div>
        {{if $d.TestMode}}<p class="ui-sub"><strong>{{t "apartment.form.door_code.test_mode"}}</strong></p>{{end}}
        <div class="field" style="max-width:320px"><label for="lock_id">{{t "apartment.form.door_code.lock"}}</label>
          <select form="property-settings-form" id="lock_id" name="lock_id"><option value="">{{t "apartment.form.door_code.choose"}}</option>
            {{range $d.Locks}}<option value="{{.LockID}}"{{if and .UsedBy (ne .LockID $d.LockID)}} disabled{{end}}{{if or (eq .LockID $d.LockID) (and (not $d.LockID) (eq .LockID $d.DefaultLockID))}} selected{{end}}>{{.Alias}} ({{t "smart_locks.lock_id" "id" .LockID}}){{if .UsedBy}} · {{t "apartment.form.door_code.in_use" "property" .UsedBy}}{{end}}</option>{{end}}
          </select>
          {{if $d.TZWarning}}<div class="hint"><strong>{{t "smart_locks.timezone_warning"}}</strong></div>{{end}}
        </div>

        <p class="ui-sub">{{t "apartment.form.door_code.first_use"}}</p>
        {{if $d.Overlap}}<p class="ui-sub"><strong>{{t "apartment.form.door_code.overlap"}}</strong></p>{{end}}
    </section>
    {{end}}
    <input form="property-settings-form" type="hidden" name="door_code_section" value="1">
    {{else}}
    <p class="ui-sub">{{t "smart_locks.lede"}}</p>
    <div class="lock-state" id="lock-unavailable" data-state="off" role="status">
      <i class="sd" aria-hidden="true"></i>
      <div class="lock-state-text"><b>{{t "smart_locks.state_off"}}</b><small>{{t "wizard.door_lock.unavailable"}}</small></div>
    </div>
    {{end}}
    {{if $d}}
  <section class="panel property-section ui-section" id="{{if and $d.Account $d.Locks}}smart-locks{{else}}door-code{{end}}">
    {{if not (and $d.Account $d.Locks)}}
    <h2 class="property-section-title sr-only">{{t "smart_locks.title"}}</h2>
    <p class="ui-sub">{{t "smart_locks.lede"}}</p>
    {{end}}
    {{template "apartmentdetail.locks" .}}
  </section>
    {{end}}
  </div>
</details>
{{end}}

{{define "apartmentdetail.lockshare"}}
  <h2>{{t "smart_locks.share_title"}}</h2>
  <p><strong>{{t "smart_locks.name_label"}}</strong></p>
  <p><code id="{{.id}}">{{.receiver}}</code> {{copy_button .id}}</p>
  <h3 class="smart-locks-steps-title">{{t "smart_locks.steps_title"}}
    {{help_tip (print "smart-locks-steps-help-" .section) (t "smart_locks.steps_help") "/guide#door-codes-share"}}</h3>
  <ol class="guide-steps"><li>{{t "smart_locks.essential1"}}</li><li>{{t "smart_locks.essential2"}}</li><li>{{t "smart_locks.essential3"}}</li></ol>
  <p class="ui-sub">{{t "smart_locks.warn_owner"}}</p>
  <p class="ui-sub"><strong>{{t "smart_locks.warn_ekey"}}</strong></p>
  <form method="post" action="/smart-locks/refresh"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="return_to" value="{{.return_to}}">
    <input type="hidden" name="section" value="{{.section}}">
    <div class="action-group"><button class="{{if .primary}}ui-btn ui-btn-primary{{else}}ui-btn ui-btn-secondary{{end}}" type="submit">{{t "smart_locks.check"}}</button></div></form>
{{end}}

{{define "apartmentdetail.locks"}}
{{$d := .Door}}
{{if $d.Reauth}}<p class="ui-sub"><strong>{{t "smart_locks.reauth"}}</strong></p>{{end}}
{{if not $d.Account}}
<section class="ui-section" id="smart-locks-how">
  <h2>{{t "smart_locks.how_title"}}</h2>
  <ol class="guide-steps"><li>{{t "smart_locks.how1"}}</li><li>{{t "smart_locks.how2"}}</li><li>{{t "smart_locks.how3"}}</li></ol>
</section>
<section class="ui-section" id="smart-locks-setup">
  <h2 class="sr-only">{{t "smart_locks.setup_title"}}</h2>
  <form method="post" action="/smart-locks/setup">
    <input type="hidden" name="_csrf" value="{{csrf}}">
    <input type="hidden" name="return_to" value="{{$d.PanelReturn}}">
    <label class="checkline" for="terms"><input type="checkbox" id="terms" name="terms" value="1" required>
      <span>{{t "smart_locks.terms"}} <a href="/guide#door-codes-terms">{{t "smart_locks.terms_link"}}</a></span></label>
    <div class="action-group"><button class="ui-btn ui-btn-primary" type="submit">{{t "smart_locks.setup"}}</button></div>
  </form>
  <p class="ui-sub"><a href="/guide#door-codes">{{t "smart_locks.guide_link"}}</a></p>
</section>
{{else}}
{{if not $d.Locks}}
<section class="ui-section" id="smart-locks-share">
  {{template "apartmentdetail.lockshare" (kv "id" "ttlock-receiver" "section" "share" "receiver" $d.Account.Username "return_to" $d.PanelReturn "primary" true)}}
</section>
{{else}}
<details class="ui-section" id="smart-locks-add-more">
  <summary>{{t "smart_locks.add_more"}}</summary>
  {{template "apartmentdetail.lockshare" (kv "id" "ttlock-receiver-more" "section" "add-more" "receiver" $d.Account.Username "return_to" $d.PanelReturn "primary" false)}}
</details>
<section class="ui-section" id="smart-locks-list">
  {{range $d.Locks}}
  <div class="smart-lock-row ui-section ui-section-row">
    <p><strong>{{.Alias}}</strong> · {{t "smart_locks.lock_id" "id" .LockID}}
      {{if .Battery}} · {{t "smart_locks.battery" "percent" .Battery}}{{end}}</p>
    <p class="ui-sub">{{icon "check" 14}} {{t "smart_locks.connected"}}</p>
    <p class="ui-sub">{{if .Using}}{{join .Using ", "}}{{else}}{{t "smart_locks.unused"}}{{end}}</p>
    {{if gt (len .Using) 1}}<p class="ui-sub"><strong>{{t "smart_locks.shared_warning"}}</strong></p>{{end}}
    {{if .TZWrong}}
    <p class="ui-sub"><strong>{{t "smart_locks.timezone_warning"}}</strong></p>
    {{end}}
  </div>
  {{end}}
  <div class="action-group">
    <form method="post" action="/smart-locks/refresh" class="inline"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="return_to" value="{{$d.PanelReturn}}">
      <input type="hidden" name="section" value="list">
      <button class="ui-btn ui-btn-primary" type="submit">{{t "smart_locks.check"}}</button></form>
    <form method="post" action="/smart-locks/remove" class="inline" data-confirm data-confirm-message="{{t "smart_locks.remove_confirm"}}"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="return_to" value="{{$d.PanelReturn}}">
      <button class="ui-btn ui-btn-danger" type="submit">{{t "smart_locks.remove"}}</button></form>
  </div>
</section>
{{end}}
{{end}}
{{end}}
