{{/* Port of App/app/templates/apartment_form.html (edit branch), _property_editor.html, partials/settings_back_header.html,
     _copy_settings_dialog.html, _setup_ready_card.html, _section_notice.html, _door_code_window.html,
     _property_identity_fields.html, _property_operator.html, _property_address_fields.html, _police_fields.html,
     _police_letter_figure.html and _property_calendars.html. Brief 1701. Parts that come from POST re-renders in Python
     (save_errors, letter_read, letter_status, letter_prefill, operator_error, shared_time_error, lock_times_error,
     feed_draft, feed_errors, setup_guide, lock_times_error) are never set on a GET and are left out. The Stay fee section is
     the define apartmentdetail.fee (brief 1701b: _stay_fee_fields.html, _fee_signature_fields.html, _entity_business_fields.html signature_fields). */}}
{{define "apartmentdetail.title"}}{{end}}
{{define "apartmentdetail.back_label"}}{{end}}

{{define "apartmentdetail.notice"}}{{if eq .root.InlineFlashSection .section}}{{if .root.FlashError}}
  <div class="banner err section-notice" role="alert" tabindex="-1" data-section-notice><span class="grow">{{.root.FlashError}}</span></div>
  {{else if .root.FlashMsg}}
  <div class="banner ok section-notice" role="status" tabindex="-1" data-section-notice><span class="grow">{{.root.FlashMsg}}</span></div>
  {{end}}{{end}}{{end}}

{{define "apartmentdetail.state"}}<small class="sec-state">{{.text}}</small>{{end}}

{{define "apartmentdetail.missing"}}{{if .items}}<div class="prop-sec-missing" data-missing="{{.key}}" role="note"><ul class="readiness-list">{{range .items}}<li class="readiness-item"><a href="#{{.Anchor}}" data-fix-label="{{t (print "apartment.form.readiness.item." .Key)}}">{{t "apartment.form.readiness.missing"}} {{t (print "apartment.form.readiness.item." .Key)}}</a>{{if .Message}}<span class="readiness-why">{{.Message}}</span>{{end}}</li>{{end}}</ul></div>{{end}}{{end}}

{{define "apartmentdetail.copy"}}<a class="ui-btn ui-btn-secondary ui-btn-compact copy-settings-open" href="{{.Base}}?view=settings&amp;section={{.CopySection}}&amp;copy=choose" data-sheet-open="copy-settings">{{icon "copy" 16}}{{t "apartment.form.copy_from.open"}}</a>
<dialog id="copy-settings" class="ui-dialog copy-settings-dialog" aria-labelledby="copy-settings-title"{{if .CopyOpen}} open{{end}}>
  <div class="ui-sheet">
    <span class="ui-sheet-handle" aria-hidden="true"></span>
    <h2 id="copy-settings-title">{{t "apartment.form.copy_from.title"}}</h2>
    <form method="get" action="{{.Base}}" class="copy-property-form">
      <input type="hidden" name="view" value="settings">
      <input type="hidden" name="section" value="{{.CopySection}}">
      <div class="field">
        <label for="copy_from">{{t "apartment.form.copy_from.source"}}</label>
        <select id="copy_from" name="copy_from">
          {{range .CopyPeers}}
          <option value="{{.ID}}"{{if eq $.CopyFromID .ID}} selected{{end}}>{{.Name}}</option>
          {{end}}
        </select>
      </div>
      <h3>{{t "apartment.form.copy_from.copied_head"}}</h3>
      <ul class="copy-settings-list">
        <li>{{t "apartment.form.copy_from.item_operator"}}</li>
        <li>{{t "apartment.form.copy_from.item_automation"}}</li>
        <li>{{t "apartment.form.copy_from.item_link"}}</li>
        <li>{{t "apartment.form.copy_from.item_fee"}}</li>
      </ul>
      <h3>{{t "apartment.form.copy_from.never_head"}}</h3>
      <p class="copy-settings-never">{{t "apartment.form.copy_from.never_body"}}</p>
      <p class="ui-sub">{{t "apartment.form.copy_from.empty_only"}}</p>
      <div class="copy-settings-actions">
        <button class="ui-btn ui-btn-primary" type="submit">{{t "apartment.form.copy_from.button"}}</button>
        <button class="ui-btn ui-btn-secondary" type="submit" formmethod="dialog" formnovalidate data-sheet-close>{{t "confirm.cancel"}}</button>
      </div>
    </form>
  </div>
</dialog>{{end}}

{{define "apartmentdetail.addr"}}
  <div class="field">
    {{if .HintKey}}{{field_label .Name (t .LabelKey) (t .HintKey) .Optional "" .Required}}{{else}}{{field_label .Name (t .LabelKey) "" .Optional "" .Required}}{{end}}
    <input type="text" id="{{.Name}}" name="{{.Name}}" autocomplete="off" value="{{.Value}}"{{if .MaxLength}} maxlength="{{.MaxLength}}"{{end}}{{if .InputMode}} inputmode="{{.InputMode}}"{{end}}{{if .Autocap}} autocapitalize="{{.Autocap}}"{{end}}{{if .Placeholder}} placeholder="{{.Placeholder}}"{{end}}{{if .Required}} required aria-required="true"{{end}}{{if .Described}} aria-describedby="{{.Described}}"{{end}}{{if .Error}} aria-invalid="true"{{end}}{{if .Suggest}} data-ruian-suggest data-ruian-loading="{{t "apartment.form.addr.suggest_loading"}}" data-ruian-none="{{t "apartment.form.addr.suggest_none"}}"{{end}}>
    {{if .Error}}<p class="err-text" id="{{.Name}}-error" role="alert">{{.Error}}</p>{{end}}
  </div>
{{end}}

{{define "apartmentdetail.doorwindow"}}<div data-door-code-window data-buffer="{{.Buffer}}"
     data-checkin="{{.Checkin}}" data-checkout="{{.Checkout}}"
     data-arrival="{{t "door_code.window.arrival"}}" data-departure="{{t "door_code.window.departure"}}"
     data-previous="{{t "door_code.window.previous"}}" data-next="{{t "door_code.window.next"}}">
  <p><strong>{{t "door_code.window.title"}}</strong><br>{{t "door_code.window.margin" "hours" .Buffer}}</p>
  <div aria-live="polite" aria-atomic="true">
    <dl class="ui-facts" data-window-values{{if not .Complete}} hidden{{end}}>
      <div><dt>{{t "door_code.window.from"}}</dt>
      <dd data-window-start>{{if .Complete}}{{printf "%02d:00" .StartHour}} · {{if .StartPrevious}}{{t "door_code.window.previous"}}{{else}}{{t "door_code.window.arrival"}}{{end}}{{end}}</dd></div>
      <div><dt>{{t "door_code.window.until"}}</dt>
      <dd data-window-end>{{if .Complete}}{{printf "%02d:00" .EndHour}} · {{if .EndNext}}{{t "door_code.window.next"}}{{else}}{{t "door_code.window.departure"}}{{end}}{{end}}</dd></div>
    </dl>
    <p data-window-missing{{if .Complete}} hidden{{end}}>{{t "door_code.window.missing"}}</p>
  </div>
</div>{{end}}

{{define "apartmentdetail.policebox"}}{{$err := ""}}{{if .errors}}{{$err = index .errors .name}}{{end}}
  <div class="field">
    {{field_label .name .label .help .optional "" .required}}
    <input type="text" id="{{.name}}" name="{{.name}}" value="{{.value}}"{{if .max}} maxlength="{{.max}}"{{end}}{{if .required}} aria-required="true"{{end}}{{if $err}} aria-invalid="true" aria-describedby="{{.name}}-error{{if .help}} {{.name}}-help{{end}}"{{else if .help}} aria-describedby="{{.name}}-help"{{end}}{{if .mismatch}} data-mark-mismatch="{{.mismatch}}"{{end}}>
    {{if $err}}<p class="err-text" id="{{.name}}-error" role="alert">{{$err}}</p>{{end}}
    {{$name := .name}}{{range .findings}}{{if eq .Field $name}}<p class="police-letter-note" role="note" data-police-check-code="{{.Code}}">{{.Text}}</p>{{end}}{{end}}
  </div>
{{end}}

{{define "apartmentdetail.letterfigure"}}
<figure class="police-letter-figure">
  <svg class="police-letter-svg" viewBox="0 0 320 200" role="img" aria-labelledby="pl-fig-t">
    <title id="pl-fig-t">{{t "police_letter.figure_title"}}</title>
    <rect class="pl-sheet" x="4" y="4" width="312" height="192" rx="6"/>
    <rect class="pl-bar" x="20" y="16" width="90" height="6" rx="3"/>
    <rect class="pl-bar" x="20" y="27" width="60" height="5" rx="2.5"/>
    <rect class="pl-bar" x="230" y="16" width="70" height="5" rx="2.5"/>
    <text class="pl-title" x="160" y="52" text-anchor="middle">Přihlašovací údaje pro robotické vkládání</text>
    <text class="pl-title" x="160" y="64" text-anchor="middle">Ubyport Webová služba</text>
    <circle class="pl-num" cx="30" cy="88" r="9"/><text class="pl-num-text" x="30" y="91.5" text-anchor="middle">1</text>
    <text class="pl-label" x="46" y="91.5">Přihlašovací jméno:</text><text class="pl-value" x="160" y="91.5">UBY-WS_ABCDE</text>
    <circle class="pl-num" cx="30" cy="114" r="9"/><text class="pl-num-text" x="30" y="117.5" text-anchor="middle">2</text>
    <text class="pl-label" x="46" y="117.5">Přístupové heslo:</text><text class="pl-value" x="160" y="117.5">••••••••</text>
    <circle class="pl-num" cx="30" cy="140" r="9"/><text class="pl-num-text" x="30" y="143.5" text-anchor="middle">3</text>
    <text class="pl-label" x="46" y="143.5">IDUB:</text><text class="pl-value" x="160" y="143.5">000000000000</text>
    <rect class="pl-bar" x="20" y="162" width="280" height="5" rx="2.5"/>
    <rect class="pl-bar" x="20" y="173" width="250" height="5" rx="2.5"/>
    <rect class="pl-bar" x="20" y="184" width="120" height="5" rx="2.5"/>
  </svg>
  <figcaption class="police-letter-legend">
    <ol>
      <li>{{t "automation.login"}}</li>
      <li>{{t "automation.password"}}: {{t "police_letter.by_hand"}}</li>
      <li>{{t "apartment.form.ubyport.idub_label"}}</li>
    </ol>
    <p class="police-letter-note">{{t "apartment.form.ubyport.mark_label"}}: {{t "police_letter.mark_note"}}</p>
  </figcaption>
</figure>
{{end}}

{{define "apartmentdetail"}}
{{$a := .A}}
<div class="airbnb-header">
  <a class="airbnb-back" href="/apartments" aria-label="{{t "common.back"}}">{{icon "arrow-left" 20}}</a>
  <div class="airbnb-title-row"><h1 class="airbnb-title">{{$a.InternalName}}</h1>{{page_help "property"}}</div>
{{if .CopyPeers}}<div class="airbnb-actions">{{template "apartmentdetail.copy" .}}</div>{{end}}
</div>
{{if .AddressSub}}<div class="sub prop-phone-sub">{{.Address}}</div>{{end}}
{{if .CopiedName}}
<div class="copy-settings-bar">
  <p class="ui-sub" role="status">{{t "apartment.form.copy_from.notice" "name" .CopiedName}}</p>
</div>
{{end}}
<nav class="prop-strip prop-strip-v2" aria-label="{{t "property_page.strip.aria"}}">
  <a class="sc" href="#sec-calendars" data-strip="calendars" data-state="{{.Cal.State}}"><i class="sd" aria-hidden="true"></i><b>{{t "property_page.sec.calendars.title"}}</b><small{{if .Cal.Problem}} class="is-problem"{{end}}>{{if .Cal.Problem}}{{t .Cal.TextKey}}{{else if .CalendarErrors}}{{t "apartment.form.feed.status.error"}}{{else}}{{tp "apartment.form.calendars_count" .FeedsCount}}{{end}}</small></a>
  <div class="sc sc-link" data-strip="guest" data-state="{{.Guest.State}}"><a class="sc-main" href="#sec-messages"><i class="sd" aria-hidden="true"></i><b>{{t "property_page.guest_link.title"}}</b><small{{if .Guest.Problem}} class="is-problem"{{end}}>{{if .Guest.Problem}}{{t .Guest.TextKey}}{{else}}{{t "wizard.guest_link.ready"}}{{end}}</small>{{if .Pin}}<small class="sc-pin" data-guest-pin>PIN {{.Pin}}</small>{{end}}</a><div class="sc-actions">
  <input class="sr-only" type="text" id="overview-guest-url" readonly value="{{.Permalink}}" tabindex="-1" aria-hidden="true"><button class="ui-btn ui-btn-primary" type="button" data-copy="overview-guest-url" data-copy-label="{{t "wizard.guest_link.copy_link"}}" data-copied-label="{{t "common.copied"}}" data-guest-copy-link>{{t "wizard.guest_link.copy_link"}}</button>
  {{- if .Pin}}<input class="sr-only" type="text" id="overview-guest-pin" readonly value="{{.Pin}}" tabindex="-1" aria-hidden="true"><button class="ui-btn ui-btn-secondary" type="button" data-copy="overview-guest-pin" data-copy-label="{{t "property_page.guest_link.copy_pin"}}" data-copied-label="{{t "common.copied"}}" data-guest-copy-pin>{{t "property_page.guest_link.copy_pin"}}</button>{{end -}}</div></div>
  <a class="sc" href="#sec-police" data-strip="police" data-state="{{.Police.State}}"><i class="sd" aria-hidden="true"></i><b>{{t "property_page.sec.police.title"}}</b><small{{if .Police.Problem}} class="is-problem"{{end}}>{{if .Police.Problem}}{{t .Police.TextKey}}{{else}}{{t "property_nav.report_ready"}}{{end}}</small></a>
  <a class="sc" href="#sec-basics" data-strip="business" data-state="{{.Biz.State}}"><i class="sd" aria-hidden="true"></i><b>{{t "health.business"}}</b><small{{if .Biz.Problem}} class="is-problem"{{end}}>{{if not $a.LegalEntityID}}{{t "property_page.strip.operator_missing"}}{{else if .Biz.Problem}}{{t .Biz.TextKey}}{{else if .Operator}}{{.Operator.Name}}{{else}}{{t "health.business.ok"}}{{end}}</small></a>
  <a class="sc" href="#sec-fee" data-strip="fee" data-state="{{if $a.StayFeeRateCZK}}ok{{else}}off{{end}}"><i class="sd" aria-hidden="true"></i><b>{{t "property_page.sec.fee.title"}}</b><small>{{if $a.StayFeeRateCZK}}{{$a.StayFeeRateCZK}} Kč{{else}}{{t "apartments.chip_state.off"}}{{end}}</small></a>
  <a class="sc" href="#sec-lock" data-strip="door" data-state="{{.DoorPill}}"><i class="sd" aria-hidden="true"></i><b>{{t "property_page.sec.lock.title"}}</b><small>{{if and .Door (eq .Door.State "on")}}{{t "property_nav.switch_enabled"}}{{else if and .Door (eq .Door.State "times")}}{{t "health.door.times"}}{{else if and .Door (eq .Door.State "offline")}}{{t "health.door.offline"}}{{else}}{{t "property_nav.switch_off"}}{{end}}</small></a>
</nav>
<div class="prop-after-strip">
{{if and .Progress (not .Progress.Hidden)}}
<section class="pv setup-continue-card" aria-label="{{t "wizard.continue_card_aria"}}">
  <div class="setup-continue-head">
    <p>{{t "wizard.continue_card" "done" .Progress.Done "total" .Progress.Total}}</p>
    {{if .Progress.ReportingWaiting}}<span class="ui-badge ui-badge-action" data-tone="amber">{{t "setup_guide.reporting.waiting_item"}}</span>{{end}}
  </div>
  <div class="actions">
    <a class="ui-btn ui-btn-primary" href="{{.Progress.ContinueURL}}">{{t "wizard.continue"}}</a>
    <form method="post" action="/apartments/{{$a.ID}}/setup" class="inline">
      <input type="hidden" name="_csrf" value="{{csrf}}">
      <button class="ui-btn ui-btn-quiet" type="submit" name="action" value="hide" formnovalidate>{{t "setup_guide.hide"}}</button>
    </form>
  </div>
</section>
{{else if .SetupHidden}}
<form method="post" action="/apartments/{{$a.ID}}/setup" class="property-setup-show">
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <button class="ui-btn ui-btn-quiet" type="submit" name="action" value="show">{{t "setup_guide.show"}}</button>
</form>
{{end}}
  {{if .LeonCard}}<div class="pv"><a class="r" href="{{.Base}}/leon{{if ne .LeonCard "on"}}/setup{{end}}" data-leon-card="{{.LeonCard}}"><span>{{t "leon_page.title"}} <small>{{t "leon_page.card.hint"}}</small></span>{{t (print "leon_page.card." .LeonCard)}}</a></div>{{end}}
{{if not .WizardActive}}<div hidden>
<section class="readiness">
  <div class="readiness-group">
    <h3 class="readiness-title">{{t "apartment.form.readiness.invite_title"}}</h3>
    <ul class="readiness-list">
      {{range .Readiness.Invite}}
      <li class="readiness-line{{if .Done}} is-done{{end}}">
        <span class="readiness-mark" aria-hidden="true">{{if .Done}}{{icon "check" 14}}{{else}}{{icon "x" 14}}{{end}}</span>
        {{if .Done}}{{t (print "apartment.form.readiness.item." .Key)}}
        {{else}}<a href="#{{.Anchor}}">{{t "apartment.form.readiness.missing"}} {{t (print "apartment.form.readiness.item." .Key)}}</a>{{end}}
      </li>
      {{end}}
    </ul>
    {{if .Readiness.InviteReady}}
    <p class="readiness-ready">{{t "apartment.form.readiness.invite_ready"}}</p>
    {{end}}
  </div>
  <div class="readiness-group">
    <h3 class="readiness-title">{{t "apartment.form.readiness.report_title"}}</h3>
    <ul class="readiness-list">
      {{range .Readiness.Report}}
      <li class="readiness-line{{if .Done}} is-done{{end}}">
        <span class="readiness-mark" aria-hidden="true">{{if .Done}}{{icon "check" 14}}{{else}}{{icon "x" 14}}{{end}}</span>
        {{if .Done}}{{t (print "apartment.form.readiness.item." .Key)}}
        {{else}}<a href="#{{.Anchor}}">{{t "apartment.form.readiness.missing"}} {{t (print "apartment.form.readiness.item." .Key)}}</a>
          {{if .Message}}<span class="readiness-why">{{.Message}}</span>{{end}}
        {{end}}
      </li>
      {{end}}
    </ul>
  </div>
</section>
</div>{{end}}

</div>
{{if .ReadyCard}}
<section class="ui-section-card ready-card" id="setup-ready" aria-labelledby="setup-ready-title" data-ready-card>
  <h2 class="ui-section-h" id="setup-ready-title">{{t "setup.ready.title"}}</h2>
  <p class="ui-sub">{{if .Pin}}{{t "setup.ready.text"}}{{else}}{{t "setup.ready.text_no_pin"}}{{end}}</p>
  <div class="ready-card-body">
    <img class="ready-card-qr" src="{{.ReadyQR}}" width="160" height="160" alt="{{t "setup.ready.qr_alt"}}">
    <div class="ready-card-copy">
      <p class="ready-card-row"><span class="muted">{{t "property_page.guest_link.title"}}</span> <code class="ready-card-link">{{.Permalink}}</code>
        <input class="sr-only" type="text" id="ready-link" readonly value="{{.Permalink}}" tabindex="-1" aria-hidden="true">
        <button class="ui-btn ui-btn-secondary" type="button" data-copy="ready-link" data-copy-label="{{t "common.copy_link"}}" data-copied-label="{{t "common.copied"}}">{{t "common.copy_link"}}</button></p>
      {{if .Pin}}<p class="ready-card-row"><span class="muted">{{t "havel.card.pin"}}</span> <b class="ready-card-pin">{{.Pin}}</b>
        <input class="sr-only" type="text" id="ready-pin" readonly value="{{.Pin}}" tabindex="-1" aria-hidden="true">
        <button class="ui-btn ui-btn-secondary" type="button" data-copy="ready-pin" data-copy-label="{{t "property_page.guest_link.copy_pin"}}" data-copied-label="{{t "common.copied"}}">{{t "property_page.guest_link.copy_pin"}}</button></p>{{end}}
    </div>
  </div>
</section>
{{end}}
<div class="form prop-form-single property-detail">
<div class="form-main">
<div class="prop-layout"{{if and .FirstSetup .SetupOpen (not .SectionExplicit)}} data-start-section="{{.SetupOpen}}"{{else if eq .SettingsSection "reporting"}} data-start-section="sec-fee"{{end}}>
<nav class="prop-nav prop-wide-only" aria-label="{{t "nav.settings"}}">
<a href="#sec-basics"><span class="dot {{if .Address}}g{{else}}r{{end}}" aria-hidden="true"></span>{{t "property_page.sec.basics.title"}}</a>
<a href="#sec-police"><span class="dot {{if .PoliceOK}}g{{else}}r{{end}}" aria-hidden="true"></span>{{t "property_page.sec.police.title"}}</a>
<a href="#sec-calendars"><span class="dot {{if .CalendarErrors}}r{{else if .FeedsCount}}g{{else}}n{{end}}" aria-hidden="true"></span>{{t "property_page.sec.calendars.title"}}</a>
<a href="#sec-messages"><span class="dot n" aria-hidden="true"></span>{{t "property_page.sec.messages.title"}}</a>
<a href="#sec-lock"><span class="dot {{if and .Door (eq .Door.State "on")}}g{{else}}n{{end}}" aria-hidden="true"></span>{{t "property_page.sec.lock.title"}}</a>
<a href="#sec-fee"><span class="dot {{if $a.StayFeeRateCZK}}g{{else}}n{{end}}" aria-hidden="true"></span>{{t "property_page.sec.fee.title"}}</a>
</nav>
<form method="post" action="{{.Base}}" enctype="multipart/form-data" class="property-settings-form" id="property-settings-form" data-property-settings-form data-unsaved-guard{{if .OperatorError}} data-dirty-start="1"{{end}}>
  <p class="required-legend">{{t "common.required_legend"}}</p>
  <p class="prop-fixline" data-prop-fixline hidden data-text-many="{{t "property_page.fix_fields"}}" data-text-one="{{t "property_page.fix_fields_one"}}"></p>
  <input type="hidden" name="return_to" value="{{if .FirstSetup}}{{.Base}}?view=settings{{else}}{{.Base}}?view=settings&amp;section={{.SettingsSection}}{{end}}" data-property-return>
  {{if .FeeReturnTo}}<input type="hidden" name="fee_return_to" value="{{.FeeReturnTo}}">{{end}}
  <input type="hidden" name="_csrf" value="{{csrf}}">
  <button type="submit" hidden tabindex="-1" aria-hidden="true"></button>

<h2 class="sec prop-phone-only">{{t "nav.settings"}}</h2>
<details class="prop-sec" id="sec-basics"{{if index .Open "sec-basics"}} open{{end}}><summary><span class="dot {{if .Address}}g{{else}}r{{end}}" aria-hidden="true"></span><div><b>{{t "property_page.sec.basics.title"}}</b></div>{{template "apartmentdetail.state" (kv "key" "basics" "root" $ "text" .BasicsState)}}</summary>
  <div class="fields-wrap">
  {{template "apartmentdetail.notice" (kv "root" $ "section" "basics")}}
  {{template "apartmentdetail.missing" (kv "key" "basics" "items" .MissBasics)}}
    <section class="panel property-section ui-section" id="basics">
      <div class="grid two property-identity-fields">
        <div class="field">
          {{field_label "internal_name" (t "apartment.form.internal_name.label") (t "apartment.form.internal_name.hint") false "" true}}
          <input type="text" id="internal_name" name="internal_name" value="{{$a.InternalName}}" required
                 aria-describedby="internal_name-help">
        </div>
        <input type="hidden" id="city_en" name="city_en" value="{{$a.CityEN}}">
      </div>
      <div class="field property-operator" id="operator-picker">
        <label for="legal_entity_id">{{t "apartment.form.entity.label"}}<span class="req-star" aria-hidden="true">*</span></label>
        <select id="legal_entity_id" name="legal_entity_id" required{{if or .OpError (not .Entities)}} aria-describedby="operator-message"{{end}}{{if .OpError}} aria-invalid="true"{{end}}>
          {{if not .OperatorSelected}}<option value="" disabled selected>{{t "apartment.form.operator.choose"}}</option>{{end}}
          {{range .Entities}}
          <option value="{{.ID}}"{{if eq $.OperatorSelected .ID}} selected{{end}}>{{.Name}}</option>
          {{end}}
        </select>
        {{if not .Entities}}
        <div class="property-operator-empty" id="operator-message">
          <p class="err-text"{{if .OpError}} role="alert"{{end}}>{{t "apartment.form.operator.add_first"}}</p>
          <div class="actions">
            <a class="btn small" href="/entities" target="_blank" rel="noopener">{{t "apartment.form.operator.add_business"}}</a>
            <button class="btn small ghost" type="submit" name="operator_refresh" value="1" formnovalidate>{{t "apartment.form.operator.check_again"}}</button>
          </div>
        </div>
        {{else if .OpError}}
        <p class="err-text" id="operator-message" role="alert">{{t .OpError}}</p>
        {{end}}
      </div>
      {{if .Entities}}<div class="hint property-operator-hint"><a href="{{if $a.LegalEntityID}}/entities?edit={{$a.LegalEntityID}}{{else}}/apartments/{{$a.ID}}?view=settings&amp;section=property#operator-picker{{end}}">{{t "host.business"}} </a> {{help_tip "legal_entity_id-help" (t "apartment.form.entity.hint")}}</div>{{end}}
