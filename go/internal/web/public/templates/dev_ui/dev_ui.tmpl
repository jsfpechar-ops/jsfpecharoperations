{{- /* Port of App/app/templates/dev_ui.html (brief 2013): the living component
     catalog every v2 component comes from, with Python's copy, order and
     classes. ui_section call blocks are written out as their markup, as the
     other ports do; the ui_* macros are the Go copies of _ui.html and
     _ui_layout.html. Admin only, reads no data. */ -}}
{{define "dev_ui.meta"}}docs/design/MASTER.md 2.0.0. Every component, state and skeleton from the real CSS.{{end}}
{{define "dev_ui.primary"}}{{ui_button "Primary action" "primary" (kv "href" "#buttons")}}{{end}}
{{define "dev_ui.secondary"}}{{ui_button "Secondary" "secondary" (kv "href" "#fields" "icon_name" "refresh-cw")}}{{ui_icon_button "More actions" "ellipsis-vertical" (kv "extra_class" "ui-ph-menu")}}{{end}}
{{define "dev_ui.tabs"}}{{ui_tabs .Tabs "Catalog"}}{{end}}
{{define "dev_ui"}}
<section class="ui-section" id="tokens"><div class="ui-section-h"><h2>Tokens</h2></div>
<div class="ui-swatch-grid">
  {{range .Tokens}}<div class="ui-swatch" data-token="{{.}}"><span class="ui-swatch-chip"></span><code>--{{.}}</code></div>{{end}}
</div>
<p class="ui-type-sample">Body 16 px. <strong>Facts 600.</strong> <span class="ui-sub">Meta 13 px ink-3.</span> <span class="ui-mono">Mono 4821 #</span> <span class="ui-num">12 345 Kč</span></p>
</section>

<section class="ui-section" id="buttons"><div class="ui-section-h"><h2>Buttons</h2><div class="ui-btn-group">{{ui_button "Section action" "quiet" (kv "size" "compact")}}</div></div>
<div class="ui-btn-group">
  {{ui_button "Primary" "primary"}}{{ui_button "Secondary" "secondary"}}{{ui_button "Quiet" "quiet"}}{{ui_button "Danger" "danger"}}
  {{ui_button "Compact" "secondary" (kv "size" "compact")}}{{ui_button "With icon" "secondary" (kv "icon_name" "plus")}}{{ui_icon_button "Icon only" "pencil" "secondary"}}
  {{ui_button "Loading" "secondary" (kv "loading" true)}}{{ui_button "Disabled" "secondary" (kv "disabled" true)}}{{ui_button "Disabled primary" "quiet" (kv "disabled" true)}}
</div>
</section>

<section class="ui-section" id="fields"><div class="ui-section-h"><h2>Fields</h2></div>
<form onsubmit="return false">
  <div class="ui-pair">{{ui_field "f1" "Text input" (kv "value" "Byt Vinohradská 12" "help" "Help text under the field")}}{{ui_field "f2" "With error" (kv "error" "Enter the house number, the police require it.")}}</div>
  <div class="ui-pair">{{ui_select "f3" "Select" .SelectOptions (kv "selected" "b")}}{{ui_field "f4" "Date" (kv "type" "date" "optional" true)}}</div>
  {{ui_textarea "f5" "Textarea" (kv "value" "Notes")}}
  {{ui_check "f6" "Checkbox label" (kv "checked" true)}}
  {{ui_toggle "f7" "Toggle label" (kv "checked" true)}}
  <div class="ui-form-actions">{{ui_button "Cancel" "quiet"}}{{ui_button "Save (secondary here, the page primary is in the header)" "secondary" (kv "type" "submit")}}</div>
</form>
</section>

<section class="ui-section" id="badges"><div class="ui-section-h"><h2>Badges and chips</h2></div>
<div class="ui-btn-group">{{ui_badge "action" "1 guest missing"}}{{ui_badge "action" "Report overdue" true}}{{ui_badge "attention" "Waiting for UbyPort"}}{{ui_badge "done" "Confirmed"}}{{ui_badge "neutral" "Waiting for guests"}}{{ui_pdot 1 "Property one"}}{{ui_pdot 2 "Property two"}}</div>
<div class="ui-chips">{{ui_chip "Upcoming" (kv "href" "#" "selected" true)}}{{ui_chip "Past" (kv "href" "#")}}{{ui_chip "All" (kv "href" "#")}}</div>
</section>

<section class="ui-section" id="lists"><div class="ui-section-h"><h2>Toolbar, table and cards</h2></div>
<div class="ui-toolbar" data-filter-toolbar data-list-toolbar>
<label class="ui-toolbar-search">{{icon "search" 16}}<input class="ui-input" type="search" name="q" placeholder="Search guest or label" value="" aria-label="Search guest or label"></label>
<div class="ui-chips">{{ui_chip "Upcoming" (kv "href" "#" "selected" true)}}{{ui_chip "Past" (kv "href" "#")}}</div>
<button class="ui-btn ui-btn-secondary" type="button" data-filter-toggle aria-expanded="true" aria-controls="dev-filters" hidden>{{icon "sliders-horizontal" 16}}<span>Filters</span><span class="ui-badge ui-badge-neutral">2</span></button>
<div class="ui-toolbar-right">{{ui_button "Export CSV" "quiet" (kv "icon_name" "download")}}</div>
</div>
{{ui_table_begin .TableColumns "Sample rows"}}
{{range .SampleRows}}<tr class="ui-row clickable-row" data-href="#" tabindex="0"><td class="ui-cell-first"><a href="#">Sample stay {{.Index}}</a><span class="ui-sub">Airbnb</span></td><td class="ui-num">19. 10. to 22. 10.</td><td>{{ui_pdot .Pdot "Property"}}</td><td class="ui-cell-r ui-num">1 of 2</td><td>{{ui_badge "action" "1 guest missing"}}</td><td class="ui-cell-acts">{{ui_button "Send" "secondary" (kv "size" "compact" "icon_name" "send")}} {{ui_menu_begin}}{{ui_menu_item "Open" "#"}}{{ui_menu_item "Delete" (kv "danger" true "icon_name" "trash-2")}}{{ui_menu_end}}</td></tr>
{{end}}{{ui_table_end}}
<div class="ui-cards">{{range .Cards}}{{ui_card "#" "19. 10. to 22. 10." "Nováková · Byt Vinohradská 12" "1 of 2 guests" (safe `<span class="ui-badge ui-badge-action">1 guest missing</span>`)}}{{end}}</div>
{{ui_pagination 1 4 "" "#" "Sample" "Show more" "Previous" "Next"}}
</section>

<section class="ui-section" id="detail"><div class="ui-section-h"><h2>Detail parts</h2></div>
<div class="ui-detail">
  <div>{{ui_banner "attention" (safe `<strong>Studio Karlín</strong>: address and UbyPort credentials missing.`) "Finish setup" "#"}}{{ui_banner "neutral" "The report can be sent once every guest is complete."}}
    <div class="ui-gcard"><h3>Jana Nováková {{ui_badge "done" "Details complete"}}</h3><p class="ui-sub">Passport, 14. 3. 1986, Slovakia</p></div>
    {{ui_empty "No stays yet" "Connect a calendar or add a stay by hand." "Add stay" "#" (kv "primary" false)}}
    {{ui_tip "dev-tip" "A help tip opens a short note." "/guide"}}
  </div>
  <aside class="ui-detail-side">{{ui_facts .Facts}}</aside>
</div>
{{ui_stats .Stats "Sample"}}
</section>

<section class="ui-section" id="dialog"><div class="ui-section-h"><h2>Dialog</h2></div>
{{ui_button "Open dialog" "secondary" (kv "attrs" (safe `onclick="document.getElementById('dev-dialog').showModal()"`))}}
{{ui_dialog_begin "dev-dialog" "Delete this stay?"}}<p>It moves to Archived. You can restore it there.</p><div class="ui-form-actions">{{ui_button "Cancel" "secondary" (kv "attrs" (safe `onclick="this.closest('dialog').close()"`))}}{{ui_button "Delete" "danger" (kv "attrs" (safe `onclick="this.closest('dialog').close()"`))}}</div>{{ui_dialog_end}}
</section>

<section class="ui-section" id="skeletons"><div class="ui-section-h"><h2>Skeletons</h2></div>
{{range .Skeletons}}<h3 class="ui-sub">{{.}}</h3>{{ui_skeleton .}}{{end}}
</section>
{{end}}
