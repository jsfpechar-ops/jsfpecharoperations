# Copy to .env and fill in before first deploy:
#   cp .env.example .env && nano .env

# --- Public site (required for HTTPS and guest permalinks) ---
UBYHOST_DOMAIN=ubyhost.example.com
ACME_EMAIL=you@example.com
UBYHOST_PUBLIC_BASE_URL=https://ubyhost.example.com

# --- Cloudflare (recommended) ---
# Register the domain at Cloudflare, point a proxied A record at this server,
# set SSL/TLS to Full (strict), install origin certs — see docs/CLOUDFLARE.md.
CLOUDFLARE_PROXY=1

# Which peer may set CF-Connecting-IP. Caddy and the app share the `ubyhost-web`
# network, which Docker draws from its default pool (172.17.0.0/16-172.31.0.0/16).
# Without this the app ignores CF-Connecting-IP and every visitor shares one
# rate-limit bucket. Narrow it to the network's actual subnet if you pin one.
UBYHOST_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# --- Deployment tier ---
UBYHOST_DEPLOYMENT=production

# UbyPort: start on "test", switch to "prod" only after a signed-off test submission.
# Never set prod on Render. Lightsail .env must keep UBYHOST_DEPLOYMENT=production.
UBYHOST_UBYPORT_ENV=test

# --- Bootstrap admin (first login only; change password in the UI after) ---
UBYHOST_ADMIN_USERNAME=admin
UBYHOST_ADMIN_PASSWORD=change-me-to-a-long-random-password

# --- Security (generate: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
UBYHOST_SECRET_KEY=

# --- Backups (OPS-1) ---
# Public age recipient (age1...) the daily snapshot is encrypted to. Required in
# production: without it backup_data.sh fails closed rather than writing the
# database and its key in the clear. The matching private identity is kept
# offline (owner's password manager + one offline copy) and never on the server.
# Generate it with:  age-keygen -o ubyhost-backup.agekey
# Required in production: preflight.sh refuses to deploy while it is empty.
UBYHOST_BACKUP_AGE_RECIPIENT=
# Time-based retention for local snapshots (days); the newest is always kept.
UBYHOST_BACKUP_RETENTION_DAYS=30
# Required in production: pinged after each successful daily backup; preflight.sh refuses to deploy while it is empty.
UBYHOST_BACKUP_PING_URL=

# --- Dead-man switches (WP07; for example healthchecks.io, one check each) ---
# Each URL is pinged (HTTP GET, 5 s timeout) only after a successful run, so a
# missed ping means the job is failing or the worker is down. Empty disables it.
# Suggested check periods: submit 10 min, iCal 60 min, mail 5 min, backup 1 day
# (grace: about one period each).
# After each successful UbyPort submission sweep (every UBYHOST_SUBMIT_SWEEP_MINUTES):
UBYHOST_HEARTBEAT_URL=
# After each successful calendar sync (every UBYHOST_ICAL_POLL_MINUTES):
UBYHOST_HEARTBEAT_ICAL_URL=
# After each mail run in which every step succeeded (every 5 min):
UBYHOST_HEARTBEAT_MAIL_URL=

# --- Continuous S3 replica (WP05, Litestream) ---
# The litestream service streams every database change to this bucket within
# about 10 s. Required in production: preflight.sh refuses to deploy while the
# bucket or the keys are empty. Use a dedicated IAM user limited to this bucket
# and prefix (README.md, "Litestream"); never reuse the SES or backup keys.
# The replica is not client-side encrypted (Litestream 0.5 has no such option);
# the bucket must have default encryption and Block Public Access on.
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_REGION=eu-central-1
# Prefix inside the bucket, no leading or trailing slash. Change it to a new
# value after any restore so the old and the new history never mix.
LITESTREAM_S3_PATH=ubyhost/production
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# Optional dead-man switch (e.g. healthchecks.io, period 5 min): Litestream
# pings it only while replication is healthy.
LITESTREAM_HEARTBEAT_URL=

# --- Software operator (host-admin support is support@ubyhost.com) ---
# Required in production: the app refuses to start while name, IČO or address is empty.
# Fill these in on the server only. Never commit real values (this repo is public).
UBYHOST_OPERATOR_NAME=
UBYHOST_OPERATOR_ICO=
UBYHOST_OPERATOR_DIC=
UBYHOST_OPERATOR_ADDRESS=
UBYHOST_OPERATOR_EMAIL=support@ubyhost.com

# --- Bot protection (secret comes from the existing Cloudflare widget) ---
TURNSTILE_SITE_KEY=0x4AAAAAAE0LDM2eoIjssN00
TURNSTILE_SECRET=
TURNSTILE_HOSTNAMES=ubyhost.com,www.ubyhost.com

# --- Guest e-mail ---
# Production runs UBYHOST_MAIL_BACKEND=ses (live since 2026-09-21). A fresh copy
# starts disabled so the stack boots before the AWS credentials exist: ses
# refuses to start unless every value below is filled in. Staging (Render
# ubyhost-staging) always uses console so claim links appear in Settings.
# See docs/SES.md.
UBYHOST_MAIL_BACKEND=disabled
# Required when UBYHOST_MAIL_BACKEND=ses:
# UBYHOST_MAIL_FROM=noreply@ubyhost.com
# UBYHOST_SES_REGION=eu-central-1
# UBYHOST_AWS_ACCESS_KEY_ID=
# UBYHOST_AWS_SECRET_ACCESS_KEY=

# --- Recommended production defaults ---
UBYHOST_GUEST_PIN=1
UBYHOST_ENABLE_SCHEDULER=1
# UBYHOST_ROLE is set per service in docker-compose.yml (ubyhost=web,
# worker=worker); do not set it here.
UBYHOST_BOOTSTRAP_ADMIN=1

# --- Optional tuning (defaults are fine on production 8 GB Lightsail; tight on Micro) ---
# UBYHOST_ICAL_POLL_MINUTES=60
# UBYHOST_SUBMIT_SWEEP_MINUTES=10
