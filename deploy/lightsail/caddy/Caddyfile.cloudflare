# TLS with a Cloudflare Origin Certificate (orange-cloud / proxied DNS).
# Requires origin.pem + origin-key.pem in caddy/certs/ (see docs/CLOUDFLARE.md).
# Access logging is intentionally off (OPS-3): a request line would carry guest
# permalink tokens. Container logs are bounded by docker-compose `logging:`.
{
	email {$ACME_EMAIL}
}

{$UBYHOST_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem
	# The guest form posts its signature and its passport upload as one
	# multipart body, so this must stay above passport_photos.MAX_PDF_BYTES
	# (15 MB). 20 MB admits every legitimate body and rejects an unbounded one
	# with 413 before the app buffers it.
	request_body {
		max_size 20MB
	}
	encode gzip
	reverse_proxy ubyhost:8080
}
