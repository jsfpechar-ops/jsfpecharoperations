# TLS with a Cloudflare Origin Certificate (orange-cloud / proxied DNS).
# Requires origin.pem + origin-key.pem in caddy/certs/ (see docs/CLOUDFLARE.md).
# Access logging is intentionally off (OPS-3): a request line would carry guest
# permalink tokens. Container logs are bounded by docker-compose `logging:`.
# The same holds for ad click identifiers in query strings (gclid, gbraid,
# wbraid, fbclid): with no access log they are never written (legal position 3).
# Do not add a `log` directive without a filter that drops the query string.
{
	email {$ACME_EMAIL}
	servers {
		# Only Cloudflare may tell us the client IP. Ranges from
		# https://www.cloudflare.com/ips-v4 and /ips-v6 (checked 2026-09-28).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# 1208: Cloudflare Authenticated Origin Pulls (zone-level), K-S14. Mode comes
# from UBYHOST_AOP_MODE: off (default), check, enforce. Only the imported
# snippet is read, so aop-ca.pem is only needed for enforce.
(aop_off) {
	protocols tls1.2 tls1.3
}
(aop_check) {
	client_auth {
		mode request
	}
}
(aop_enforce) {
	client_auth {
		mode require_and_verify
		trust_pool file /etc/caddy/certs/aop-ca.pem
	}
}
# 1208: the probe exists only in check mode (owner runbook step 7). No log, no personal data.
(aop_probe_check) {
	@aop_probe path /__aop_probe
	handle @aop_probe {
		header Cache-Control "no-store"
		respond "client_cert_issuer={http.request.tls.client.issuer}" 200
	}
}
# 1208: empty in off and enforce, so /__aop_probe is not handled there.
(aop_probe_off) {
	# no probe in this mode
}
(aop_probe_enforce) {
	# no probe in this mode
}

# The optional app hostname shares this backend, TLS policy and upload limit.
{$UBYHOST_DOMAIN} {$UBYHOST_APP_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin-key.pem {
		import aop_{$UBYHOST_AOP_MODE:off}
	}
	# 0421: only Cloudflare may reach the app. A request straight to the
	# server's IP would skip Cloudflare's WAF, bot checks and rate limits.
	# remote_ip is the TCP peer, not the forwarded client IP. Same ranges as
	# trusted_proxies above: when Cloudflare publishes new ones, update both.
	@metrics path /metrics
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	abort @not_cloudflare
	# 0427 prep: the app's Prometheus metrics stay compose-internal (alloy
	# scrapes ubyhost:8080 directly). Never served to the internet.
	respond @metrics 404
	# The guest form posts its signature and its passport upload as one
	# multipart body, so this must stay above passport_photos.MAX_PDF_BYTES
	# (15 MB). 20 MB admits every legitimate body and rejects an unbounded one
	# with 413 before the app buffers it.
	request_body {
		max_size 20MB
	}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# 1208: probe handler for check mode only (see aop_probe_* above).
	import aop_probe_{$UBYHOST_AOP_MODE:off}
	# UBYHOST_GO_PATHS: space-separated paths for the Go service (ubyhost-go); unset = all traffic to Python (compose defaults it to /__go_off__; an empty value breaks Caddy).
	# Unset or empty keeps every request on Python, so this changes nothing until the owner sets it.
	@go path {$UBYHOST_GO_PATHS:/__go_off__}
	# 1630: a Go page that is not ported yet answers 501 plus X-Ubyhost-Not-Ported.
	# For GET and HEAD (no body, safe to send again) Caddy then asks Python for the
	# same URL. Other methods and every other 501 are passed through unchanged.
	@go_read {
		path {$UBYHOST_GO_PATHS:/__go_off__}
		method GET HEAD
	}
	handle @go_read {
		reverse_proxy ubyhost-go:8081 {
			header_up CF-Connecting-IP {client_ip}
			@not_ported {
				status 501
				header X-Ubyhost-Not-Ported 1
			}
			handle_response @not_ported {
				reverse_proxy ubyhost:8080 {
					# Always overwrite: a client-sent CF-Connecting-IP must never reach the app.
					header_up CF-Connecting-IP {client_ip}
				}
			}
		}
	}
	handle @go {
		reverse_proxy ubyhost-go:8081 {
			header_up CF-Connecting-IP {client_ip}
		}
	}
	handle {
		reverse_proxy ubyhost:8080 {
			# Always overwrite: a client-sent CF-Connecting-IP must never reach the app.
			header_up CF-Connecting-IP {client_ip}
		}
	}
}
