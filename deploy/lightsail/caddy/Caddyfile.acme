# Direct TLS via Let's Encrypt (DNS grey-cloud or no Cloudflare proxy).
# Selected automatically when CLOUDFLARE_PROXY is not set in .env.
# Access logging is intentionally off (OPS-3): a request line would carry guest
# permalink tokens. Container logs are bounded by docker-compose `logging:`.
# The same holds for ad click identifiers in query strings (gclid, gbraid,
# wbraid, fbclid): with no access log they are never written (legal position 3).
# Do not add a `log` directive without a filter that drops the query string.
{
	email {$ACME_EMAIL}
}

# The optional app hostname shares this backend, TLS policy and upload limit.
{$UBYHOST_DOMAIN} {$UBYHOST_APP_DOMAIN} {
	# 0427 prep: the app's Prometheus metrics stay compose-internal (alloy
	# scrapes ubyhost:8080 directly). Never served to the internet.
	@metrics path /metrics
	respond @metrics 404
	# The guest form posts its signature and its passport upload as one
	# multipart body, so this must stay above passport_photos.MAX_PDF_BYTES
	# (15 MB). 20 MB admits every legitimate body and rejects an unbounded one
	# with 413 before the app buffers it.
	request_body {
		max_size 20MB
	}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# UBYHOST_GO_PATHS: space-separated paths for the Go service (ubyhost-go); empty = all traffic to Python.
	# Unset or empty keeps every request on Python, so this changes nothing until the owner sets it.
	@go path {$UBYHOST_GO_PATHS:/__go_off__}
	handle @go {
		reverse_proxy ubyhost-go:8081 {
			header_up CF-Connecting-IP {remote_host}
		}
	}
	handle {
		reverse_proxy ubyhost:8080 {
			# No Cloudflare in front: the TCP peer is the client.
			header_up CF-Connecting-IP {remote_host}
		}
	}
}
