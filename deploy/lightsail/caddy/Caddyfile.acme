# Direct TLS via Let's Encrypt (DNS grey-cloud or no Cloudflare proxy).
# Selected automatically when CLOUDFLARE_PROXY is not set in .env.
# Access logging is intentionally off (OPS-3): a request line would carry guest
# permalink tokens. Container logs are bounded by docker-compose `logging:`.
# The same holds for ad click identifiers in query strings (gclid, gbraid,
# wbraid, fbclid): with no access log they are never written (legal position 3).
# Do not add a `log` directive without a filter that drops the query string.
{
	email {$ACME_EMAIL}
}

# The optional app hostname shares this backend, TLS policy and upload limit.
{$UBYHOST_DOMAIN} {$UBYHOST_APP_DOMAIN} {
	# 0427 prep: the app's Prometheus metrics stay compose-internal (alloy
	# scrapes ubyhost:8080 directly). Never served to the internet.
	@metrics path /metrics
	respond @metrics 404
	# The guest form posts its signature and its passport upload as one
	# multipart body, so this must stay above passport_photos.MAX_PDF_BYTES
	# (15 MB). 20 MB admits every legitimate body and rejects an unbounded one
	# with 413 before the app buffers it.
	request_body {
		max_size 20MB
	}
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	# 1805: paths only scanners ask for get a 404 here and never reach the app.
	# None of these prefixes is a real route (checked against the Python and Go
	# route tables, brief 1805). Never widen a pattern without rerunning that
	# check; /.well-known/ must stay reachable. No log directive (OPS-3).
	@scanners path *.php *.asp *.aspx *.jsp /wp-* /wordpress* /xmlrpc* /.env* /.git /.git/* /.svn/* /.aws/* /.ds_store /.htaccess /.htpasswd /cgi-bin/* /vendor/* /phpmyadmin* /phpinfo* /server-status /actuator/* /boaform/*
	handle @scanners {
		respond 404
	}
	# 1804: Caddy serves the service worker, the manifest and /static from disk
	# (compose mounts App/app/static read-only at /srv/static) so these requests
	# never reach the app. GET and HEAD only; any other method falls through to
	# the app. A missing file is a Caddy 404, not an app call. These handles sit
	# above the Go handles on purpose: Go serves none of these paths.
	@sw_js {
		path /sw.js
		method GET HEAD
	}
	handle @sw_js {
		root * /srv/static
		# Revalidate on every visit (cheap 304 via ETag): a stale worker is never pinned.
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server
	}
	@manifest {
		path /manifest.webmanifest
		method GET HEAD
	}
	handle @manifest {
		root * /srv/static
		header Content-Type "application/manifest+json"
		header Cache-Control "public, max-age=3600"
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		file_server
	}
	@static_versioned {
		path /static/*
		method GET HEAD
		query v=*
	}
	@static_plain {
		path /static/*
		method GET HEAD
		not query v=*
	}
	handle @static_versioned {
		uri strip_prefix /static
		root * /srv/static
		# File names are not fingerprinted; ?v= is a hand-kept key guarded by test_static_versions.py.
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		file_server
	}
	handle @static_plain {
		uri strip_prefix /static
		root * /srv/static
		header Cache-Control "public, max-age=86400"
		header X-Content-Type-Options "nosniff"
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		file_server
	}
	# UBYHOST_GO_PATHS: space-separated paths for the Go service (ubyhost-go); unset = all traffic to Python (compose defaults it to /__go_off__; an empty value breaks Caddy).
	# Unset or empty keeps every request on Python, so this changes nothing until the owner sets it.
	@go path {$UBYHOST_GO_PATHS:/__go_off__}
	# 1630: a Go page that is not ported yet answers 501 plus X-Ubyhost-Not-Ported.
	# For GET and HEAD (no body, safe to send again) Caddy then asks Python for the
	# same URL. Other methods and every other 501 are passed through unchanged.
	@go_read {
		path {$UBYHOST_GO_PATHS:/__go_off__}
		method GET HEAD
	}
	handle @go_read {
		reverse_proxy ubyhost-go:8081 {
			header_up CF-Connecting-IP {remote_host}
			@not_ported {
				status 501
				header X-Ubyhost-Not-Ported 1
			}
			handle_response @not_ported {
				reverse_proxy ubyhost:8080 {
					# No Cloudflare in front: the TCP peer is the client.
					header_up CF-Connecting-IP {remote_host}
				}
			}
		}
	}
	handle @go {
		reverse_proxy ubyhost-go:8081 {
			header_up CF-Connecting-IP {remote_host}
		}
	}
	handle {
		reverse_proxy ubyhost:8080 {
			# No Cloudflare in front: the TCP peer is the client.
			header_up CF-Connecting-IP {remote_host}
		}
	}
}
