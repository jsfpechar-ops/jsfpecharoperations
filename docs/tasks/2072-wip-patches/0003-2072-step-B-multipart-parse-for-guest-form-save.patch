From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 22:04:51 +0000
Subject: [PATCH 03/10] 2072 step B: multipart parse for guest form save

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014N5J8NCpdqN2TbR61gYRQf
---
 go/internal/web/guest/form_save.go | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/go/internal/web/guest/form_save.go b/go/internal/web/guest/form_save.go
index eba8887..36ecd9c 100644
--- a/go/internal/web/guest/form_save.go
+++ b/go/internal/web/guest/form_save.go
@@ -84,7 +84,18 @@ func handleGuestFormSave(ctx context.Context, d saveDeps, w http.ResponseWriter,
 	if d.pool == nil {
 		return errors.New("guest form save: nil pool")
 	}
-	if err := r.ParseForm(); err != nil {
+	if strings.HasPrefix(r.Header.Get("Content-Type"), "multipart/form-data") {
+		if r.MultipartForm == nil {
+			if err := r.ParseMultipartForm(maxPDFBytes + 1024); err != nil {
+				return err
+			}
+		}
+		defer func() {
+			if r.MultipartForm != nil {
+				_ = r.MultipartForm.RemoveAll()
+			}
+		}()
+	} else if err := r.ParseForm(); err != nil {
 		return err
 	}
 	token := r.PathValue("token")
