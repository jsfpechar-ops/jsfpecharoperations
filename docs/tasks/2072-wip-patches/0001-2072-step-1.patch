From 29791cfadefda73a4b007ca267d1aeca9b680110 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Tue, 24 Nov 2026 22:00:56 +0000
Subject: [PATCH 01/10] 2072 step 1

Expose Prepare and SavePrepared in passportphotos so validation runs once before guest persistence. Save keeps its behaviour.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_014N5J8NCpdqN2TbR61gYRQf
---
 go/internal/passportphotos/save.go | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/go/internal/passportphotos/save.go b/go/internal/passportphotos/save.go
index 84a7f47..e9f898e 100644
--- a/go/internal/passportphotos/save.go
+++ b/go/internal/passportphotos/save.go
@@ -48,10 +48,25 @@ func Save(dataDir string, keys *secure.MultiFernet, guestID int64, content []byt
 	if keys == nil {
 		return errors.New("passportphotos: data encryption keys are not configured")
 	}
-	body, storeExt, err := prepareUpload(content, contentType)
+	body, storeExt, err := Prepare(content, contentType)
 	if err != nil {
 		return err
 	}
+	return SavePrepared(dataDir, keys, guestID, body, storeExt)
+}
+
+// Prepare validates an upload and returns the bytes to store with their
+// extension, so a caller can refuse a bad file before it writes anything.
+func Prepare(content []byte, contentType string) ([]byte, string, error) {
+	return prepareUpload(content, contentType)
+}
+
+// SavePrepared stores bytes returned by Prepare: encrypt, write
+// <guest_id><ext>.enc, chmod 600. It replaces any prior photo for the guest.
+func SavePrepared(dataDir string, keys *secure.MultiFernet, guestID int64, body []byte, storeExt string) error {
+	if keys == nil {
+		return errors.New("passportphotos: data encryption keys are not configured")
+	}
 	dir := PhotosDir(dataDir)
 	if err := os.MkdirAll(dir, 0o700); err != nil {
 		return fmt.Errorf("passportphotos: create directory: %w", err)
-- 
