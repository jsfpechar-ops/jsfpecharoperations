   .host-property-grid { grid-template-columns: 1fr; }
   .host-workspace .guest-card-head { padding: 15px; gap: 12px; }
+  .host-workspace .guest-card.placeholder .guest-card-head { padding-bottom: 15px; }
   .host-workspace .guest-facts { padding: 15px; gap: 14px; }
   .host-workspace .guest-facts .fact-wide { grid-column: 1 / -1; }
   .host-workspace .detail-metric { padding: 12px; }
@@ -293,12 +297,13 @@ body.host-workspace {
   .host-workspace .list-filter .filter-actions-end { margin-left: 0; }
 }
 
-/* House book register (WP25). The workspace lets table cells break anywhere so
-   card facts never overflow on a phone, but in the eleven-column register that
-   let the browser shrink a column to one letter per line. Words stay whole
-   here; the floors below keep each column readable and the panel scrolls
-   sideways when the row is wider than the viewport. */
-.host-workspace .panel.tight.scroll-x { overflow-x: auto; position: relative; }
+/* House book register (WP25). Workspace table cells may break long words
+   (break-word, WP28) so card facts never overflow on a phone; in the
+   eleven-column register even that let a column shrink too far. Words stay
+   whole here and the floors below keep each column readable. The sideways
+   scroll itself is the shared .panel.tight.scroll-x rule in app.css (WP28);
+   position: relative keeps the sr-only header from widening the page. */
+.host-workspace .panel.housebook-scroll { position: relative; }
 .host-workspace .housebook-table td { overflow-wrap: normal; word-break: normal; }
 .host-workspace .housebook-table th,
 .host-workspace .housebook-table td { padding-left: 7px; padding-right: 7px; }
@@ -378,3 +383,9 @@ body.host-workspace {
   background: var(--canvas); color: var(--ink-secondary); border-color: var(--line);
   cursor: not-allowed; opacity: 1; -webkit-text-fill-color: var(--ink-secondary);
 }
