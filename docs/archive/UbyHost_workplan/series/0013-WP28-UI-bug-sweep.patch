 .host-workspace .row-primary-link { font-weight: 700; }
-.host-workspace .table-cards td, .host-workspace .guest-facts dd { overflow-wrap: anywhere; }
+/* break-word, not anywhere: anywhere lets a table shrink a column below its
+   longest word, which printed "Airbn b" and split e-mail addresses. */
