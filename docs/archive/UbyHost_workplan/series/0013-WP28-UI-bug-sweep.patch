 .clickable-row:hover .row-primary-link { color: var(--brand); }
 .scroll-x { overflow-x: auto; }
+/* .panel.tight clips its corners with overflow: hidden, which outranks the
+   single-class .scroll-x and cut off the right-hand columns (row actions)
+   of every wide table instead of letting it scroll. */
+.panel.tight.scroll-x { overflow-x: auto; }
 /* Eleven columns of legal record. The columns holding free text need a width
    floor of their own, or the browser spends the room on the short ones and
    folds every name onto three lines. Past that the table scrolls sideways. */
@@ -1018,7 +1022,8 @@ label { display: block; font-size: 13.5px; font-weight: 600; color: var(--ink-2)
 label .opt { font-weight: 400; color: var(--faint); text-transform: none; }
 
 input:not([type]), input[type=text], input[type=password], input[type=date], input[type=number],
-input[type=email], input[type=url], input[type=file], select, textarea {
+input[type=email], input[type=url], input[type=file], input[type=tel],
+input[type=datetime-local], input[type=search]:not([data-command-input]), select, textarea {
   width: 100%;
   padding: 11px 13px;
   border: 1px solid var(--line-2);
@@ -1478,6 +1483,7 @@ textarea { min-height: 82px; resize: vertical; line-height: 1.5; }
