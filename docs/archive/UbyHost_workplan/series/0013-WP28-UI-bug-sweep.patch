 .metric-value.deadline { font-size: 21px; font-weight: 700; }
+.metric-value.deadline.overdue { display: inline-block; }  /* a pill, not a full-width bar */
 .metric-note { color: var(--muted); font-size: 13px; margin-top: 5px; }
 
 /* The stay page has one clear action area. Secondary metadata editing stays
@@ -1731,6 +1737,7 @@ details.raw pre {
 
 .message-template {
   white-space: pre-wrap;
+  overflow-wrap: anywhere;  /* the guest link is one long word on a phone */
   padding: 14px;
   border-radius: var(--radius-sm);
   background: var(--surface-3);
@@ -1750,6 +1757,9 @@ details.raw pre {
 
 .err-text { color: var(--bad); }
 .truncate { max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+/* The calendar table shares its row with the connect form, so the feed URL
+   gives up width to keep the Remove button in view. */
