+/* The operator signature block was an unstyled browser fieldset. */
+.host-workspace .signature-block { min-width: 0; margin: 0 0 16px; padding: 14px 16px 2px; border: 1px solid var(--line); border-radius: var(--radius-sm); }
+.host-workspace .signature-block > legend { padding: 0 6px; color: var(--ink); font-size: 14px; font-weight: 650; }
+.host-workspace .signature-block .action-group { margin: 10px 0 14px; }
+.host-workspace .signature-block .action-group > label.btn { margin: 0; }
