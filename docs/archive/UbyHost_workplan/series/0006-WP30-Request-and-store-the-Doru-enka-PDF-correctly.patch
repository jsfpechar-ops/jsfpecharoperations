+    old_order = envelope.replace(flag, "").replace("</Seznam>", flag + "</Seznam>")
+    parsed = soap.parse_zapis_response(_call_mock(old_order))
+    assert parsed["receipt_pdf"] == ""
+    assert parsed["pseudo_stamp"]
