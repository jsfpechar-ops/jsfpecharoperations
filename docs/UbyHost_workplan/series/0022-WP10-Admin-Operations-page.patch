+  <p class="small muted">{{ t('ops.filings.help') }}</p>
+  {% if ops.filings.rows %}
+  <table class="table-cards">
+    <thead><tr><th>{{ t('ops.col.workspace') }}</th><th>{{ t('ops.col.property') }}</th><th>{{ t('ops.col.stay') }}</th><th>{{ t('ops.col.state') }}</th><th>{{ t('ops.col.age') }}</th></tr></thead>
+    <tbody>
+    {% for row in ops.filings.rows %}
+      <tr>
+        <td data-label="{{ t('ops.col.workspace') }}">{{ workspace_link(row) }}</td>
