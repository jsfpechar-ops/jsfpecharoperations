+    <tbody>
+    {% for row in ops.stuck.rows %}
+      <tr>
+        <td data-label="{{ t('ops.col.workspace') }}">{{ workspace_link(row) }}</td>
+        <td data-label="{{ t('ops.col.property') }}">{{ row.property }}</td>
+        <td data-label="{{ t('ops.col.submission') }}" class="mono">#{{ row.submission_id }}</td>
+        <td data-label="{{ t('ops.col.age') }}">{{ age(row.age_minutes) }}</td>
+      </tr>
+    {% endfor %}
+    </tbody>
+  </table>
+  {% endif %}
+</section>
+
+<section class="panel tight scroll-x" id="ops-feeds">
+  <h2 style="margin-top:0">{{ t('ops.feeds.title') }} <span class="pill {{ 'amber' if ops.feeds.count else 'green' }}">{{ ops.feeds.count }}</span></h2>
+  <p class="small muted">{{ t('ops.feeds.help') }}</p>
+  {% if ops.feeds.rows %}
