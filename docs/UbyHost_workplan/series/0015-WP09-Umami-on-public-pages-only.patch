diff --git a/App/app/static/umami-optout.js b/App/app/static/umami-optout.js
new file mode 100644
index 0000000..b6e88ec
--- /dev/null
+++ b/App/app/static/umami-optout.js
@@ -0,0 +1,47 @@
+/* WP09: opt-out and opt-back-in for website analytics, loaded only on /privacy
+ * and only while Umami is configured. The Umami tracker counts nothing while
+ * localStorage "umami.disabled" is set ("Exclude my own visits" in the Umami
+ * docs). The key is written only when the visitor clicks the link, so no
+ * consent is needed for it. Listed in cookie_inventory.py. */
+(function () {
+  "use strict";
+  var KEY = "umami.disabled";
+  var root = document.getElementById("analytics-optout");
+  if (!root) return;
+
+  function isOff() {
+    try {
+      return window.localStorage.getItem(KEY) !== null;
+    } catch (err) {
+      return false;
+    }
+  }
+
+  function render() {
+    var off = isOff();
+    var states = root.querySelectorAll("[data-optout-when]");
+    for (var i = 0; i < states.length; i++) {
+      states[i].hidden = (states[i].getAttribute("data-optout-when") === "off") !== off;
+    }
+  }
+
+  root.addEventListener("click", function (event) {
+    var link = event.target.closest("[data-optout-action]");
+    if (!link) return;
+    event.preventDefault();
+    try {
+      if (link.getAttribute("data-optout-action") === "disable") {
+        window.localStorage.setItem(KEY, "1");
+      } else {
+        window.localStorage.removeItem(KEY);
+      }
+    } catch (err) {
+      /* Storage blocked: nothing to change, the state below stays truthful. */
+    }
+    render();
+    var shown = root.querySelector("[data-optout-when]:not([hidden]) [data-optout-action]");
+    if (shown) shown.focus();
+  });
+
+  render();
+})();
