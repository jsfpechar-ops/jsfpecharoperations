+            revealed_guest_ids=[*auth.revealed_guest_ids(request), guest_id],
+        ),
+    )
+    db.audit(
+        "guest_identity_revealed",
+        f"guest_id={guest_id} reason={reason}",
+        owner_user_id=workspace["id"],
+    )
+    return response
