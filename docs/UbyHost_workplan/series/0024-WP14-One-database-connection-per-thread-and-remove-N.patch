+    reservation = db.query_one("SELECT * FROM reservation WHERE id = ?", (reservation_id,))
+    pairs = [
+        (guest, reservation)
+        for guest in db.query("SELECT * FROM guest WHERE reservation_id = ?", (reservation_id,))
+    ]
+
+    def work(_index):
