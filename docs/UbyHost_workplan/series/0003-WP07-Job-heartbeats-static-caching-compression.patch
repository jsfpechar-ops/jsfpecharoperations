+# After each successful calendar sync (every UBYHOST_ICAL_POLL_MINUTES):
+UBYHOST_HEARTBEAT_ICAL_URL=
+# After each mail run in which every step succeeded (every 5 min):
+UBYHOST_HEARTBEAT_MAIL_URL=
+
