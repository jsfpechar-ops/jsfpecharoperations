+    kind = "ÄŒTVRTLETNÃ HLÃÅ ENÃ K MÃSTNÃMU" if report.get("cadence") == "quarterly" else "HLÃÅ ENÃ K MÃSTNÃMU"
+    _label(c, R, top, kind, right=True, color=CORAL)
