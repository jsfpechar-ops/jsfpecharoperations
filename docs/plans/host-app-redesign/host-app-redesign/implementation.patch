@@ -0,0 +1,205 @@
+/* Signed-in host workspace. See docs/HOST_APP_DESIGN.md.
+   This layer deliberately scopes the shared primitives to host-workspace:
+   login, marketing, guest forms, PDFs and email retain their own presentation. */
+.host-workspace {
+  --canvas: #f7f9f6; --canvas-subtle: #eff3ee; --surface-hover: #f2f6f1;
+  --ink: #19241f; --ink-secondary: #52645a; --ink-muted: #687b6e;
+  --border: #dce5dd; --border-strong: #bdccc0; --sidebar-width: 216px;
+  --brand-soft: #faebe8; --radius-lg: 15px;
+  background: var(--canvas); color: var(--ink); font-size: 15px;
+}
+.host-workspace .sidebar { padding: 20px 13px 14px; background: var(--surface); }
+.host-workspace .sidebar-brand { padding: 0 7px 22px; gap: 10px; }
+.host-workspace .brand-word { font-size: 20px; font-weight: 800; letter-spacing: -.055em; }
+.host-workspace .sidebar-brand .brand-logo { width: 29px; height: 29px; }
+.host-workspace .sidebar-collapse { width: 27px; height: 27px; border-radius: 7px; }
+.host-workspace .command-trigger {
+  min-height: 42px; margin: 0; padding: 8px 10px; gap: 8px;
+  background: var(--canvas); border: 1px solid var(--line); color: var(--ink-secondary);
+  border-radius: 9px; box-shadow: none; font-size: 13px; font-weight: 650;
+}
+.host-workspace .command-trigger-icon { color: var(--muted); background: none; }
+.host-workspace .command-trigger kbd { margin-left: auto; font-size: 10px; background: white; color: var(--muted); border-color: var(--line); }
+.host-workspace .sidebar-nav { margin-top: 20px; gap: 4px; }
+.host-workspace .sidebar-nav a { min-height: 44px; border-radius: 10px; padding: 10px 11px; font-size: 14px; font-weight: 650; }
+.host-workspace .sidebar-nav a.active { background: var(--brand-soft); color: var(--brand-ink); box-shadow: none; }
+.host-workspace .sidebar-nav a:not(.active):hover { background: var(--surface-hover); }
+.host-workspace .nav-icon { width: 18px; height: 18px; }
+.host-rail-bottom { margin-top: auto; border-top: 1px solid var(--line); padding-top: 10px; position: relative; }
+.host-help { display: flex; align-items: center; gap: 10px; padding: 10px; font-size: 13px; font-weight: 650; text-decoration: none; color: var(--ink-secondary); min-height: 44px; }
+.host-account > summary { display: flex; align-items: center; gap: 9px; cursor: pointer; padding: 8px; list-style: none; border-radius: 9px; }
+.host-account > summary::-webkit-details-marker { display: none; }
+.host-account > summary:hover, .host-help:hover { background: var(--surface-hover); border-radius: 9px; }
+.host-account-name { flex: 1; min-width: 0; font-size: 13px; font-weight: 700; overflow-wrap: anywhere; }
+.host-account-name small { display: block; color: var(--muted); font-size: 11px; font-weight: 500; }
+.host-workspace .sidebar-user-avatar { width: 32px; height: 32px; background: #eaf1e9; color: #355c43; border-radius: 10px; font-size: 13px; }
+.host-account-menu { position: absolute; bottom: 64px; left: 0; right: 0; background: white; border: 1px solid var(--line); border-radius: 12px; padding: 6px; box-shadow: var(--shadow-popover); max-height: 65vh; overflow-y: auto; z-index: 61; }
+.host-account-menu > a, .host-account-menu .nav-button { display: block; padding: 10px; min-height: 44px; color: var(--ink-secondary); text-decoration: none; border-radius: 7px; font-size: 13px; }
+.host-account-menu > a:hover { background: var(--surface-hover); }
+.host-account-menu .lang-switch { margin: 5px; }
+.host-workspace .wrap.with-sidebar { padding: 30px 34px 64px; margin-left: var(--sidebar); }
+.host-workspace .wrap.with-sidebar > * { max-width: 1080px; }
+.host-workspace .page-header { margin-bottom: 24px; gap: 20px; align-items: center; }
+.host-workspace h1 { font-size: clamp(28px, 3.3vw, 38px); letter-spacing: -.05em; line-height: 1.16; font-weight: 800; }
+.host-workspace h2 { font-size: 19px; letter-spacing: -.025em; line-height: 1.3; }
+.host-workspace h3 { font-size: 16px; letter-spacing: -.015em; }
+.host-workspace .lede { font-size: 14px; line-height: 1.5; color: var(--ink-secondary); max-width: 65ch; }
+.host-workspace .panel { border: 1px solid var(--line); border-radius: 15px; box-shadow: none; background: white; padding: 20px; }
+.host-workspace .panel.tight { padding: 0; }
+.host-workspace .panel.quiet { background: var(--surface-hover); }
+.host-workspace .panel.empty { padding: 28px 24px; }
+.host-workspace .section-heading { margin-top: 26px; margin-bottom: 12px; gap: 12px; flex-wrap: wrap; }
+.host-workspace .section-heading h2 { margin: 0; }
+.host-workspace .btn { min-height: 42px; padding: 9px 14px; border-radius: 9px; font-size: 13px; font-weight: 700; box-shadow: none; }
+.host-workspace .btn.primary, .host-workspace .btn.accent { background: var(--brand-action); color: white; border-color: var(--brand-action); box-shadow: none; }
+.host-workspace .btn.primary:hover, .host-workspace .btn.accent:hover { background: var(--brand-pressed); }
+.host-workspace .btn.small { min-height: 36px; padding: 6px 10px; font-size: 12px; }
+.host-workspace .pill { font-size: 11px; line-height: 1.4; padding: 4px 9px; border-radius: 99px; }
+.host-workspace input:not([type=checkbox]):not([type=radio]):not([type=hidden]), .host-workspace select { min-height: 44px; border-radius: 8px; }
+.host-workspace textarea { border-radius: 8px; }
+.host-workspace .hint { font-size: 12px; line-height: 1.5; }
+.host-workspace table { font-size: 13px; }
+.host-workspace th { font-size: 11px; font-weight: 700; letter-spacing: .04em; color: var(--muted); background: #f8faf7; }
+.host-workspace td { padding: 14px 16px; vertical-align: middle; }
+.host-workspace th { padding: 12px 16px; }
+.host-workspace .row-primary-link { font-weight: 700; }
+.host-workspace .table-cards td, .host-workspace .guest-facts dd { overflow-wrap: anywhere; }
+.host-workspace .mono { font-size: 12px; }
+.host-local-nav { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; border-bottom: 1px solid var(--line); padding: 0 0 14px; margin-bottom: 26px; }
+.host-local-nav > a, .host-tools > summary { padding: 9px 12px; border-radius: 8px; color: var(--ink-secondary); text-decoration: none; font-size: 13px; font-weight: 650; min-height: 40px; cursor: pointer; }
+.host-local-nav > a[aria-current], .host-local-nav > a:hover { background: white; color: var(--brand-ink); }
+.host-tools { margin-left: auto; position: relative; }
+.host-tools > div { position: absolute; right: 0; top: 100%; min-width: 190px; z-index: 25; background: white; border: 1px solid var(--line); border-radius: 10px; box-shadow: var(--shadow-popover); padding: 6px; }
+.host-tools a { display: block; padding: 10px; color: var(--ink); font-size: 13px; text-decoration: none; }
+.host-tools a:hover { background: var(--surface-hover); }
+.host-today-head { background: #edf3e9; border: 1px solid #dce5d6; border-radius: 16px; padding: 25px 28px; display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
+.host-today-head h1 { margin: 3px 0 8px; }
+.host-today-head p { margin: 0; font-size: 13px; color: var(--ink-secondary); }
