diff --git a/App/app/static/host.js b/App/app/static/host.js
new file mode 100644
index 0000000..6994dcb
--- /dev/null
+++ b/App/app/static/host.js
@@ -0,0 +1,48 @@
+/* Progressive enhancement only: native links, forms and details work without JS. */
+(function () {
+  'use strict';
+  function revealTarget() {
+    var id;
+    try { id = decodeURIComponent(window.location.hash.slice(1)); } catch (_) { return; }
+    var target = id && document.getElementById(id);
+    if (!target) return;
+    var parent = target;
+    while (parent) {
+      if (parent.tagName === 'DETAILS') parent.open = true;
+      parent = parent.parentElement;
+    }
+    target.scrollIntoView({block: 'start'});
+  }
+  window.addEventListener('hashchange', revealTarget);
+  revealTarget();
+  document.addEventListener('click', function (event) {
+    document.querySelectorAll('[data-host-account], .host-tools').forEach(function (menu) {
+      if (!menu.contains(event.target)) menu.open = false;
+    });
+    var anchor = event.target.closest('a[href^="#"]');
+    if (anchor && anchor.hash === window.location.hash) revealTarget();
+  });
+  document.addEventListener('keydown', function (event) {
+    if (event.key !== 'Escape') return;
+    document.querySelectorAll('[data-host-account][open], .host-tools[open]').forEach(function (menu) {
+      menu.open = false;
+      menu.querySelector('summary').focus();
+    });
+  });
+  var alerts = document.querySelector('[data-host-alerts]');
+  if (alerts) {
+    new MutationObserver(function () {
+      var count = alerts.querySelectorAll('[data-notification]').length;
+      var label = alerts.querySelector('[data-host-alert-count]');
+      if (label && label.textContent !== String(count)) label.textContent = String(count);
+      alerts.hidden = count === 0;
+    }).observe(alerts, {childList: true, subtree: true});
+  }
+  // Invalid controls inside closed sections must be visible before the browser
+  // moves focus there. Keep every field in the form so partial section edits
+  // never clear values in another section.
+  document.addEventListener('invalid', function (event) {
+    var parent = event.target.closest('details');
+    while (parent) { parent.open = true; parent = parent.parentElement.closest('details'); }
+  }, true);
+})();
diff --git a/App/app/templates/_host_alerts.html b/App/app/templates/_host_alerts.html
new file mode 100644
index 0000000..c6428b7
--- /dev/null
+++ b/App/app/templates/_host_alerts.html
@@ -0,0 +1,35 @@
+{% if open_alerts %}
+{% set alert_cards = open_alerts %}
+{% set alert_extra = open_alerts|length - alert_cards|length %}
+<details class="host-alerts" data-host-alerts {% if (open_alerts | selectattr('level', 'equalto', 'error') | list) or (open_alerts | selectattr('level', 'equalto', 'critical') | list) %}open{% endif %}>
+<summary>{{ t('a11y.notifications') }} <span data-host-alert-count>{{ open_alerts | length }}</span></summary>
+<aside class="notification-stack" aria-label="{{ t('a11y.notifications') }}" aria-live="polite">
+  {% for alert in alert_cards %}
+    <article class="notification-bubble {{ alert.level }}" data-notification>
+      {% if alert.reservation_id %}
+        <a class="notification-link" href="/reservations/{{ alert.reservation_id }}">
+      {% elif alert.apartment_id %}
+        <a class="notification-link" href="/apartments/{{ alert.apartment_id }}">
+      {% else %}
+        <div class="notification-link">
+      {% endif %}
+          <span class="notification-icon" aria-hidden="true">!</span>
+          <span class="grow">
+            <strong>{{ alert.display_title or alert.message }}</strong>
+            {% if alert.display_detail or alert.detail %}<small>{{ alert.display_detail or alert.detail }}</small>{% endif %}
+            {% if alert.reservation_id %}<small class="notification-action">{{ t('notification.open_stay') }}</small>
+            {% elif alert.apartment_id %}<small class="notification-action">{{ t('notification.open_property') }}</small>{% endif %}
+          </span>
+      {% if alert.reservation_id or alert.apartment_id %}</a>{% else %}</div>{% endif %}
+      {% if alert.kind != 'dates_changed_resign' %}
+      <form method="post" action="/alerts/{{ alert.id }}/dismiss" data-notification-dismiss>
+        <button type="submit" aria-label="{{ t('a11y.dismiss_notification') }}">&times;</button>
+      </form>
+      {% endif %}
+    </article>
+  {% endfor %}
+  {% if alert_extra %}
+    <a class="notification-more" href="/#needs-action">{{ t('notification.more', n=alert_extra) }}</a>
+  {% endif %}
+</aside></details>
+{% endif %}
