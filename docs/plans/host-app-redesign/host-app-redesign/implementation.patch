+{# Contextual destinations remain one click away without crowding the rail. #}
+{% set host_links = [] %}
+{% if nav in ('reservations', 'submissions', 'housebook') %}
+  {% set host_links = [('/reservations', 'nav.stays', nav == 'reservations'), ('/submissions', 'nav.reports', nav == 'submissions'), ('/housebook', 'nav.housebook', nav == 'housebook')] %}
+{% elif nav in ('apartments', 'entities', 'guest_links', 'automation') %}
+  {% set host_links = [('/apartments', 'nav.properties', nav == 'apartments'), ('/entities', 'host.business', nav == 'entities')] %}
+{% elif nav == 'invoices' %}
+  {% set host_links = [('/invoices', 'nav.invoices', request.url.path != '/invoices/settings'), ('/invoices/settings', 'host.invoice_settings', request.url.path == '/invoices/settings')] %}
+{% elif nav in ('settings', 'privacy_requests', 'users', 'incidents') %}
+  {% set host_links = [('/settings', 'nav.settings', nav == 'settings' and request.url.path == '/settings'), ('/settings/archived', 'settings.nav.archive', request.url.path == '/settings/archived'), ('/privacy-requests', 'nav.privacy_requests', nav == 'privacy_requests')] %}
+{% endif %}
+{% if host_links %}
+<nav class="host-local-nav" aria-label="{{ t('host.section_navigation') }}">
+  {% for href, key, active in host_links %}<a href="{{ href }}" {% if active %}aria-current="page"{% endif %}>{{ t(key) }}</a>{% endfor %}
+  {% if nav in ('apartments', 'entities', 'guest_links', 'automation') %}
+  <details class="host-tools"><summary>{{ t('host.property_tools') }}</summary><div>
+    <a href="/guest-links" {% if nav == 'guest_links' %}aria-current="page"{% endif %}>{{ t('nav.guest_links') }}</a>
+    <a href="/automation" {% if nav == 'automation' %}aria-current="page"{% endif %}>{{ t('nav.automation') }}</a>
+  </div></details>
+  {% endif %}
+</nav>
+{% endif %}
