+}
+@keyframes tw-pulse { 50% { outline-color: color-mix(in srgb, var(--brand) 30%, transparent); } }
+.tw [data-tw-copied] {
+  background: var(--green-bg);
+  border-color: color-mix(in srgb, var(--green) 35%, transparent);
