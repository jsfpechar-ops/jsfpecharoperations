diff --git a/App/app/static/guest-ticket.css b/App/app/static/guest-ticket.css
new file mode 100644
index 0000000..50e513f
--- /dev/null
+++ b/App/app/static/guest-ticket.css
@@ -0,0 +1,1336 @@
+/* UbyHost guest "Ticket Wallet" skin
+   -------------------------------------------------------------------------
+   Loaded after tokens.css and guest.css, only by guest/base.html, and only
+   active under <body class="tw">. It restyles the existing guest markup; it
+   does not rename or remove any class the tests or signature.js rely on.
+
+   The idea: every guest screen is a ticket. A coloured strip names the step,
+   the body does the work, the tear-off stub holds the buttons. A dark app bar
+   keeps the property, the dates and a progress line on screen the whole way.
+
+   Sections
+     1. Skin tokens            7. Buttons              13. Hub (your group)
+     2. Page + column          8. Fields               14. Stamp + boarding pass
+     3. App bar                9. PIN cells            15. Host contact + footer
+     4. Ticket                 10. Party stepper       16. Mail illustration
+     5. Stub                   11. Stay passes         17. Motion
+     6. Type                   12. Quiet folds
+*/
+
+/* 1. Skin tokens -------------------------------------------------------- */
+.tw {
+  --tw-page: var(--canvas-subtle);
+  --tw-paper: var(--surface);
+  --tw-ink: var(--ink);
+  --tw-bar: var(--ink);
+  --tw-bar-ink: var(--canvas);
+  --tw-bar-muted: #b9b9b3;
+  --tw-bar-line: #3a3a37;
+  --tw-strip: linear-gradient(120deg, var(--brand-action), var(--brand));
+  --tw-strip-ink: var(--on-brand);
+  --tw-radius: 22px;
+  --tw-notch: 22px;
+  --tw-perf: 2px dashed var(--border);
+  --tw-shadow: 0 30px 60px -40px rgba(20, 20, 18, 0.35);
+  --tw-lift: 0 14px 32px rgba(150, 62, 56, 0.14);
+  --tw-serif: "New York", "Iowan Old Style", "Palatino Linotype", Palatino, Georgia, serif;
+  --tw-pad: 24px;
+  background: var(--tw-page);
+}
+@media (max-width: 480px) { .tw { --tw-pad: 20px; } }
+
+/* 2. Page + column ------------------------------------------------------ */
+.tw .g-wrap { max-width: 640px; padding-top: 0; }
+/* The form page used to become two columns at 1020px. The ticket is the
+   layout now, so the form stays one ticket wide and the rail steps aside. */
+.tw .g-checkin-page { max-width: 640px; }
+@media (min-width: 1020px) {
+  .tw .g-checkin-page main { display: block; }
+}
+.tw .g-form-line { display: none; }
+.tw .g-wizard-progress { display: none !important; }
+
+/* 3. App bar ------------------------------------------------------------ */
+/* Full-bleed dark band without leaving the 640px column: the shadow paints
+   the band sideways and the clip keeps it from bleeding up or down. */
+.tw .g-head {
+  position: sticky;
+  top: 0;
+  z-index: var(--z-sticky);
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 4px 12px;
+  margin: 0 0 var(--space-6);
+  padding: 12px 0 0;
+  background: var(--tw-bar);
+  color: var(--tw-bar-ink);
+  box-shadow: 0 0 0 100vmax var(--tw-bar);
+  clip-path: inset(0 -100vmax);
+}
+.tw .g-head .g-property-mark { width: 34px; height: 34px; border-radius: 10px; }
+.tw .g-head h1 {
+  order: 2;
+  margin: 0;
+  font-size: 11px;
+  font-weight: 750;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+  color: #e8a7a1;
+}
+.tw .g-head .g-title > div { display: flex; flex-direction: column-reverse; }
+.tw .g-head .g-facility {
+  margin: 0;
+  font: 600 19px/1.15 var(--tw-serif);
+  color: var(--tw-bar-ink);
+}
+.tw .g-head .g-lang { background: #2f2f2c; border-color: var(--tw-bar-line); }
+.tw .g-head .g-lang a { color: var(--tw-bar-muted); min-height: 40px; padding: 0 12px; }
+.tw .g-head .g-lang a.on { background: var(--canvas); color: var(--ink); }
+.tw-route {
+  flex: 1 0 100%;
+  margin: 2px 0 0;
+  font-size: 12px;
+  font-weight: 650;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+  color: var(--tw-bar-muted);
+}
+.tw-route b { color: var(--tw-bar-ink); font-weight: 700; }
+.tw-progress {
+  flex: 1 0 100%;
+  height: 3px;
+  margin-top: 10px;
+  background: var(--tw-bar-line);
+}
+.tw-progress i {
+  display: block;
+  height: 100%;
+  background: var(--brand);
+  transition: width 0.5s var(--ease-standard);
+}
+
+/* 4. Ticket ------------------------------------------------------------- */
+.tw .tw-ticket,
+.tw [data-guest-step] {
+  position: relative;
+  margin: 0 0 var(--space-6);
+  padding: 0 var(--tw-pad);
+  overflow: visible;
+  background: var(--tw-paper);
+  border: 1px solid var(--border);
+  border-radius: var(--tw-radius);
+  box-shadow: var(--tw-shadow);
+}
+/* The strip reads its words from the markup: data-tw-label on a ticket,
+   data-step-title on a form step. */
+.tw .tw-ticket::before,
+.tw [data-guest-step]::before {
+  content: attr(data-tw-label);
+  display: flex;
+  align-items: center;
+  min-height: 42px;
+  margin: 0 calc(-1 * var(--tw-pad)) var(--space-6);
+  padding: 0 var(--tw-pad);
+  border-radius: var(--tw-radius) var(--tw-radius) 0 0;
+  background: var(--tw-strip);
+  color: var(--tw-strip-ink);
+  font-size: 11.5px;
+  font-weight: 750;
+  letter-spacing: 0.12em;
+  text-transform: uppercase;
+}
+.tw [data-guest-step]::before { content: attr(data-step-title); }
+.tw .tw-ticket.is-quiet::before { background: var(--ink); }
+.tw .tw-ticket.is-ok::before { background: var(--green); }
+/* A last step without a stub still needs air under its content. */
+.tw .tw-ticket > :last-child:not(.tw-stub),
+.tw [data-guest-step] > :last-child:not(.g-wizard-nav):not(.tw-stub) { margin-bottom: var(--tw-pad); }
+/* Cards that used to sit inside a step lose their own frame. */
+.tw [data-guest-step] .g-card,
+.tw .tw-ticket .g-card {
+  margin: 0 0 var(--space-5);
+  padding: 0;
+  border: 0;
+  background: none;
+  box-shadow: none;
+}
+.tw [data-guest-step][hidden] { display: none !important; }
+
+/* 5. Stub --------------------------------------------------------------- */
+.tw .tw-ticket .tw-stub,
+.tw [data-guest-step] > .g-wizard-nav {
+  position: relative;
+  display: flex;
+  flex-wrap: wrap;
+  gap: var(--space-3);
+  margin: var(--space-6) calc(-1 * var(--tw-pad)) 0;
+  padding: var(--space-5) var(--tw-pad);
+  border-top: var(--tw-perf);
+  border-radius: 0 0 var(--tw-radius) var(--tw-radius);
+  background: var(--canvas);
+}
+.tw .tw-ticket .tw-stub::before,
+.tw .tw-ticket .tw-stub::after,
+.tw [data-guest-step] > .g-wizard-nav::before,
+.tw [data-guest-step] > .g-wizard-nav::after {
+  content: "";
+  position: absolute;
+  top: calc(var(--tw-notch) / -2);
+  width: var(--tw-notch);
+  height: var(--tw-notch);
+  border-radius: 50%;
+  background: var(--tw-page);
+  border: 1px solid var(--border);
+}
+.tw .tw-ticket .tw-stub::before,
+.tw [data-guest-step] > .g-wizard-nav::before { left: calc(var(--tw-notch) / -2); clip-path: inset(0 0 0 50%); }
+.tw .tw-ticket .tw-stub::after,
+.tw [data-guest-step] > .g-wizard-nav::after { right: calc(var(--tw-notch) / -2); clip-path: inset(0 50% 0 0); }
+.tw .tw-stub > *,
+.tw [data-guest-step] > .g-wizard-nav > * { flex: 1 1 160px; margin: 0; }
+.tw .tw-stub > .tw-stub-note { flex-basis: 100%; margin: 0; font-size: 14px; color: var(--ink-muted); text-align: center; }
+/* On a phone the step's buttons ride along at the bottom of the screen. */
+@media (max-width: 560px) {
+  .tw [data-guest-step] > .g-wizard-nav { position: sticky; bottom: 0; z-index: 5; }
+}
+
+/* Outside a ticket (a folded retry form) the stub is just a button row. */
+.tw .tw-stub { margin-top: var(--space-4); }
+
+/* A stay summary above a ticket reads as a slim pass. */
+.tw .g-stay-summary {
+  position: relative;
+  margin-bottom: var(--space-4);
+  padding: var(--space-4) var(--space-5) var(--space-4) 26px;
+  border: 1px solid var(--border);
+  border-radius: var(--radius-lg);
+  background: var(--surface);
+  box-shadow: none;
+}
+.tw .g-stay-summary::before {
+  content: "";
+  position: absolute;
+  inset: 0 auto 0 0;
+  width: 6px;
+  border-radius: var(--radius-lg) 0 0 var(--radius-lg);
+  background: var(--brand);
+}
+.tw .g-stay-summary strong { font: 600 19px/1.2 var(--tw-serif); }
+
+/* 6. Type --------------------------------------------------------------- */
+.tw .tw-ticket h2,
+.tw [data-guest-step] h2,
+.tw .g-arrival-choice .g-section {
+  margin: 0 0 var(--space-2);
+  font: 600 clamp(26px, 7vw, 34px)/1.1 var(--tw-serif);
+  letter-spacing: -0.02em;
+  color: var(--ink);
+}
+.tw .tw-ticket .g-intro,
+.tw [data-guest-step] .g-intro { font-size: 15.5px; color: var(--ink-muted); margin-bottom: var(--space-5); }
+.tw-vh {
+  position: absolute !important;
+  width: 1px; height: 1px;
+  overflow: hidden;
+  clip: rect(0 0 0 0);
+  white-space: nowrap;
+}
+
+/* 7. Buttons ------------------------------------------------------------ */
+.tw .g-btn {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: var(--space-2);
+  min-height: 56px;
+  border-radius: var(--radius-pill);
+  font-size: 16.5px;
+  font-weight: 700;
+  box-shadow: 0 10px 24px -8px rgba(173, 73, 66, 0.55);
+  transition: background var(--motion-base) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);
+}
+.tw .g-btn:active { transform: translateY(1px) scale(0.995); }
+.tw .g-btn.secondary,
+.tw .g-btn.ghost {
+  background: var(--surface);
+  color: var(--ink);
+  border: 1.5px solid var(--border-strong);
+  box-shadow: none;
+}
+.tw .g-btn.secondary:hover,
+.tw .g-btn.ghost:hover { background: var(--surface-hover); }
+.tw .g-btn.slim { min-height: 52px; }
+.tw form.is-sending .g-btn[type="submit"] { color: transparent; pointer-events: none; position: relative; }
+.tw form.is-sending .g-btn[type="submit"]::after {
+  content: "";
+  position: absolute;
+  width: 22px; height: 22px;
+  border-radius: 50%;
+  border: 3px solid rgba(255, 255, 255, 0.4);
+  border-top-color: #fff;
+  animation: tw-spin 0.8s linear infinite;
+}
+
+/* 8. Fields ------------------------------------------------------------- */
+.tw .g-field label,
+.tw .g-field .g-label { font-size: 14.5px; font-weight: 650; color: var(--ink); }
+.tw .g-field input[type="text"],
+.tw .g-field input[type="email"],
+.tw .g-field input[type="number"],
+.tw .g-field select {
+  min-height: 56px;
+  border: 1.5px solid var(--border-strong);
+  border-radius: var(--radius-md);
+  background-color: var(--surface);
+  font-size: 17px;
+  color: var(--ink);
+}
+.tw .g-field input:focus,
+.tw .g-field select:focus {
+  outline: none;
+  border-color: var(--brand);
+  box-shadow: 0 0 0 4px var(--focus-ring);
+}
+.tw .g-field select {
+  -webkit-appearance: none;
+  appearance: none;
+  padding-right: 44px;
+  background-image:
+    linear-gradient(45deg, transparent 50%, var(--ink-muted) 50%),
+    linear-gradient(135deg, var(--ink-muted) 50%, transparent 50%);
+  background-position: calc(100% - 22px) 50%, calc(100% - 16px) 50%;
+  background-size: 6px 6px, 6px 6px;
+  background-repeat: no-repeat;
+}
+.tw .g-field .bad { border-color: var(--red); }
+.tw .checkline {
+  padding: var(--space-4);
+  border: 1.5px solid var(--border-strong);
+  border-radius: var(--radius-md);
+  background: var(--surface);
+}
+.tw .g-err { border-radius: var(--radius-md); }
+/* A copied address is a gift, so it looks like one. */
+.tw [data-tw-copied] {
+  display: flex;
+  gap: var(--space-3);
+  align-items: center;
+  padding: var(--space-4);
+  margin-bottom: var(--space-5);
+  border-radius: var(--radius-lg);
+  background: var(--brand-soft);
+  border: 1.5px solid color-mix(in srgb, var(--brand) 30%, transparent);
+  color: var(--ink);
+  font-weight: 600;
+}
+
+/* 9. PIN cells ---------------------------------------------------------- */
+/* One real input, drawn as six cells. Monospace keeps every digit on its
+   cell; the underline segments are the same width as a digit plus its gap. */
+.tw .g-pin-input {
+  --cell: 1.7ch;
+  width: calc(6 * var(--cell) + 0.3ch);
+  max-width: 100%;
+  min-height: 68px;
+  padding: 0 0 0 0.4ch;
+  border: 1.5px solid var(--border-strong);
+  border-radius: var(--radius-md);
