+  border-top: var(--tw-perf);
+}
+.tw-bp-foot::before,
+.tw-bp-foot::after {
+  content: "";
+  position: absolute;
+  top: -11px;
+  width: 20px;
+  height: 20px;
+  border-radius: 50%;
+  background: var(--tw-paper);
+  border: 1px solid var(--border);
