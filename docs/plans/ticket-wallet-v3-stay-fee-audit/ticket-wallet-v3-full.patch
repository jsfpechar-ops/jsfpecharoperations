+  background: linear-gradient(180deg, var(--canvas) 0 100%);
+}
+.tw .tw-doc-photo {
+  position: absolute;
+  left: 12px;
+  top: 18px;
+  width: 38px;
+  height: 48px;
+  border-radius: 4px;
+  background: var(--border);
+}
+.tw .tw-doc-no {
+  position: absolute;
+  right: 12px;
+  top: 12px;
