+
+/* 18. App bar v2 --------------------------------------------------------- */
+.tw .g-head { gap: 2px 12px; padding-top: 10px; }
+.tw .g-head .g-title { flex: 1 1 auto; min-width: 0; }
+.tw .g-head .g-title > div { min-width: 0; }
