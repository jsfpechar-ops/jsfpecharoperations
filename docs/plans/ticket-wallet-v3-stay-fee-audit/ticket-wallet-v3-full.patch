+}
+
+/* 25. Purpose chips (ticket.js initPurposeChips) -------------------------- */
+.tw .tw-chips { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-3); }
+.tw .tw-chip {
