+.tw-bp-foot::before { left: -11px; }
+.tw-bp-foot::after { right: -11px; }
+.tw-bp-foot b { font-size: 14px; color: var(--ink); }
+/* Decoration only: a fixed stripe pattern, never a scannable code. */
