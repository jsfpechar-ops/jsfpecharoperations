+/* 23. Date of birth boxes (ticket.js initDobCells) ------------------------ */
+.tw .tw-dob { display: grid; grid-template-columns: 1fr 1fr 1.6fr; gap: var(--space-2); }
+.tw .tw-dob-part { display: block; }
