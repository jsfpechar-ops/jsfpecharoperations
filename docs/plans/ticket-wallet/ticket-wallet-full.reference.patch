+.tw .g-foot { margin-top: var(--space-6); }
+
+/* 16. Mail illustration ------------------------------------------------- */
+.tw-mail { display: grid; place-items: center; margin: var(--space-6) 0 var(--space-6); }
+.tw-mail span {
+  position: relative;
+  width: 120px;
+  height: 84px;
