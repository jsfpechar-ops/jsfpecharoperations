+  {% else %}
+  <h1 class="auth-title">{{ t('login.link.invite_title') if invite else t('login.link.title') }}</h1>
+  <p class="auth-lede">{{ t('login.link.lede') }}</p>
+  <form method="post" action="/login/link" class="auth-form">
+    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
+    <input type="hidden" name="t" value="{{ token }}">
+    <button class="auth-submit" type="submit" autofocus>{{ t('login.link.submit') }}</button>
+  </form>
+  {% endif %}
+</section>
+{% endblock %}
